+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * along with this program.  If not, see <https://www.gnu.org/licenses/>.
+ */
+
+#include "cdr-json.h"
+
+/* ------------------------------------------------------------------ */
+/* Rendering the ASN.1 leaf types                                       */
+/* ------------------------------------------------------------------ */
+
+/* An OCTET STRING / IA5String / UTF8String carrying text. */
+static void add_text(cJSON *obj, const char *name, const OCTET_STRING_t *os)
+{
+    char *s;
+
+    if (!os || !os->buf)
+        return;
+
+    /* The codec NUL-terminates what it allocates, but a decoded string
+     * need not be, so copy with an explicit length. */
+    s = ogs_calloc(1, os->size + 1);
+    if (!s)
+        return;
+    memcpy(s, os->buf, os->size);
+    cJSON_AddStringToObject(obj, name, s);
+    ogs_free(s);
+}
+
+/*
+ * TS 32.298 TimeStamp: BCD YYMMDDhhmmss, ASCII sign, BCD hhmm offset.
+ * Rendered as ISO-8601.  A two-digit year is read as 20YY, which is the
+ * only reading that makes sense for records written now and matches what
+ * every other CDR reader assumes.
+ */
+#define UNBCD(b)    ((((b) >> 4) & 0x0f) * 10 + ((b) & 0x0f))
+
+static void add_timestamp(cJSON *obj, const char *name,
+        const CHFCDR_TimeStamp_t *ts)
+{
+    char iso[40];
+    const uint8_t *v;
+    int off_min;
+
+    if (!ts || !ts->buf || ts->size < 9)
+        return;
+
+    v = ts->buf;
+    off_min = UNBCD(v[7]) * 60 + UNBCD(v[8]);
+
+    if (off_min == 0) {
+        ogs_snprintf(iso, sizeof(iso),
+                "20%02d-%02d-%02dT%02d:%02d:%02dZ",
+                UNBCD(v[0]), UNBCD(v[1]), UNBCD(v[2]),
+                UNBCD(v[3]), UNBCD(v[4]), UNBCD(v[5]));
+    } else {
+        ogs_snprintf(iso, sizeof(iso),
+                "20%02d-%02d-%02dT%02d:%02d:%02d%c%02d:%02d",
+                UNBCD(v[0]), UNBCD(v[1]), UNBCD(v[2]),
+                UNBCD(v[3]), UNBCD(v[4]), UNBCD(v[5]),
+                v[6] == (uint8_t)'-' ? '-' : '+',
+                UNBCD(v[7]), UNBCD(v[8]));
+    }
+
+    cJSON_AddStringToObject(obj, name, iso);
+}
+
+/* SliceDifferentiator: 3 octets, written the way TS 23.003 writes an SD. */
+static void add_slice_differentiator(cJSON *obj, const char *name,
+        const CHFCDR_SliceDifferentiator_t *sd)
+{
+    char hex[7];
+
+    if (!sd || !sd->buf || sd->size < 3)
+        return;
+
+    ogs_snprintf(hex, sizeof(hex), "%02x%02x%02x",
+            sd->buf[0], sd->buf[1], sd->buf[2]);
+    cJSON_AddStringToObject(obj, name, hex);
+}
+
+/*
+ * The ASN.1 name for a value, or NULL when the value has none.
+ *
+ * Only the values the CHF writes are named.  Anything else falls through
+ * to a number, which is honest: inventing a name for a value we never
+ * produce would be a guess a reader might trust.
+ */
+static const char *record_type_name(long v)
+{
+    return v == 200 ? "chargingFunctionRecord" : NULL;
+}
+
+static const char *subscription_id_type_name(long v)
+{
+    switch (v) {
+    case CHFCDR_SubscriptionIDType_eND_USER_E164:     return "eND-USER-E164";
+    case CHFCDR_SubscriptionIDType_eND_USER_IMSI:     return "eND-USER-IMSI";
+    case CHFCDR_SubscriptionIDType_eND_USER_SIP_URI:  return "eND-USER-SIP-URI";
+    case CHFCDR_SubscriptionIDType_eND_USER_NAI:      return "eND-USER-NAI";
+    case CHFCDR_SubscriptionIDType_eND_USER_PRIVATE:  return "eND-USER-PRIVATE";
+    default:                                          return NULL;
+    }
+}
+
+static const char *network_functionality_name(long v)
+{
+    switch (v) {
+    case CHFCDR_NetworkFunctionality_cHF:   return "cHF";
+    case CHFCDR_NetworkFunctionality_sMF:   return "sMF";
+    case CHFCDR_NetworkFunctionality_aMF:   return "aMF";
+    case CHFCDR_NetworkFunctionality_sMSF:  return "sMSF";
+    default:                                return NULL;
+    }
+}
+
+/* A named value: its name when it has one, otherwise the number. */
+static void add_named(cJSON *obj, const char *name, long v,
+        const char *(*lookup)(long))
+{
+    const char *s = lookup(v);
+
+    if (s)
+        cJSON_AddStringToObject(obj, name, s);
+    else
+        cJSON_AddNumberToObject(obj, name, (double)v);
+}
+
+/* ------------------------------------------------------------------ */
+/* Rendering the constructed types                                      */
+/* ------------------------------------------------------------------ */
+
+static cJSON *render_involved_party(const CHFCDR_InvolvedParty_t *ip)
+{
+    cJSON *o = cJSON_CreateObject();
+
+    if (!o)
+        return NULL;
+
+    switch (ip->present) {
+    case CHFCDR_InvolvedParty_PR_sIP_URI:
+        add_text(o, "sIP-URI", &ip->choice.sIP_URI);
+        break;
+    case CHFCDR_InvolvedParty_PR_tEL_URI:
+        add_text(o, "tEL-URI", &ip->choice.tEL_URI);
+        break;
+    case CHFCDR_InvolvedParty_PR_uRN:
+        add_text(o, "uRN", &ip->choice.uRN);
+        break;
+    case CHFCDR_InvolvedParty_PR_iSDN_E164:
+        add_text(o, "iSDN-E164", &ip->choice.iSDN_E164);
+        break;
+    case CHFCDR_InvolvedParty_PR_externalId:
+        add_text(o, "externalId", &ip->choice.externalId);
+        break;
+    default:
+        break;
+    }
+
+    return o;
+}
+
+static cJSON *render_used_unit_container(
+        const CHFCDR_UsedUnitContainer_t *u)
+{
+    cJSON *o = cJSON_CreateObject();
+
+    if (!o)
+        return NULL;
+
+    if (u->serviceIdentifier)
+        cJSON_AddNumberToObject(o, "serviceIdentifier",
+                (double)*u->serviceIdentifier);
+    if (u->time)
+        cJSON_AddNumberToObject(o, "time", (double)*u->time);
+    if (u->dataTotalVolume)
+        cJSON_AddNumberToObject(o, "dataTotalVolume",
+                (double)*u->dataTotalVolume);
+    if (u->dataVolumeUplink)
+        cJSON_AddNumberToObject(o, "dataVolumeUplink",
+                (double)*u->dataVolumeUplink);
+    if (u->dataVolumeDownlink)
+        cJSON_AddNumberToObject(o, "dataVolumeDownlink",
+                (double)*u->dataVolumeDownlink);
+    if (u->localSequenceNumber)
+        cJSON_AddNumberToObject(o, "localSequenceNumber",
+                (double)*u->localSequenceNumber);
+
+    return o;
+}
+
+static cJSON *render_multiple_unit_usage(
+        const CHFCDR_MultipleUnitUsage_t *m)
+{
+    cJSON *o = cJSON_CreateObject();
+    cJSON *arr;
+    int i;
+
+    if (!o)
+        return NULL;
+
+    cJSON_AddNumberToObject(o, "ratingGroup", (double)m->ratingGroup);
+
+    if (!m->usedUnitContainers)
+        return o;
+
+    arr = cJSON_AddArrayToObject(o, "usedUnitContainers");
+    if (!arr)
+        return o;
+
+    for (i = 0; i < m->usedUnitContainers->list.count; i++) {
+        cJSON *item = render_used_unit_container(
+                m->usedUnitContainers->list.array[i]);
+        if (item)
+            cJSON_AddItemToArray(arr, item);
+    }
+
+    return o;
+}
+
+static cJSON *render_pdu_session_info(
+        const CHFCDR_PDUSessionChargingInformation_t *p)
+{
+    cJSON *o = cJSON_CreateObject();
+
+    if (!o)
+        return NULL;
+
+    cJSON_AddNumberToObject(o, "pDUSessionChargingID",
+            (double)p->pDUSessionChargingID);
+
+    if (p->userIdentifier) {
+        cJSON *ip = render_involved_party(p->userIdentifier);
+        if (ip)
+            cJSON_AddItemToObject(o, "userIdentifier", ip);
+    }
+
+    cJSON_AddNumberToObject(o, "pDUSessionId", (double)p->pDUSessionId);
+
+    if (p->networkSliceInstanceID) {
+        cJSON *n = cJSON_CreateObject();
+        if (n) {
+            cJSON_AddNumberToObject(n, "sST",
+                    (double)p->networkSliceInstanceID->sST);
+            add_slice_differentiator(n, "sD",
+                    p->networkSliceInstanceID->sD);
+            cJSON_AddItemToObject(o, "networkSliceInstanceID", n);
+        }
+    }
+
+    add_text(o, "dataNetworkNameIdentifier", p->dataNetworkNameIdentifier);
+    add_timestamp(o, "pDUSessionstartTime", p->pDUSessionstartTime);
+    add_timestamp(o, "pDUSessionstopTime", p->pDUSessionstopTime);
+
+    return o;
+}
+
+static cJSON *render_charging_record(const CHFCDR_ChargingRecord_t *cr)
+{
+    cJSON *o = cJSON_CreateObject();
+    cJSON *arr;
+    int i;
+
+    if (!o)
+        return NULL;
+
+    add_named(o, "recordType", cr->recordType, record_type_name);
+    add_text(o, "recordingNetworkFunctionID",
+            &cr->recordingNetworkFunctionID);
+
+    if (cr->subscriberIdentifier) {
+        cJSON *s = cJSON_CreateObject();
+        if (s) {
+            add_named(s, "subscriptionIDType",
+                    cr->subscriberIdentifier->subscriptionIDType,
+                    subscription_id_type_name);
+            add_text(s, "subscriptionIDData",
+                    &cr->subscriberIdentifier->subscriptionIDData);
+            cJSON_AddItemToObject(o, "subscriberIdentifier", s);
+        }
+    }
+
+    if (cr->nFunctionConsumerInformation) {
+        cJSON *n = cJSON_CreateObject();
+        if (n) {
+            add_named(n, "networkFunctionality",
+                    cr->nFunctionConsumerInformation->networkFunctionality,
+                    network_functionality_name);
+            add_text(n, "networkFunctionName",
+                    cr->nFunctionConsumerInformation->networkFunctionName);
+            cJSON_AddItemToObject(o, "nFunctionConsumerInformation", n);
+        }
+    }
+
+    if (cr->listOfMultipleUnitUsage) {
+        arr = cJSON_AddArrayToObject(o, "listOfMultipleUnitUsage");
+        if (arr) {
+            for (i = 0; i < cr->listOfMultipleUnitUsage->list.count; i++) {
+                cJSON *item = render_multiple_unit_usage(
+                        cr->listOfMultipleUnitUsage->list.array[i]);
+                if (item)
+                    cJSON_AddItemToArray(arr, item);
+            }
+        }
+    }
+
+    add_timestamp(o, "recordOpeningTime", &cr->recordOpeningTime);
+    cJSON_AddNumberToObject(o, "duration", (double)cr->duration);
+    add_named(o, "causeForRecClosing", cr->causeForRecClosing,
+            chf_cdr_cause_name);
+
+    if (cr->localRecordSequenceNumber)
+        cJSON_AddNumberToObject(o, "localRecordSequenceNumber",
+                (double)*cr->localRecordSequenceNumber);
+
+    if (cr->pDUSessionChargingInformation) {
+        cJSON *p = render_pdu_session_info(
+                cr->pDUSessionChargingInformation);
+        if (p)
+            cJSON_AddItemToObject(o, "pDUSessionChargingInformation", p);
+    }
+
+    add_text(o, "chargingSessionIdentifier", cr->chargingSessionIdentifier);
+
+    return o;
+}
+
+char *chf_cdr_json_render(const CHFCDR_CHFRecord_t *rec)
+{
+    cJSON *root = NULL;
+    cJSON *inner = NULL;
+    char *flat = NULL;
+
+    ogs_assert(rec);
+
+    if (rec->present != CHFCDR_CHFRecord_PR_chargingFunctionRecord ||
+            !rec->choice.chargingFunctionRecord) {
+        ogs_error("CDR: record has no chargingFunctionRecord to render");
+        return NULL;
+    }
+
+    root = cJSON_CreateObject();
+    if (!root)
+        return NULL;
+
+    /* The CHOICE is kept in the JSON, so the record names itself the way
+     * the ASN.1 does rather than starting at the ChargingRecord. */
+    inner = render_charging_record(rec->choice.chargingFunctionRecord);
+    if (!inner) {
+        cJSON_Delete(root);
+        return NULL;
+    }
+    cJSON_AddItemToObject(root, "chargingFunctionRecord", inner);
+
+    flat = cJSON_PrintUnformatted(root);
+    cJSON_Delete(root);
+
+    if (!flat) {
+        ogs_error("CDR: cJSON_PrintUnformatted failed");
+        return NULL;
+    }
+
+    /* open5gs points cJSON at ogs_malloc (see lib/third-party/cjson),
+     * so this is already ogs-owned and the caller frees it with
+     * ogs_free() like anything else. */
+    return flat;
+}
diff --git a/src/chf/cdr-json.h b/src/chf/cdr-json.h
new file mode 100644
index 000000000..9bc93bf45
--- /dev/null
+++ b/src/chf/cdr-json.h
@@ -0,0 +1,75 @@
+/*
+ * Copyright (C) 2026 by Rami Mohamed <ramrode@gmail.com>
+ *
+ * This file is part of Open5GS.
+ *
+ * This program is free software: you can redistribute it and/or modify
+ * it under the terms of the GNU Affero General Public License as published by
+ * the Free Software Foundation, either version 3 of the License, or
+ * (at your option) any later version.
+ *
+ * This program is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * along with this program.  If not, see <https://www.gnu.org/licenses/>.
+ */
+
+/*
+ * The TS 32.298 CDR, rendered as JSON.
+ *
+ * The same record the BER encoder writes, with the field names the ASN.1
+ * module gives them and the same nesting, so the two files describe one
+ * record in two syntaxes.  Walking the generated structure rather than
+ * the session is what guarantees that: there is no second notion of what
+ * a CDR contains.
+ *
+ * Where JSON cannot carry the ASN.1 type directly, the rendering is
+ * stated rather than invented:
+ *
+ *   TimeStamp            the 9-octet BCD becomes ISO-8601 UTC, e.g.
+ *                        "2026-10-01T12:30:00Z".  Nothing is lost - the
+ *                        CHF writes UTC with a +0000 offset.
+ *   SliceDifferentiator  3 octets become 6 lower-case hex digits, which
+ *                        is how TS 23.003 writes an SD.
+ *   named INTEGER and ENUMERATED
+ *                        rendered as the name the ASN.1 gives the value
+ *                        ("volumeLimit", "sMF"), not the number, since
+ *                        the name is the part a reader needs.  A value
+ *                        with no name falls back to the number.
+ *   other INTEGER        a JSON number.  Volumes can exceed 2^53 only at
+ *                        petabyte scale, past which a reader should use
+ *                        the BER.
+ *   IA5String, UTF8String, OCTET STRING carrying text
+ *                        a JSON string.
+ */
+
+#ifndef CHF_CDR_JSON_H
+#define CHF_CDR_JSON_H
+
+#include "cdr-record.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/*
+ * chf_cdr_json_render()
+ *
+ * Render the record as a compact single-line JSON object.  Returns an
+ * ogs_malloc()ed NUL-terminated string the caller frees, or NULL on
+ * failure.
+ *
+ * One line, because that is what lets an aggregated file be appended to
+ * and read back a record at a time (JSON Lines).  An individual file
+ * holds the same single line.
+ */
+char *chf_cdr_json_render(const CHFCDR_CHFRecord_t *rec);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* CHF_CDR_JSON_H */
diff --git a/src/chf/cdr-path.c b/src/chf/cdr-path.c
new file mode 100644
index 000000000..a83a574bf
--- /dev/null
+++ b/src/chf/cdr-path.c
@@ -0,0 +1,574 @@
+/*
+ * Copyright (C) 2026 by Rami Mohamed <ramrode@gmail.com>
+ *
+ * This file is part of Open5GS.
+ *
+ * This program is free software: you can redistribute it and/or modify
+ * it under the terms of the GNU Affero General Public License as published by
+ * the Free Software Foundation, either version 3 of the License, or
+ * (at your option) any later version.
+ *
+ * This program is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * along with this program.  If not, see <https://www.gnu.org/licenses/>.
+ */
+
+/*
+ * CHF CDR writer.
+ *
+ * A closing session becomes one TS 32.298 ChargingRecord (cdr-record.c),
+ * which is then written in whichever encodings charging.cdr.format asks
+ * for: BER through asn1c, JSON through cdr-json.c, or both.  The record
+ * is built once, so the two files always say the same thing.
+ *
+ * Each encoding is filed under its own policy, either one file per
+ * session or many records to a file:
+ *
+ *   individual   {base}/YYYY/MM/DD/cdr-{chargingDataRef}.{json,ber}
+ *   aggregated   {base}/YYYY/MM/DD/cdr-{YYYYMMDDhhmmss}-{seq}.{json,ber}
+ *
+ * An aggregated file is appended to until a threshold would be crossed,
+ * then the next record starts a new one.  Both encodings concatenate
+ * cleanly: BER records are self-delimiting, and the JSON is one record
+ * per line (JSON Lines), so neither needs a framing layer of its own.
+ *
+ * Every record is flushed as it is written.  CDRs are billing data, and
+ * an aggregated file that loses its tail to a crash loses real records,
+ * not just the last one.
+ */
+
+#include <sys/stat.h>
+#include <time.h>
+#include <errno.h>
+
+#include "cdr-path.h"
+#include "cdr-record.h"
+#include "cdr-json.h"
+#include "metrics.h"
+
+#define CHF_CDR_DEFAULT_BASE_PATH   "/var/log/open5gs/cdr"
+
+/* Maximum number of bytes (including NUL) for any CDR-related path.
+ * Typical paths are well under 256 bytes.  1024 gives comfortable headroom
+ * even for deeply-nested or customised base directories. */
+#define CHF_CDR_PATH_MAX            1024
+
+/* Static CDR base directory (resolved at init from context config) */
+static char *cdr_base_path = NULL;
+
+/*
+ * localRecordSequenceNumber (TS 32.298): unique within one node, which a
+ * counter that advances per record satisfies.  It restarts at 1 on
+ * restart - the field is scoped to the node and its recordOpeningTime,
+ * so a restart is a new scope.
+ */
+static uint32_t cdr_local_seq = 0;
+
+/* ------------------------------------------------------------------ */
+/* One output stream per encoding                                       */
+/* ------------------------------------------------------------------ */
+
+typedef struct cdr_sink_s {
+    const char *label;      /* for logs: "json" or "asn1"              */
+    const char *ext;        /* file extension                          */
+    int         format_bit; /* CHF_CDR_FMT_*                           */
+
+    /* Open aggregate file, when this sink aggregates. NULL when closed. */
+    FILE       *fp;
+    char       *path;
+    uint32_t    records;    /* records in the open file                */
+    uint64_t    bytes;      /* bytes in the open file                  */
+    char        day[48];    /* "YYYY/MM/DD" the open file belongs to   */
+    uint32_t    roll_seq;   /* distinguishes files opened in one second */
+} cdr_sink_t;
+
+static cdr_sink_t sink_json = {
+    .label = "json", .ext = "json", .format_bit = CHF_CDR_FMT_JSON,
+    .fp = NULL, .path = NULL, .records = 0, .bytes = 0,
+    .day = "", .roll_seq = 0,
+};
+static cdr_sink_t sink_asn1 = {
+    .label = "asn1", .ext = "ber", .format_bit = CHF_CDR_FMT_ASN1,
+    .fp = NULL, .path = NULL, .records = 0, .bytes = 0,
+    .day = "", .roll_seq = 0,
+};
+
+static const chf_cdr_filing_t *sink_policy(const cdr_sink_t *sink)
+{
+    return sink == &sink_json ? &chf_self()->cdr.json
+                              : &chf_self()->cdr.asn1;
+}
+
+/* ------------------------------------------------------------------ */
+/* Helper: create a directory path recursively (like mkdir -p)         */
+/* ------------------------------------------------------------------ */
+static int mkdir_p(const char *path, mode_t mode)
+{
+    char tmp[CHF_CDR_PATH_MAX];
+    char *p = NULL;
+    size_t len;
+    int rc;
+
+    rc = snprintf(tmp, sizeof(tmp), "%s", path);
+    if (rc < 0 || rc >= (int)sizeof(tmp)) {
+        ogs_error("CDR mkdir_p: path too long (max %d chars): %s",
+                  (int)sizeof(tmp) - 1, path);
+        return OGS_ERROR;
+    }
+    len = (size_t)rc;
+    if (len > 0 && tmp[len - 1] == '/')
+        tmp[len - 1] = '\0';
+
+    for (p = tmp + 1; *p; p++) {
+        if (*p == '/') {
+            *p = '\0';
+            if (mkdir(tmp, mode) != 0 && errno != EEXIST)
+                return OGS_ERROR;
+            *p = '/';
+        }
+    }
+    if (mkdir(tmp, mode) != 0 && errno != EEXIST)
+        return OGS_ERROR;
+    return OGS_OK;
+}
+
+/* Today's directory, created if needed. Returns OGS_OK and fills dir. */
+static int today_dir(char *dir, size_t dirsz, char *day, size_t daysz,
+        time_t now)
+{
+    struct tm tm_today;
+
+    gmtime_r(&now, &tm_today);
+
+    if ((size_t)snprintf(day, daysz, "%04d/%02d/%02d",
+                tm_today.tm_year + 1900, tm_today.tm_mon + 1,
+                tm_today.tm_mday) >= daysz)
+        return OGS_ERROR;
+
+    if ((size_t)snprintf(dir, dirsz, "%s/%s", cdr_base_path, day) >= dirsz) {
+        ogs_error("CDR directory path too long (max %d chars) — "
+                  "base='%s' date='%s'", (int)dirsz - 1, cdr_base_path, day);
+        return OGS_ERROR;
+    }
+
+    if (mkdir_p(dir, 0755) != OGS_OK) {
+        ogs_error("Cannot create CDR directory: %s — %s",
+                dir, strerror(errno));
+        return OGS_ERROR;
+    }
+
+    return OGS_OK;
+}
+
+/* ------------------------------------------------------------------ */
+/* Aggregated filing                                                    */
+/* ------------------------------------------------------------------ */
+
+static void sink_close(cdr_sink_t *sink)
+{
+    if (!sink->fp)
+        return;
+
+    fclose(sink->fp);
+    ogs_info("CDR %s file closed: %s (%u records, %llu bytes)",
+            sink->label, sink->path ? sink->path : "(unknown)",
+            sink->records, (unsigned long long)sink->bytes);
+
+    sink->fp = NULL;
+    if (sink->path) {
+        ogs_free(sink->path);
+        sink->path = NULL;
+    }
+    sink->records = 0;
+    sink->bytes = 0;
+}
+
+static int sink_open(cdr_sink_t *sink, time_t now)
+{
+    char dir[CHF_CDR_PATH_MAX];
+    char day[48];
+    char path[CHF_CDR_PATH_MAX + 64];
+    struct tm tm_now;
+
+    if (today_dir(dir, sizeof(dir), day, sizeof(day), now) != OGS_OK)
+        return OGS_ERROR;
+
+    gmtime_r(&now, &tm_now);
+
+    /* The open time names the file, so a listing sorts chronologically.
+     * roll_seq separates files that open within the same second, which
+     * happens when a small max_records is set. */
+    if ((size_t)snprintf(path, sizeof(path),
+                "%s/cdr-%04d%02d%02d%02d%02d%02d-%u.%s",
+                dir,
+                tm_now.tm_year + 1900, tm_now.tm_mon + 1, tm_now.tm_mday,
+                tm_now.tm_hour, tm_now.tm_min, tm_now.tm_sec,
+                sink->roll_seq++, sink->ext) >= sizeof(path)) {
+        ogs_error("CDR %s aggregate path too long", sink->label);
+        return OGS_ERROR;
+    }
+
+    sink->fp = fopen(path, "ab");
+    if (!sink->fp) {
+        ogs_error("Cannot open CDR %s file %s — %s",
+                sink->label, path, strerror(errno));
+        return OGS_ERROR;
+    }
+
+    sink->path = ogs_strdup(path);
+    if (!sink->path) {
+        fclose(sink->fp);
+        sink->fp = NULL;
+        return OGS_ERROR;
+    }
+
+    sink->records = 0;
+    sink->bytes = 0;
+    ogs_cpystrn(sink->day, day, sizeof(sink->day));
+
+    ogs_info("CDR %s file opened: %s", sink->label, path);
+    return OGS_OK;
+}
+
+/*
+ * Whether appending `len` more bytes should start a new file.
+ *
+ * Checked before the write, so a threshold is a ceiling rather than
+ * something a file drifts past.  A file that is still empty is never
+ * rolled, otherwise a record larger than max_bytes could never be
+ * written at all.
+ */
+static const char *sink_roll_reason(const cdr_sink_t *sink,
+        const chf_cdr_filing_t *policy, size_t len, const char *day)
+{
+    if (!sink->fp)
+        return NULL;
+
+    if (strcmp(sink->day, day) != 0)
+        return "day";       /* the day turned over */
+
+    if (!sink->records)
+        return NULL;        /* nothing in it yet */
+
+    if (policy->max_records && sink->records + 1 > policy->max_records)
+        return "records";
+
+    if (policy->max_bytes && sink->bytes + len > policy->max_bytes)
+        return "size";
+
+    return NULL;
+}
+
+static char *sink_write_aggregated(cdr_sink_t *sink,
+        const chf_cdr_filing_t *policy,
+        const void *data, size_t len, time_t now)
+{
+    char day[48];
+    struct tm tm_today;
+
+    gmtime_r(&now, &tm_today);
+    snprintf(day, sizeof(day), "%04d/%02d/%02d",
+            tm_today.tm_year + 1900, tm_today.tm_mon + 1, tm_today.tm_mday);
+
+    {
+        const char *reason = sink_roll_reason(sink, policy, len, day);
+        if (reason) {
+            chf_metrics_inst_labeled_inc(CHF_METR_LBL_CDR_FILE_ROLLED,
+                    sink->label, reason, NULL);
+            sink_close(sink);
+        }
+    }
+
+    if (!sink->fp && sink_open(sink, now) != OGS_OK)
+        return NULL;
+
+    if (fwrite(data, 1, len, sink->fp) != len) {
+        ogs_error("Short write to CDR %s file %s — %s",
+                sink->label, sink->path, strerror(errno));
+        /* Close it: a half-written record makes the rest of the file
+         * undecodable, and a fresh file is the only safe continuation. */
+        sink_close(sink);
+        return NULL;
+    }
+
+    if (fflush(sink->fp) != 0)
+        ogs_error("Cannot flush CDR %s file %s — %s",
+                sink->label, sink->path, strerror(errno));
+
+    sink->records++;
+    sink->bytes += len;
+
+    return ogs_strdup(sink->path);
+}
+
+/* ------------------------------------------------------------------ */
+/* Individual filing                                                    */
+/* ------------------------------------------------------------------ */
+
+static char *sink_write_individual(cdr_sink_t *sink,
+        const chf_sess_t *sess, const void *data, size_t len, time_t now)
+{
+    char dir[CHF_CDR_PATH_MAX];
+    char day[48];
+    char path[CHF_CDR_PATH_MAX + 64];
+    FILE *fp;
+
+    if (today_dir(dir, sizeof(dir), day, sizeof(day), now) != OGS_OK)
+        return NULL;
+
+    if ((size_t)snprintf(path, sizeof(path), "%s/cdr-%s.%s",
+                dir, sess->charging_data_ref, sink->ext) >= sizeof(path)) {
+        ogs_error("[%s] CDR %s file path too long — dir='%s'",
+                sess->supi, sink->label, dir);
+        return NULL;
+    }
+
+    fp = fopen(path, "wb");
+    if (!fp) {
+        ogs_error("[%s] Cannot open CDR %s file %s — %s",
+                sess->supi, sink->label, path, strerror(errno));
+        return NULL;
+    }
+
+    if (fwrite(data, 1, len, fp) != len) {
+        ogs_error("[%s] Short write to CDR %s file %s — %s",
+                sess->supi, sink->label, path, strerror(errno));
+        fclose(fp);
+        return NULL;
+    }
+
+    fclose(fp);
+    return ogs_strdup(path);
+}
+
+static char *sink_write(cdr_sink_t *sink, const chf_sess_t *sess,
+        const void *data, size_t len, time_t now)
+{
+    const chf_cdr_filing_t *policy = sink_policy(sink);
+
+    if (policy->aggregate)
+        return sink_write_aggregated(sink, policy, data, len, now);
+
+    return sink_write_individual(sink, sess, data, len, now);
+}
+
+/* ------------------------------------------------------------------ */
+/* Lifecycle                                                            */
+/* ------------------------------------------------------------------ */
+
+static const char *format_name(int formats)
+{
+    switch (formats & (CHF_CDR_FMT_JSON | CHF_CDR_FMT_ASN1)) {
+    case CHF_CDR_FMT_JSON:                      return "json";
+    case CHF_CDR_FMT_ASN1:                      return "asn1";
+    case CHF_CDR_FMT_JSON | CHF_CDR_FMT_ASN1:   return "both";
+    default:                                    return "none";
+    }
+}
+
+static void log_filing(const char *label, const chf_cdr_filing_t *f)
+{
+    if (!f->aggregate) {
+        ogs_info("CDR %s filing: one file per session", label);
+        return;
+    }
+
+    ogs_info("CDR %s filing: aggregated, rolling at %u records / %llu MB "
+             "(0 = no limit)", label, f->max_records,
+             (unsigned long long)(f->max_bytes / (1024 * 1024)));
+}
+
+void chf_cdr_init(void)
+{
+    const char *cfg_path = chf_self()->cdr.path;
+
+    if (cfg_path && cfg_path[0] != '\0') {
+        cdr_base_path = ogs_strdup(cfg_path);
+    } else {
+        cdr_base_path = ogs_strdup(CHF_CDR_DEFAULT_BASE_PATH);
+    }
+
+    ogs_assert(cdr_base_path);
+
+    cdr_local_seq = 0;
+    sink_json.roll_seq = 0;
+    sink_asn1.roll_seq = 0;
+
+    ogs_info("CDR base directory: %s (enabled=%s format=%s)",
+            cdr_base_path,
+            chf_self()->cdr.enable ? "yes" : "no",
+            format_name(chf_self()->cdr.formats));
+
+    if (!chf_self()->cdr.enable)
+        return;
+
+    if (chf_self()->cdr.formats & CHF_CDR_FMT_JSON)
+        log_filing("json", &chf_self()->cdr.json);
+    if (chf_self()->cdr.formats & CHF_CDR_FMT_ASN1)
+        log_filing("asn1", &chf_self()->cdr.asn1);
+    if (!chf_self()->cdr.formats)
+        ogs_warn("CDR writing is enabled but charging.cdr.format selects "
+                 "no encoding — no CDRs will be written");
+}
+
+void chf_cdr_final(void)
+{
+    /* Close before freeing the base path: an open aggregate file still
+     * has buffered records in it. */
+    sink_close(&sink_json);
+    sink_close(&sink_asn1);
+
+    if (cdr_base_path) {
+        ogs_free(cdr_base_path);
+        cdr_base_path = NULL;
+    }
+}
+
+/* ------------------------------------------------------------------ */
+/* chf_cdr_write                                                        */
+/* ------------------------------------------------------------------ */
+
+char *chf_cdr_write(chf_sess_t *sess, const char *cause)
+{
+    CHFCDR_CHFRecord_t *rec = NULL;
+    char *json = NULL;
+    uint8_t *ber = NULL;
+    int ber_len = 0;
+    char *json_path = NULL;
+    char *ber_path = NULL;
+    char *result = NULL;
+    size_t written = 0;
+    int wanted = 0, done = 0;
+    time_t now;
+    int64_t t0;
+
+    ogs_assert(sess);
+
+    if (!chf_self()->cdr.enable) {
+        ogs_debug("[%s] CDR writing disabled", sess->supi);
+        return NULL;
+    }
+
+    if (!chf_self()->cdr.formats) {
+        ogs_debug("[%s] CDR writing enabled but no encoding selected",
+                sess->supi);
+        return NULL;
+    }
+
+    t0 = ogs_get_monotonic_time();
+    now = time(NULL);
+
+    rec = chf_cdr_record_build(sess, cause, ++cdr_local_seq);
+    if (!rec) {
+        ogs_error("[%s] Cannot build CDR record [ref:%s]",
+                sess->supi, sess->charging_data_ref);
+        chf_metrics_inst_labeled_inc(CHF_METR_LBL_CDR_WRITTEN,
+                "error", NULL, NULL);
+        chf_metrics_inst_labeled_inc(CHF_METR_LBL_ERRORS, "cdr", NULL, NULL);
+        return NULL;
+    }
+
+    if (chf_self()->cdr.formats & CHF_CDR_FMT_JSON) {
+        wanted++;
+        json = chf_cdr_json_render(rec);
+        if (json) {
+            size_t len = strlen(json);
+            char *line = ogs_malloc(len + 2);
+
+            /* One record per line, so an aggregated file reads back a
+             * record at a time and an individual file still ends in a
+             * newline. */
+            if (line) {
+                memcpy(line, json, len);
+                line[len] = '\n';
+                line[len + 1] = '\0';
+
+                json_path = sink_write(&sink_json, sess, line, len + 1, now);
+                if (json_path) {
+                    done++;
+                    written += len + 1;
+                }
+                chf_metrics_inst_labeled_inc(CHF_METR_LBL_CDR_ENCODED,
+                        sink_json.label, json_path ? "success" : "error",
+                        NULL);
+                ogs_free(line);
+            }
+        } else {
+            ogs_error("[%s] Cannot render CDR as JSON [ref:%s]",
+                    sess->supi, sess->charging_data_ref);
+            chf_metrics_inst_labeled_inc(CHF_METR_LBL_CDR_ENCODED,
+                    sink_json.label, "error", NULL);
+        }
+    }
+
+    if (chf_self()->cdr.formats & CHF_CDR_FMT_ASN1) {
+        wanted++;
+        ber_len = chf_cdr_record_encode_ber(rec, &ber);
+        if (ber_len > 0) {
+            ber_path = sink_write(&sink_asn1, sess, ber, (size_t)ber_len, now);
+            if (ber_path) {
+                done++;
+                written += (size_t)ber_len;
+            }
+            chf_metrics_inst_labeled_inc(CHF_METR_LBL_CDR_ENCODED,
+                    sink_asn1.label, ber_path ? "success" : "error", NULL);
+        } else {
+            ogs_error("[%s] Cannot encode CDR as BER [ref:%s]",
+                    sess->supi, sess->charging_data_ref);
+            chf_metrics_inst_labeled_inc(CHF_METR_LBL_CDR_ENCODED,
+                    sink_asn1.label, "error", NULL);
+        }
+    }
+
+    /* A record counts as written only when every selected encoding wrote
+     * it: a BER file that is missing records the JSON has is exactly the
+     * kind of divergence an operator needs to hear about. */
+    chf_metrics_inst_labeled_inc(CHF_METR_LBL_CDR_WRITTEN,
+            done == wanted ? "success" : "error", NULL, NULL);
+    if (done != wanted)
+        chf_metrics_inst_labeled_inc(CHF_METR_LBL_ERRORS, "cdr", NULL, NULL);
+
+    chf_metrics_inst_global_add(CHF_METR_CTR_CDR_BYTES,
+            chf_metrics_clamp_u64((uint64_t)written));
+    chf_metrics_inst_global_add(CHF_METR_HIST_CDR_WRITE_DURATION,
+            (int)((ogs_get_monotonic_time() - t0) / 1000));
+
+    if (done)
+        ogs_info("[%s] CDR written: %s%s%s "
+                 "(UL=%llu DL=%llu dur=%us cause=%s seq=%u)",
+                sess->supi,
+                json_path ? json_path : "",
+                (json_path && ber_path) ? " + " : "",
+                ber_path ? ber_path : "",
+                (unsigned long long)sess->ul_octets,
+                (unsigned long long)sess->dl_octets,
+                sess->duration,
+                cause ? cause : "normalRelease",
+                cdr_local_seq);
+
+    /*
+     * The CDR index in MongoDB holds one path.  JSON wins when both are
+     * written, because that is the file a person opens; the BER file is
+     * named the same way beside it, or is the aggregate stream its own
+     * log line names.
+     */
+    if (json_path) {
+        result = json_path;
+        json_path = NULL;
+    } else if (ber_path) {
+        result = ber_path;
+        ber_path = NULL;
+    }
+
+    if (json_path) ogs_free(json_path);
+    if (ber_path) ogs_free(ber_path);
+    if (json) ogs_free(json);
+    if (ber) ogs_free(ber);
+    chf_cdr_record_free(rec);
+
+    return result;
+}
diff --git a/src/chf/cdr-path.h b/src/chf/cdr-path.h
new file mode 100644
index 000000000..704cd80b9
--- /dev/null
+++ b/src/chf/cdr-path.h
@@ -0,0 +1,115 @@
+/*
+ * Copyright (C) 2026 by Rami Mohamed <ramrode@gmail.com>
+ *
+ * This file is part of Open5GS.
+ *
+ * This program is free software: you can redistribute it and/or modify
+ * it under the terms of the GNU Affero General Public License as published by
+ * the Free Software Foundation, either version 3 of the License, or
+ * (at your option) any later version.
+ *
+ * This program is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * along with this program.  If not, see <https://www.gnu.org/licenses/>.
+ */
+
+/*
+ * CHF CDR (Charging Data Record) writer.
+ *
+ * A session closing - on Release, on quota exhaustion, or because the
+ * operator aborted it - becomes one TS 32.298 ChargingRecord.  The record
+ * is built once (cdr-record.c) and written in whichever encodings the
+ * configuration asks for, so the files never disagree:
+ *
+ *   BER    the encoding TS 32.298 clause 6.1 requires on the Bx
+ *          interface ("Data Record Format" 1), produced by the asn1c
+ *          codec in lib/asn1c/cdr.
+ *   JSON   the same record with the same 3GPP field names, for anything
+ *          that would rather read text than decode BER (cdr-json.c).
+ *
+ * Filed either one file per session or many records to a file:
+ *
+ *   individual   {path}/YYYY/MM/DD/cdr-{chargingDataRef}.{json,ber}
+ *   aggregated   {path}/YYYY/MM/DD/cdr-{YYYYMMDDhhmmss}-{seq}.{json,ber}
+ *
+ * All of it from chf.yaml:
+ *
+ *   charging:
+ *     cdr:
+ *       enable: true
+ *       path: /var/log/open5gs/cdr
+ *       format: both              # json | asn1 | both | none
+ *       aggregation:              # the default for both encodings
+ *         enable: false           # false: one file per session
+ *         max_records: 1000       # roll at this many records (0 = no cap)
+ *         max_size_mb: 16         # roll at this size (0 = no cap)
+ *       asn1:                     # per-encoding override
+ *         aggregation:
+ *           enable: true
+ */
+
+#ifndef CHF_CDR_PATH_H
+#define CHF_CDR_PATH_H
+
+#include "context.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/*
+ * chf_cdr_init / chf_cdr_final
+ *
+ * Called from chf_context_init / chf_context_final after the config is parsed.
+ * Sets the CDR base directory from chf_self()->cdr_path.
+ */
+void chf_cdr_init(void);
+void chf_cdr_final(void);
+
+/*
+ * chf_cdr_write — write the CDR for a closing session.
+ *
+ * @param sess   The session being closed, with its final usage already
+ *               accumulated.
+ * @param cause  TS 32.298 causeForRecClosing:
+ *               "normalRelease"          — SMF sent Release
+ *               "volumeLimit"            — quota exhausted (FinalUnitAction)
+ *               "managementIntervention" — the operator closed it, via a
+ *                                          ChargingNotify ABORT_CHARGING
+ *
+ * Returns the path of the file the record went into, for the CDR index
+ * in MongoDB; the caller frees it.  With both encodings enabled that is
+ * the JSON file, since it is the one a person opens - the log line for
+ * the write names both.  Returns NULL when nothing was written, which
+ * covers CDRs being disabled, no encoding being selected, and failure.
+ *
+ * TS 32.298 §5.1.5 — CHF CDR content
+ * TS 32.298 §5.2.5 — its ASN.1 syntax
+ */
+/*
+ * Whether a closing session is worth a CDR.
+ *
+ * A session that was granted nothing and used nothing carries no billable
+ * information: it is a session the network refused because the subscriber
+ * had no allowance left.  A UE that re-establishes on its own can produce
+ * a stream of those, and a CDR file each would bury the real records.
+ *
+ * A session with a real grant still gets its CDR even at zero usage - that
+ * one says the subscriber attached and used nothing.
+ */
+static ogs_inline bool chf_cdr_is_billable(const chf_sess_t *sess)
+{
+    return sess->ul_octets || sess->dl_octets || sess->granted_quota_total;
+}
+
+char *chf_cdr_write(chf_sess_t *sess, const char *cause);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* CHF_CDR_PATH_H */
diff --git a/src/chf/cdr-record.c b/src/chf/cdr-record.c
new file mode 100644
index 000000000..028c14f9d
--- /dev/null
+++ b/src/chf/cdr-record.c
@@ -0,0 +1,511 @@
+/*
+ * Copyright (C) 2026 by Rami Mohamed <ramrode@gmail.com>
+ *
+ * This file is part of Open5GS.
+ *
+ * This program is free software: you can redistribute it and/or modify
+ * it under the terms of the GNU Affero General Public License as published by
+ * the Free Software Foundation, either version 3 of the License, or
+ * (at your option) any later version.
+ *
+ * This program is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * along with this program.  If not, see <https://www.gnu.org/licenses/>.
+ */
+
+#include <time.h>
+
+#include "cdr-record.h"
+
+/* ------------------------------------------------------------------ */
+/* TS 32.298 CauseForRecClosing                                         */
+/*                                                                      */
+/* The three the CHF can close a session for.  The names are the ones    */
+/* the ASN.1 gives the values, so the JSON and the BER say the same      */
+/* thing - the JSON by name, the BER by number.                         */
+/* ------------------------------------------------------------------ */
+
+#define CHF_CDR_CAUSE_NORMAL_RELEASE            0
+#define CHF_CDR_CAUSE_VOLUME_LIMIT              16
+#define CHF_CDR_CAUSE_MANAGEMENT_INTERVENTION   20
+
+long chf_cdr_cause_value(const char *cause)
+{
+    if (!cause)
+        return CHF_CDR_CAUSE_NORMAL_RELEASE;
+    if (!strcmp(cause, "volumeLimit"))
+        return CHF_CDR_CAUSE_VOLUME_LIMIT;
+    if (!strcmp(cause, "managementIntervention"))
+        return CHF_CDR_CAUSE_MANAGEMENT_INTERVENTION;
+    if (!strcmp(cause, "normalRelease"))
+        return CHF_CDR_CAUSE_NORMAL_RELEASE;
+
+    ogs_warn("CDR: unknown causeForRecClosing '%s' — recording "
+             "normalRelease", cause);
+    return CHF_CDR_CAUSE_NORMAL_RELEASE;
+}
+
+const char *chf_cdr_cause_name(long value)
+{
+    switch (value) {
+    case CHF_CDR_CAUSE_NORMAL_RELEASE:          return "normalRelease";
+    case CHF_CDR_CAUSE_VOLUME_LIMIT:            return "volumeLimit";
+    case CHF_CDR_CAUSE_MANAGEMENT_INTERVENTION:
+        return "managementIntervention";
+    default:                                    return NULL;
+    }
+}
+
+/* ------------------------------------------------------------------ */
+/* TS 32.298 TimeStamp                                                  */
+/*                                                                      */
+/* Nine octets: BCD YYMMDDhhmmss, then the sign of the offset to UTC as  */
+/* ASCII, then BCD hhmm of that offset.  The CHF keeps time in UTC, so   */
+/* the local time it writes is UTC and the offset is +0000 - correct     */
+/* rather than merely convenient, since the pair is what makes the       */
+/* timestamp unambiguous.                                               */
+/* ------------------------------------------------------------------ */
+
+#define BCD(n)  (uint8_t)((((n) / 10) << 4) | ((n) % 10))
+
+static int set_timestamp(CHFCDR_TimeStamp_t *ts, time_t t)
+{
+    struct tm tm_utc;
+    uint8_t v[9];
+
+    ogs_assert(ts);
+
+    if (!gmtime_r(&t, &tm_utc))
+        return OGS_ERROR;
+
+    v[0] = BCD((tm_utc.tm_year + 1900) % 100);
+    v[1] = BCD(tm_utc.tm_mon + 1);
+    v[2] = BCD(tm_utc.tm_mday);
+    v[3] = BCD(tm_utc.tm_hour);
+    v[4] = BCD(tm_utc.tm_min);
+    v[5] = BCD(tm_utc.tm_sec);
+    v[6] = (uint8_t)'+';
+    v[7] = BCD(0);
+    v[8] = BCD(0);
+
+    if (OCTET_STRING_fromBuf(ts, (const char *)v, sizeof(v)) != 0)
+        return OGS_ERROR;
+
+    return OGS_OK;
+}
+
+static CHFCDR_TimeStamp_t *new_timestamp(time_t t)
+{
+    CHFCDR_TimeStamp_t *ts = ogs_calloc(1, sizeof(*ts));
+    if (!ts)
+        return NULL;
+    if (set_timestamp(ts, t) != OGS_OK) {
+        ogs_free(ts);
+        return NULL;
+    }
+    return ts;
+}
+
+/* ------------------------------------------------------------------ */
+/* Building the record                                                  */
+/* ------------------------------------------------------------------ */
+
+/*
+ * listOfMultipleUnitUsage [5] — one MultipleUnitUsage for the session's
+ * rating group, holding one UsedUnitContainer with the volumes.
+ *
+ * The CHF grants a single combined allowance rather than a per-direction
+ * pair, so dataTotalVolume is what it actually charged against; the
+ * uplink and downlink figures are reported alongside it because the UPF
+ * counts them separately and a mediation system expects to see them.
+ */
+static int add_unit_usage(CHFCDR_ChargingRecord_t *cr,
+        const chf_sess_t *sess, uint32_t local_seq)
+{
+    CHFCDR_MultipleUnitUsage_t *muu = NULL;
+    CHFCDR_UsedUnitContainer_t *uuc = NULL;
+
+    muu = ogs_calloc(1, sizeof(*muu));
+    if (!muu)
+        goto fail;
+    uuc = ogs_calloc(1, sizeof(*uuc));
+    if (!uuc)
+        goto fail;
+
+    muu->ratingGroup = (CHFCDR_RatingGroupId_t)sess->rating_group;
+
+    if (sess->service_id) {
+        uuc->serviceIdentifier = ogs_calloc(1, sizeof(*uuc->serviceIdentifier));
+        if (!uuc->serviceIdentifier)
+            goto fail;
+        *uuc->serviceIdentifier =
+            (CHFCDR_ServiceIdentifier_t)sess->service_id;
+    }
+
+    uuc->time = ogs_calloc(1, sizeof(*uuc->time));
+    if (!uuc->time)
+        goto fail;
+    *uuc->time = (CHFCDR_CallDuration_t)sess->duration;
+
+    uuc->dataTotalVolume = ogs_calloc(1, sizeof(*uuc->dataTotalVolume));
+    if (!uuc->dataTotalVolume)
+        goto fail;
+    *uuc->dataTotalVolume =
+        (CHFCDR_DataVolumeOctets_t)(sess->ul_octets + sess->dl_octets);
+
+    uuc->dataVolumeUplink = ogs_calloc(1, sizeof(*uuc->dataVolumeUplink));
+    if (!uuc->dataVolumeUplink)
+        goto fail;
+    *uuc->dataVolumeUplink = (CHFCDR_DataVolumeOctets_t)sess->ul_octets;
+
+    uuc->dataVolumeDownlink = ogs_calloc(1, sizeof(*uuc->dataVolumeDownlink));
+    if (!uuc->dataVolumeDownlink)
+        goto fail;
+    *uuc->dataVolumeDownlink = (CHFCDR_DataVolumeOctets_t)sess->dl_octets;
+
+    uuc->localSequenceNumber =
+        ogs_calloc(1, sizeof(*uuc->localSequenceNumber));
+    if (!uuc->localSequenceNumber)
+        goto fail;
+    *uuc->localSequenceNumber = (CHFCDR_LocalSequenceNumber_t)local_seq;
+
+    muu->usedUnitContainers = ogs_calloc(1, sizeof(*muu->usedUnitContainers));
+    if (!muu->usedUnitContainers)
+        goto fail;
+    if (ASN_SEQUENCE_ADD(&muu->usedUnitContainers->list, uuc) != 0)
+        goto fail;
+    uuc = NULL;   /* owned by the list now */
+
+    cr->listOfMultipleUnitUsage =
+        ogs_calloc(1, sizeof(*cr->listOfMultipleUnitUsage));
+    if (!cr->listOfMultipleUnitUsage)
+        goto fail;
+    if (ASN_SEQUENCE_ADD(&cr->listOfMultipleUnitUsage->list, muu) != 0)
+        goto fail;
+
+    return OGS_OK;
+
+fail:
+    if (uuc)
+        ASN_STRUCT_FREE(asn_DEF_CHFCDR_UsedUnitContainer, uuc);
+    if (muu)
+        ASN_STRUCT_FREE(asn_DEF_CHFCDR_MultipleUnitUsage, muu);
+    return OGS_ERROR;
+}
+
+/*
+ * pDUSessionChargingInformation [13] — what the session was.
+ *
+ * pDUSessionChargingID is mandatory and must identify the session.  The
+ * CHF's own key is the ChargingDataRef UUID, which does not fit a
+ * 32-bit ChargingID, so the id is derived from it by hashing and the
+ * UUID itself is carried whole in chargingSessionIdentifier [16].  A
+ * reader correlating records should use that field, not this one.
+ */
+static int add_pdu_session_info(CHFCDR_ChargingRecord_t *cr,
+        const chf_sess_t *sess, time_t start, time_t stop)
+{
+    CHFCDR_PDUSessionChargingInformation_t *p;
+
+    p = ogs_calloc(1, sizeof(*p));
+    if (!p)
+        return OGS_ERROR;
+
+    {
+        int klen = (int)strlen(sess->charging_data_ref);
+        p->pDUSessionChargingID = (CHFCDR_ChargingID_t)
+            (ogs_hashfunc_default(sess->charging_data_ref, &klen) &
+             0xffffffffU);
+    }
+    p->pDUSessionId = (CHFCDR_PDUSessionId_t)sess->psi;
+
+    /* userIdentifier [1] — the GPSI, when the SMF sent one.  A 5G GPSI is
+     * either an MSISDN or an external id (TS 23.003 clause 28.8), and
+     * open5gs carries it prefixed: "msisdn-<digits>" or "extid-<nai>". */
+    if (sess->gpsi && sess->gpsi[0]) {
+        const char *digits = NULL;
+
+        p->userIdentifier = ogs_calloc(1, sizeof(*p->userIdentifier));
+        if (!p->userIdentifier)
+            goto fail;
+
+        if (!strncmp(sess->gpsi, "msisdn-", 7)) {
+            digits = sess->gpsi + 7;
+            p->userIdentifier->present =
+                CHFCDR_InvolvedParty_PR_iSDN_E164;
+            if (OCTET_STRING_fromString(
+                        &p->userIdentifier->choice.iSDN_E164, digits) != 0)
+                goto fail;
+        } else {
+            digits = !strncmp(sess->gpsi, "extid-", 6) ?
+                sess->gpsi + 6 : sess->gpsi;
+            p->userIdentifier->present =
+                CHFCDR_InvolvedParty_PR_externalId;
+            if (OCTET_STRING_fromString(
+                        &p->userIdentifier->choice.externalId, digits) != 0)
+                goto fail;
+        }
+    }
+
+    /* networkSliceInstanceID [7] — the S-NSSAI the session ran on.
+     * Absent when the SMF sent no networkSlicingInfo. */
+    if (sess->s_nssai.sst) {
+        p->networkSliceInstanceID =
+            ogs_calloc(1, sizeof(*p->networkSliceInstanceID));
+        if (!p->networkSliceInstanceID)
+            goto fail;
+        p->networkSliceInstanceID->sST =
+            (CHFCDR_SliceServiceType_t)sess->s_nssai.sst;
+
+        if (sess->s_nssai.sd.v != OGS_S_NSSAI_NO_SD_VALUE) {
+            uint8_t sd[3];
+            sd[0] = (uint8_t)(sess->s_nssai.sd.v >> 16);
+            sd[1] = (uint8_t)(sess->s_nssai.sd.v >> 8);
+            sd[2] = (uint8_t)(sess->s_nssai.sd.v);
+
+            p->networkSliceInstanceID->sD =
+                ogs_calloc(1, sizeof(*p->networkSliceInstanceID->sD));
+            if (!p->networkSliceInstanceID->sD)
+                goto fail;
+            if (OCTET_STRING_fromBuf(p->networkSliceInstanceID->sD,
+                        (const char *)sd, sizeof(sd)) != 0)
+                goto fail;
+        }
+    }
+
+    if (sess->dnn && sess->dnn[0]) {
+        p->dataNetworkNameIdentifier =
+            ogs_calloc(1, sizeof(*p->dataNetworkNameIdentifier));
+        if (!p->dataNetworkNameIdentifier)
+            goto fail;
+        if (OCTET_STRING_fromString(p->dataNetworkNameIdentifier,
+                    sess->dnn) != 0)
+            goto fail;
+    }
+
+    p->pDUSessionstartTime = new_timestamp(start);
+    if (!p->pDUSessionstartTime)
+        goto fail;
+    p->pDUSessionstopTime = new_timestamp(stop);
+    if (!p->pDUSessionstopTime)
+        goto fail;
+
+    cr->pDUSessionChargingInformation = p;
+    return OGS_OK;
+
+fail:
+    ASN_STRUCT_FREE(asn_DEF_CHFCDR_PDUSessionChargingInformation, p);
+    return OGS_ERROR;
+}
+
+CHFCDR_CHFRecord_t *chf_cdr_record_build(const chf_sess_t *sess,
+        const char *cause, uint32_t local_seq)
+{
+    CHFCDR_CHFRecord_t *rec = NULL;
+    CHFCDR_ChargingRecord_t *cr = NULL;
+    const char *own_id;
+    time_t stop, start;
+
+    ogs_assert(sess);
+
+    if (!sess->charging_data_ref) {
+        ogs_error("CDR: session has no ChargingDataRef");
+        return NULL;
+    }
+
+    /* recordingNetworkFunctionID [1] is mandatory and must be a UUID
+     * (TS 32.298: NetworkFunctionName, 1..36 characters).  That is this
+     * CHF's own NF instance id, which exists from registration onwards. */
+    own_id = (ogs_sbi_self()->nf_instance && ogs_sbi_self()->nf_instance->id) ?
+        ogs_sbi_self()->nf_instance->id : NULL;
+    if (!own_id) {
+        ogs_error("[%s] CDR: no NF instance id to record as "
+                  "recordingNetworkFunctionID", sess->supi);
+        return NULL;
+    }
+
+    stop = time(NULL);
+    /* period_start is when the current billing period opened, which is
+     * the session's own start for a session that never renewed.  Falling
+     * back to stop - duration keeps the pair consistent when it is
+     * unset. */
+    start = sess->period_start ? sess->period_start :
+        stop - (time_t)sess->duration;
+
+    rec = ogs_calloc(1, sizeof(*rec));
+    if (!rec)
+        return NULL;
+
+    /* -findirect-choice: a constructed CHOICE alternative is a pointer. */
+    rec->present = CHFCDR_CHFRecord_PR_chargingFunctionRecord;
+    rec->choice.chargingFunctionRecord = ogs_calloc(1, sizeof(*cr));
+    if (!rec->choice.chargingFunctionRecord)
+        goto fail;
+    cr = rec->choice.chargingFunctionRecord;
+
+    /* recordType [0] — chargingFunctionRecord (200).  TS 32.298 reserves
+     * values from 200 for the Charging Function domain. */
+    cr->recordType = 200;
+
+    if (OCTET_STRING_fromString(&cr->recordingNetworkFunctionID,
+                own_id) != 0)
+        goto fail;
+
+    /* subscriberIdentifier [2] — the SUPI.  open5gs carries it as
+     * "imsi-<digits>", which is what eND-USER-IMSI means here. */
+    if (sess->supi && sess->supi[0]) {
+        cr->subscriberIdentifier =
+            ogs_calloc(1, sizeof(*cr->subscriberIdentifier));
+        if (!cr->subscriberIdentifier)
+            goto fail;
+        cr->subscriberIdentifier->subscriptionIDType =
+            CHFCDR_SubscriptionIDType_eND_USER_IMSI;
+        if (OCTET_STRING_fromString(
+                    &cr->subscriberIdentifier->subscriptionIDData,
+                    sess->supi) != 0)
+            goto fail;
+    }
+
+    /* nFunctionConsumerInformation [3] — who asked for the charging, i.e.
+     * the SMF.  Mandatory, so the functionality is always recorded even
+     * when the SMF sent no nfConsumerIdentification to name it with. */
+    cr->nFunctionConsumerInformation =
+        ogs_calloc(1, sizeof(*cr->nFunctionConsumerInformation));
+    if (!cr->nFunctionConsumerInformation)
+        goto fail;
+    cr->nFunctionConsumerInformation->networkFunctionality =
+        CHFCDR_NetworkFunctionality_sMF;
+    if (sess->smf_id && sess->smf_id[0]) {
+        cr->nFunctionConsumerInformation->networkFunctionName =
+            ogs_calloc(1,
+                sizeof(*cr->nFunctionConsumerInformation->networkFunctionName));
+        if (!cr->nFunctionConsumerInformation->networkFunctionName)
+            goto fail;
+        if (OCTET_STRING_fromString(
+                cr->nFunctionConsumerInformation->networkFunctionName,
+                sess->smf_id) != 0)
+            goto fail;
+    }
+
+    if (add_unit_usage(cr, sess, local_seq) != OGS_OK)
+        goto fail;
+
+    if (set_timestamp(&cr->recordOpeningTime, start) != OGS_OK)
+        goto fail;
+
+    cr->duration = (CHFCDR_CallDuration_t)sess->duration;
+    cr->causeForRecClosing = chf_cdr_cause_value(cause);
+
+    cr->localRecordSequenceNumber =
+        ogs_calloc(1, sizeof(*cr->localRecordSequenceNumber));
+    if (!cr->localRecordSequenceNumber)
+        goto fail;
+    *cr->localRecordSequenceNumber =
+        (CHFCDR_LocalSequenceNumber_t)local_seq;
+
+    if (add_pdu_session_info(cr, sess, start, stop) != OGS_OK)
+        goto fail;
+
+    /* chargingSessionIdentifier [16] — the ChargingDataRef, whole.  This
+     * is the field that correlates a CDR with the Nchf session that
+     * produced it. */
+    cr->chargingSessionIdentifier =
+        ogs_calloc(1, sizeof(*cr->chargingSessionIdentifier));
+    if (!cr->chargingSessionIdentifier)
+        goto fail;
+    if (OCTET_STRING_fromString(cr->chargingSessionIdentifier,
+                sess->charging_data_ref) != 0)
+        goto fail;
+
+    return rec;
+
+fail:
+    chf_cdr_record_free(rec);
+    return NULL;
+}
+
+void chf_cdr_record_free(CHFCDR_CHFRecord_t *rec)
+{
+    if (!rec)
+        return;
+    ASN_STRUCT_FREE(asn_DEF_CHFCDR_CHFRecord, rec);
+}
+
+/* ------------------------------------------------------------------ */
+/* DER encoding                                                         */
+/* ------------------------------------------------------------------ */
+
+struct ber_sink {
+    uint8_t *buf;
+    size_t   size;      /* allocated */
+    size_t   len;       /* used */
+    bool     failed;
+};
+
+static int ber_sink_write(const void *data, size_t size, void *key)
+{
+    struct ber_sink *s = key;
+
+    if (s->failed)
+        return -1;
+
+    if (s->len + size > s->size) {
+        size_t want = s->size ? s->size * 2 : 1024;
+        uint8_t *bigger;
+
+        while (want < s->len + size)
+            want *= 2;
+
+        bigger = ogs_realloc(s->buf, want);
+        if (!bigger) {
+            s->failed = true;
+            return -1;
+        }
+        s->buf = bigger;
+        s->size = want;
+    }
+
+    memcpy(s->buf + s->len, data, size);
+    s->len += size;
+    return 0;
+}
+
+int chf_cdr_record_encode_ber(const CHFCDR_CHFRecord_t *rec, uint8_t **out)
+{
+    struct ber_sink sink = { NULL, 0, 0, false };
+    asn_enc_rval_t er;
+
+    ogs_assert(rec);
+    ogs_assert(out);
+
+    *out = NULL;
+
+    /* der_encode() takes a non-const pointer but does not modify the
+     * structure. */
+    er = der_encode(&asn_DEF_CHFCDR_CHFRecord, (void *)rec,
+            ber_sink_write, &sink);
+
+    if (er.encoded < 0 || sink.failed) {
+        ogs_error("CDR: DER encoding failed at %s",
+                er.failed_type && er.failed_type->name ?
+                er.failed_type->name : "(unknown type)");
+        if (sink.buf)
+            ogs_free(sink.buf);
+        return OGS_ERROR;
+    }
+
+    if ((size_t)er.encoded != sink.len) {
+        ogs_error("CDR: DER encoder reported %ld bytes but wrote %zu",
+                (long)er.encoded, sink.len);
+        if (sink.buf)
+            ogs_free(sink.buf);
+        return OGS_ERROR;
+    }
+
+    *out = sink.buf;
+    return (int)sink.len;
+}
