+/*
+ * Grant shaping (chf.yaml charging.grant)
+ *
+ * The CHF does not hand a session everything left in its billing cycle.  Each
+ * grant is capped, carries a validityTime, and says how much of it should be
+ * left when the SMF reports (volumeQuotaThreshold, TS 32.291
+ * MultipleUnitInformation).  Those three numbers decide how quickly a plan
+ * change reaches a live session, how much two devices on one plan can
+ * overspend, and how many Updates it costs to use an allowance up.
+ *
+ * chf_grant_volume()    — the slice
+ * chf_grant_validity()  — the timer
+ * chf_grant_threshold() — when to report, and the floor that stops the
+ *                         end of an allowance turning into a burst of
+ *                         Updates that each grant almost nothing
+ * chf_grant_holding()   — how long an idle session may hold the grant
+ *                         before it has to hand the rest back
+ */
+
+#include "ogs-sbi.h"
+#include "chf/context.h"
+#include "core/abts.h"
+
+#define MB ((uint64_t)1024 * 1024)
+
+/* ------------------------------------------------------------------ */
+/* Shipped defaults: 50 MiB slices, 5 min, no early report below 5 MiB */
+/* ------------------------------------------------------------------ */
+static void test_grant_defaults(abts_case *tc, void *data)
+{
+    chf_context_t *ctx = chf_self();
+    ABTS_PTR_NOTNULL(tc, ctx);
+
+    ABTS_TRUE(tc, ctx->grant.max_volume_bytes == 50 * MB);
+    ABTS_INT_EQUAL(tc, 300, (int)ctx->grant.max_validity_seconds);
+    ABTS_TRUE(tc, ctx->grant.min_report_bytes == 5 * MB);
+    ABTS_INT_EQUAL(tc, 60, (int)ctx->grant.quota_holding_seconds);
+
+    /* Unprovisioned SUPIs get the default quota unless configured to be
+     * refused (chf.yaml charging.unprovisioned). */
+    ABTS_TRUE(tc, ctx->reject_unprovisioned == false);
+}
+
+/* ------------------------------------------------------------------ */
+/* The slice: min(remaining, cap); 0 disables the cap                  */
+/* ------------------------------------------------------------------ */
+static void test_grant_volume_slice(abts_case *tc, void *data)
+{
+    /* More left than one slice */
+    ABTS_TRUE(tc, chf_grant_volume(10240 * MB, 50 * MB) == 50 * MB);
+    /* Exactly one slice */
+    ABTS_TRUE(tc, chf_grant_volume(50 * MB, 50 * MB) == 50 * MB);
+    /* Less than a slice: grant what is left */
+    ABTS_TRUE(tc, chf_grant_volume(12 * MB, 50 * MB) == 12 * MB);
+    ABTS_TRUE(tc, chf_grant_volume(1, 50 * MB) == 1);
+    /* Nothing left */
+    ABTS_TRUE(tc, chf_grant_volume(0, 50 * MB) == 0);
+    /* Cap disabled: the whole remainder, as before slicing */
+    ABTS_TRUE(tc, chf_grant_volume(10240 * MB, 0) == 10240 * MB);
+}
+
+/* ------------------------------------------------------------------ */
+/* validityTime: the lesser of the cycle's end and the cap             */
+/* ------------------------------------------------------------------ */
+static void test_grant_validity_cap(abts_case *tc, void *data)
+{
+    /* A monthly cycle is far away: the cap decides */
+    ABTS_INT_EQUAL(tc, 300, (int)chf_grant_validity(2592000, 300));
+    /* The cycle ends first: never promise time past it */
+    ABTS_INT_EQUAL(tc, 42, (int)chf_grant_validity(42, 300));
+    ABTS_INT_EQUAL(tc, 300, (int)chf_grant_validity(300, 300));
+    /* No cycle end (validity_seconds 0): only the cap applies */
+    ABTS_INT_EQUAL(tc, 300, (int)chf_grant_validity(0, 300));
+    /* Cap disabled: run to the end of the cycle */
+    ABTS_INT_EQUAL(tc, 2592000, (int)chf_grant_validity(2592000, 0));
+    /* Neither: omit validityTime (0 means "do not send it") */
+    ABTS_INT_EQUAL(tc, 0, (int)chf_grant_validity(0, 0));
+}
+
+/* ------------------------------------------------------------------ */
+/* quotaHoldingTime: an idle session gives its grant back after this   */
+/* long, capped at the life of the grant it is holding                 */
+/* ------------------------------------------------------------------ */
+static void test_grant_holding_cap(abts_case *tc, void *data)
+{
+    /* The usual case: 60 s of idleness inside a 300 s grant */
+    ABTS_INT_EQUAL(tc, 60, (int)chf_grant_holding(300, 60));
+    /* Never outlast the grant: validityTime would fire first, so a
+     * holding time past it could never be reached */
+    ABTS_INT_EQUAL(tc, 45, (int)chf_grant_holding(45, 60));
+    ABTS_INT_EQUAL(tc, 60, (int)chf_grant_holding(60, 60));
+    /* No validityTime on this grant: nothing to cap against */
+    ABTS_INT_EQUAL(tc, 60, (int)chf_grant_holding(0, 60));
+    /* Turned off (quota_holding_seconds 0): omit quotaHoldingTime, so
+     * the session holds its grant until it is spent or expires */
+    ABTS_INT_EQUAL(tc, 0, (int)chf_grant_holding(300, 0));
+    ABTS_INT_EQUAL(tc, 0, (int)chf_grant_holding(0, 0));
+}
+
+/* ------------------------------------------------------------------ */
+/* volumeQuotaThreshold: 10% left, but not for a grant at or below the */
+/* floor - that one is reported only when it is used up                */
+/* ------------------------------------------------------------------ */
+static void test_grant_threshold_floor(abts_case *tc, void *data)
+{
+    /* Above the floor: report with 10% of the grant left */
+    ABTS_TRUE(tc, chf_grant_threshold(50 * MB, 5 * MB) == 5 * MB);
+    ABTS_TRUE(tc, chf_grant_threshold(45 * MB, 5 * MB) == 45 * MB / 10);
+    /* At the floor, and below it: no early report */
+    ABTS_TRUE(tc, chf_grant_threshold(5 * MB, 5 * MB) == 0);
+    ABTS_TRUE(tc, chf_grant_threshold(4 * MB + 512 * 1024, 5 * MB) == 0);
+    ABTS_TRUE(tc, chf_grant_threshold(1, 5 * MB) == 0);
+    ABTS_TRUE(tc, chf_grant_threshold(0, 5 * MB) == 0);
+    /* Floor disabled: always the 10% early report */
+    ABTS_TRUE(tc, chf_grant_threshold(1000, 0) == 100);
+    ABTS_TRUE(tc, chf_grant_threshold(50 * MB, 0) == 5 * MB);
+}
+
+/* ------------------------------------------------------------------ */
+/* How an allowance is actually spent                                   */
+/*                                                                      */
+/* Replays what the SMF and UPF do with each grant: use it until the    */
+/* threshold says to report (or all of it when there is no early        */
+/* report), report, take the next grant.  Returns the number of reports */
+/* and checks that exactly the allowance was used - never more.         */
+/* ------------------------------------------------------------------ */
+static int spend_allowance(abts_case *tc, uint64_t allowance,
+        uint64_t slice, uint64_t min_report)
+{
+    uint64_t consumed = 0;
+    int reports = 0;
+
+    for (;;) {
+        uint64_t grant = chf_grant_volume(allowance - consumed, slice);
+        uint64_t threshold = chf_grant_threshold(grant, min_report);
+        uint64_t used_before_report;
+
+        if (grant == 0)
+            break;      /* exhausted: the CHF answers with FinalUnit */
+
+        /* The UPF reports either at the threshold or when the grant is
+         * gone; traffic is assumed to keep flowing throughout. */
+        used_before_report = grant - threshold;
+        consumed += used_before_report;
+        reports++;
+
+        ABTS_TRUE(tc, consumed <= allowance);
+        ABTS_TRUE(tc, reports < 10000);   /* no runaway loop */
+        if (reports >= 10000)
+            break;
+    }
+
+    /* Every octet of the allowance is accounted for, and no more. */
+    ABTS_TRUE(tc, consumed == allowance);
+    return reports;
+}
+
+static void test_spend_90mb_plan(abts_case *tc, void *data)
+{
+    /*
+     * 90 MB plan with the shipped settings: 50 MB, then 45 MB, then the
+     * 4.5 MB remainder, which is under the floor and so is reported only
+     * once it is used up.  Three reports, matching what the CHF does
+     * against a live SMF and UPF.
+     */
+    ABTS_INT_EQUAL(tc, 3, spend_allowance(tc, 90 * MB, 50 * MB, 5 * MB));
+
+    /*
+     * Without the floor, every report leaves 10% of the one before, and
+     * the last megabyte costs a burst of Updates that each grant almost
+     * nothing.  This is the regression the floor fixes, so the test names
+     * the old cost rather than just "fewer".
+     */
+    ABTS_INT_EQUAL(tc, 9, spend_allowance(tc, 90 * MB, 50 * MB, 0));
+}
+
+static void test_spend_edge_sizes(abts_case *tc, void *data)
+{
+    /* A plan smaller than the floor: one grant, one report */
+    ABTS_INT_EQUAL(tc, 1, spend_allowance(tc, 2 * MB, 50 * MB, 5 * MB));
+    /* Exactly one slice */
+    ABTS_INT_EQUAL(tc, 2, spend_allowance(tc, 50 * MB, 50 * MB, 5 * MB));
+    /* A large plan still terminates, and bills exactly the allowance */
+    ABTS_TRUE(tc, spend_allowance(tc, 10240 * MB, 50 * MB, 5 * MB) > 200);
+    /* Slicing disabled: one grant for the whole plan, reported at 90%,
+     * then 9 MB, then the remainder once it drops under the floor */
+    ABTS_INT_EQUAL(tc, 3, spend_allowance(tc, 90 * MB, 0, 5 * MB));
+}
+
+/* ------------------------------------------------------------------ */
+/* Suite registration                                                   */
+/* ------------------------------------------------------------------ */
+abts_suite *test_chf_grant(abts_suite *suite)
+{
+    suite = ADD_SUITE(suite);
+
+    abts_run_test(suite, test_grant_defaults,        NULL);
+    abts_run_test(suite, test_grant_volume_slice,    NULL);
+    abts_run_test(suite, test_grant_validity_cap,    NULL);
+    abts_run_test(suite, test_grant_holding_cap,     NULL);
+    abts_run_test(suite, test_grant_threshold_floor, NULL);
+    abts_run_test(suite, test_spend_90mb_plan,       NULL);
+    abts_run_test(suite, test_spend_edge_sizes,      NULL);
+
+    return suite;
+}
diff --git a/tests/chf/chf-metrics-test.c b/tests/chf/chf-metrics-test.c
new file mode 100644
index 000000000..79d0ea5b7
--- /dev/null
+++ b/tests/chf/chf-metrics-test.c
@@ -0,0 +1,148 @@
+/*
+ * Copyright (C) 2026 by Rami Mohamed <ramrode@gmail.com>
+ *
+ * This file is part of Open5GS.
+ *
+ * This program is free software: you can redistribute it and/or modify
+ * it under the terms of the GNU Affero General Public License as published by
+ * the Free Software Foundation, either version 3 of the License, or
+ * (at your option) any later version.
+ *
+ * This program is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * along with this program.  If not, see <https://www.gnu.org/licenses/>.
+ */
+
+/*
+ * The metric tables, and the contract the rest of the tests rely on.
+ *
+ * These do not read metric values — that needs a running metrics context,
+ * a Prometheus exporter and a scrape, which is the rig's job. What they
+ * check is the part that silently rots:
+ *
+ *   - Both spec tables are sized by their enum's _MAX and filled with
+ *     designated initialisers, so adding a metric to an enum and
+ *     forgetting its spec leaves a zeroed entry whose name is NULL.
+ *     chf_metrics_init_spec() passes that straight to
+ *     ogs_metrics_spec_new(), so the mistake reaches the exporter rather
+ *     than the compiler.
+ *
+ *   - Every other suite in this binary instruments code that calls
+ *     chf_metrics_inst_*() without a metrics context. The header
+ *     promises those are no-ops; if that ever stopped being true, every
+ *     CDR and quota test would start crashing for a reason that has
+ *     nothing to do with what they test. Worth one test of its own.
+ *
+ * Test IDs: METR-1 .. METR-4
+ */
+
+#include "ogs-sbi.h"
+#include "chf/context.h"
+#include "chf/metrics.h"
+#include "core/abts.h"
+
+/* ------------------------------------------------------------------ */
+/* METR-1: every metric spec is complete                               */
+/* ------------------------------------------------------------------ */
+static void test_metrics_specs_complete(abts_case *tc, void *data)
+{
+    /*
+     * Zero is the only acceptable answer. A non-zero count means some
+     * metric in chf_metric_global_t or chf_metric_labeled_t has no spec,
+     * no description, or a label count the instance key cannot hold —
+     * chf_metrics_spec_defects() logs which.
+     */
+    ABTS_INT_EQUAL(tc, 0, chf_metrics_spec_defects());
+}
+
+/* ------------------------------------------------------------------ */
+/* METR-2: the enums are non-empty and within the key's capacity       */
+/* ------------------------------------------------------------------ */
+static void test_metrics_enum_bounds(abts_case *tc, void *data)
+{
+    ABTS_TRUE(tc, _CHF_METR_GLOB_MAX > 0);
+    ABTS_TRUE(tc, _CHF_METR_LBL_MAX > 0);
+
+    /* A labeled metric may carry at most CHF_METR_MAX_LABELS labels, and
+     * the instance key is sized for exactly that. */
+    ABTS_TRUE(tc, CHF_METR_MAX_LABELS >= 1);
+    ABTS_TRUE(tc, CHF_METR_LABEL_LEN > 1);
+
+    /* The series cap is what stops an unbounded label value from growing
+     * the hash without limit. */
+    ABTS_TRUE(tc, CHF_METR_MAX_LABELED_INSTANCES > 0);
+}
+
+/* ------------------------------------------------------------------ */
+/* METR-3: instrumentation is a no-op before the context exists        */
+/*                                                                      */
+/* This is the contract every other suite here depends on.  None of     */
+/* them starts a metrics context, yet all of them run code that         */
+/* instruments.                                                         */
+/* ------------------------------------------------------------------ */
+static void test_metrics_noop_without_context(abts_case *tc, void *data)
+{
+    /* Global: set, add, inc, dec. */
+    chf_metrics_inst_global_set(CHF_METR_GAUGE_SESSIONS_ACTIVE, 7);
+    chf_metrics_inst_global_add(CHF_METR_CTR_CDR_BYTES, 1234);
+    chf_metrics_inst_global_inc(CHF_METR_CTR_NOTIFY_SENT);
+    chf_metrics_inst_global_dec(CHF_METR_GAUGE_SESSIONS_ACTIVE);
+
+    /* Labeled, including the metrics added for slicing and the two CDR
+     * encodings. */
+    chf_metrics_inst_labeled_inc(CHF_METR_LBL_CDR_WRITTEN,
+            "success", NULL, NULL);
+    chf_metrics_inst_labeled_inc(CHF_METR_LBL_CDR_ENCODED,
+            "asn1", "success", NULL);
+    chf_metrics_inst_labeled_inc(CHF_METR_LBL_CDR_FILE_ROLLED,
+            "json", "records", NULL);
+    chf_metrics_inst_labeled_inc(CHF_METR_LBL_BUCKET_SELECTED,
+            "scoped", "1/000001", NULL);
+
+    /* Reaching here without a crash is the assertion. */
+    ABTS_TRUE(tc, true);
+}
+
+/* ------------------------------------------------------------------ */
+/* METR-4: an over-long label value is tolerated on this path          */
+/*                                                                      */
+/* dnn and smf label values come off the wire, so an over-long one is   */
+/* reachable from a peer rather than only from our own code.            */
+/*                                                                      */
+/* What this proves is narrow, and worth stating: without a metrics     */
+/* context chf_metrics_inst_labeled_add() returns before it copies      */
+/* anything, so this shows the uninitialised path is safe for any       */
+/* input, not that truncation works.  Truncation is by construction —   */
+/* the copy is an ogs_cpystrn() bounded by CHF_METR_LABEL_LEN — and     */
+/* exercising it needs a live metrics context, which is the rig's job.  */
+/* ------------------------------------------------------------------ */
+static void test_metrics_overlong_label(abts_case *tc, void *data)
+{
+    char huge[CHF_METR_LABEL_LEN * 3];
+
+    memset(huge, 'x', sizeof(huge) - 1);
+    huge[sizeof(huge) - 1] = '\0';
+
+    chf_metrics_inst_labeled_inc(CHF_METR_LBL_BUCKET_SELECTED,
+            "scoped", huge, NULL);
+    chf_metrics_inst_labeled_inc(CHF_METR_LBL_SESSION_CREATE,
+            "success", huge, huge);
+
+    ABTS_TRUE(tc, true);
+}
+
+abts_suite *test_chf_metrics(abts_suite *suite)
+{
+    suite = ADD_SUITE(suite)
+
+    abts_run_test(suite, test_metrics_specs_complete,      NULL);
+    abts_run_test(suite, test_metrics_enum_bounds,         NULL);
+    abts_run_test(suite, test_metrics_noop_without_context, NULL);
+    abts_run_test(suite, test_metrics_overlong_label,      NULL);
+
+    return suite;
+}
diff --git a/tests/chf/chf-quota-test.c b/tests/chf/chf-quota-test.c
new file mode 100644
index 000000000..f7a9c7727
--- /dev/null
+++ b/tests/chf/chf-quota-test.c
@@ -0,0 +1,924 @@
+/*
+ * Copyright (C) 2026 by Rami Mohamed <ramrode@gmail.com>
+ *
+ * This file is part of Open5GS.
+ *
+ * This program is free software: you can redistribute it and/or modify
+ * it under the terms of the GNU Affero General Public License as published by
+ * the Free Software Foundation, either version 3 of the License, or
+ * (at your option) any later version.
+ *
+ * This program is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * along with this program.  If not, see <https://www.gnu.org/licenses/>.
+ */
+
+/*
+ * CHF quota engine unit tests (Phase 1d).
+ *
+ * These tests verify:
+ *   1. Default quota context values match TS 32.291 §6.3.1.2 expectations
+ *   2. Session quota allocation splits UL/DL correctly (50/50)
+ *   3. Remaining-volume arithmetic is correct (totalVolume on Update/Create)
+ *   4. Quota-exhaustion flag is set at the right boundary
+ *   5. Multiple independent sessions do not share quota state
+ *   6. Zero-volume quota triggers immediate exhaustion (0 >= 0)
+ *   7. FinalUnitAction enum values: TERMINATE=0, REDIRECT=1, RESTRICT_ACCESS=2
+ *   8. Odd-byte quota split uses floor division (1 byte may be unaccounted)
+ *   9. Zero-volume quota remains exhausted even with non-zero actual usage
+ *
+ * All tests run against libchf without a MongoDB or NRF connection.
+ * chf_context_init() is called in abts-main.c before suites run.
+ */
+
+#include "ogs-sbi.h"
+#include "chf/context.h"
+#include "core/abts.h"
+
+/* ------------------------------------------------------------------ */
+/* Test 1: Default quota values after context init                     */
+/* TS 32.291 §6.3.1.2 — GrantedUnit; TS 32.290 §5.2 — defaults       */
+/* ------------------------------------------------------------------ */
+static void test_default_quota_values(abts_case *tc, void *data)
+{
+    chf_context_t *ctx = chf_self();
+    ABTS_PTR_NOTNULL(tc, ctx);
+
+    /* 10 GiB = 10 * 1024^3 bytes — configured in chf.yaml.in.
+     * Compare as uint64 to avoid int overflow on 32-bit. */
+    ABTS_INT_EQUAL(tc, 1,
+        ctx->default_quota.volume_bytes == (uint64_t)10 * 1024 * 1024 * 1024
+        ? 1 : 0);
+
+    /* 24 hours validity per TS 32.290 §6.1.4 */
+    ABTS_INT_EQUAL(tc, 86400, (int)ctx->default_quota.validity_seconds);
+
+    /* TERMINATE = 0 per OpenAPI_final_unit_action_e */
+    ABTS_INT_EQUAL(tc, 0, ctx->default_quota.final_unit_action);
+}
+
+/* ------------------------------------------------------------------ */
+/* Test 2: Session quota split (UL + DL == volume_bytes)              */
+/* For even volumes UL == DL == total/2; DL gets the odd byte for odd */
+/* volumes so UL+DL always equals volume_bytes exactly.               */
+/* Direct chf_apply_quota() tests: see QU-15 (context.c).             */
+/* ------------------------------------------------------------------ */
+static void test_quota_split(abts_case *tc, void *data)
+{
+    chf_sess_t *sess;
+    chf_quota_t quota;
+    uint64_t half;
+
+    sess = chf_sess_add("imsi-999700000000001", "test-uuid-quota-split-001");
+    ABTS_PTR_NOTNULL(tc, sess);
+
+    quota.volume_bytes      = 100000000ULL; /* 100 MB */
+    quota.validity_seconds  = 3600;
+    quota.auto_renew        = false;
+    quota.final_unit_action = 0;
+
+    half = quota.volume_bytes / 2;
+    sess->granted_quota_total = quota.volume_bytes;
+    sess->granted_time_sec  = quota.validity_seconds;
+    sess->final_unit_action = quota.final_unit_action;
+    sess->final_unit        = false;
+
+    ABTS_INT_EQUAL(tc, (int)quota.volume_bytes,
+                   (int)sess->granted_quota_total);
+    ABTS_INT_EQUAL(tc, (int)(2 * half), (int)quota.volume_bytes);
+    ABTS_INT_EQUAL(tc, 0, sess->final_unit_action);
+
+    chf_sess_remove(sess);
+}
+
+/* ------------------------------------------------------------------ */
+/* Test 3: Remaining volume decreases correctly as usage accumulates   */
+/* Mirrors build_charging_data_response() logic in nchf-handler.c     */
+/* ------------------------------------------------------------------ */
+static void test_remaining_volume(abts_case *tc, void *data)
+{
+    chf_sess_t *sess;
+    uint64_t total_granted, total_used, remaining;
+
+    sess = chf_sess_add("imsi-999700000000002", "test-uuid-remaining-001");
+    ABTS_PTR_NOTNULL(tc, sess);
+
+    /* Grant 10 MB total (5 MB UL + 5 MB DL) */
+    sess->granted_quota_total = 2 * (5 * 1024 * 1024);
+    sess->ul_octets        = 0;
+    sess->dl_octets        = 0;
+    sess->final_unit       = false;
+
+    /* After Create: no usage yet, full quota available */
+    total_granted = sess->granted_quota_total;
+    total_used    = sess->ul_octets + sess->dl_octets;
+    remaining = (total_used >= total_granted) ? 0ULL : total_granted - total_used;
+    ABTS_INT_EQUAL(tc, (int)(10 * 1024 * 1024), (int)remaining);
+
+    /* Simulate first Update: 2 MB used */
+    sess->ul_octets += 1 * 1024 * 1024;
+    sess->dl_octets += 1 * 1024 * 1024;
+    total_used  = sess->ul_octets + sess->dl_octets;
+    remaining   = (total_used >= total_granted) ? 0ULL : total_granted - total_used;
+    ABTS_INT_EQUAL(tc, (int)(8 * 1024 * 1024), (int)remaining);
+
+    /* Simulate second Update: 6 more MB used (8 MB total — still within quota) */
+    sess->ul_octets += 3 * 1024 * 1024;
+    sess->dl_octets += 3 * 1024 * 1024;
+    total_used  = sess->ul_octets + sess->dl_octets;
+    remaining   = (total_used >= total_granted) ? 0ULL : total_granted - total_used;
+    ABTS_INT_EQUAL(tc, (int)(2 * 1024 * 1024), (int)remaining);
+
+    chf_sess_remove(sess);
+}
+
+/* ------------------------------------------------------------------ */
+/* Test 4: Quota exhaustion — flag triggered exactly at boundary       */
+/* TS 32.291 §6.3.2.2 — FinalUnitIndication raised on exhaustion      */
+/* ------------------------------------------------------------------ */
+static void test_quota_exhaustion_boundary(abts_case *tc, void *data)
+{
+    chf_sess_t *sess;
+    uint64_t total_granted, total_used;
+    bool exhausted;
+
+    sess = chf_sess_add("imsi-999700000000003", "test-uuid-exhaust-001");
+    ABTS_PTR_NOTNULL(tc, sess);
+
+    sess->granted_quota_total = 2 * (5 * 1024 * 1024);
+    sess->ul_octets = 0;
+    sess->dl_octets = 0;
+    sess->final_unit = false;
+    total_granted = sess->granted_quota_total;
+
+    /* One byte short of exhaustion — NOT exhausted */
+    sess->ul_octets = total_granted - 1;
+    sess->dl_octets = 0;
+    total_used = sess->ul_octets + sess->dl_octets;
+    exhausted  = (total_used >= total_granted);
+    ABTS_INT_EQUAL(tc, 0 /* false */, (int)exhausted);
+
+    /* Exactly at boundary — exhausted */
+    sess->ul_octets = total_granted;
+    sess->dl_octets = 0;
+    total_used = sess->ul_octets + sess->dl_octets;
+    exhausted  = (total_used >= total_granted);
+    ABTS_INT_EQUAL(tc, 1 /* true */, (int)exhausted);
+
+    /* Over boundary — clamped to 0 remaining */
+    sess->ul_octets = total_granted + 1024 * 1024;
+    total_used = sess->ul_octets + sess->dl_octets;
+    exhausted  = (total_used >= total_granted);
+    ABTS_INT_EQUAL(tc, 1 /* true */, (int)exhausted);
+    uint64_t remaining = (total_used >= total_granted) ? 0ULL
+                         : total_granted - total_used;
+    ABTS_INT_EQUAL(tc, 0, (int)remaining);
+
+    chf_sess_remove(sess);
+}
+
+/* ------------------------------------------------------------------ */
+/* Test 5: Multiple independent sessions do not share quota state      */
+/* ------------------------------------------------------------------ */
+static void test_sessions_are_independent(abts_case *tc, void *data)
+{
+    chf_sess_t *sess1, *sess2;
+
+    sess1 = chf_sess_add("imsi-999700000000010", "test-uuid-indep-sess1");
+    ABTS_PTR_NOTNULL(tc, sess1);
+    sess1->granted_quota_total = 2 * (1024 * 1024);
+    sess1->ul_octets = 500 * 1024;
+    sess1->dl_octets = 100 * 1024;
+
+    sess2 = chf_sess_add("imsi-999700000000011", "test-uuid-indep-sess2");
+    ABTS_PTR_NOTNULL(tc, sess2);
+    sess2->granted_quota_total = 2 * (50 * 1024 * 1024);
+    sess2->ul_octets = 0;
+    sess2->dl_octets = 0;
+
+    /* sess1 is partially used */
+    ABTS_INT_EQUAL(tc, (int)(600 * 1024),
+            (int)(sess1->ul_octets + sess1->dl_octets));
+
+    /* sess2 is untouched */
+    ABTS_INT_EQUAL(tc, 0,
+            (int)(sess2->ul_octets + sess2->dl_octets));
+
+    /* Lookup by ref works for both */
+    ABTS_PTR_NOTNULL(tc,
+        chf_sess_find_by_charging_data_ref("test-uuid-indep-sess1"));
+    ABTS_PTR_NOTNULL(tc,
+        chf_sess_find_by_charging_data_ref("test-uuid-indep-sess2"));
+
+    chf_sess_remove(sess1);
+    chf_sess_remove(sess2);
+
+    /* After removal, lookups return NULL */
+    ABTS_PTR_EQUAL(tc, NULL,
+        chf_sess_find_by_charging_data_ref("test-uuid-indep-sess1"));
+    ABTS_PTR_EQUAL(tc, NULL,
