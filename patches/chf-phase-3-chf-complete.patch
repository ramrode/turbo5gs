@@ -0,0 +1,124 @@
+# Copyright (C) 2026 by Rami Mohamed <ramrode@gmail.com>
+
+# This file is part of Open5GS.
+
+# This program is free software: you can redistribute it and/or modify
+# it under the terms of the GNU Affero General Public License as published by
+# the Free Software Foundation, either version 3 of the License, or
+# (at your option) any later version.
+#
+# This program is distributed in the hope that it will be useful,
+# but WITHOUT ANY WARRANTY; without even the implied warranty of
+# MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+# GNU General Public License for more details.
+#
+# You should have received a copy of the GNU General Public License
+# along with this program.  If not, see <https://www.gnu.org/licenses/>.
+
+# ---------------------------------------------------------------------------
+# CHF unit tests
+#
+# They run without a NRF, a MongoDB or a live CHF: everything here is
+# either arithmetic or a file the test writes itself.  What they cover:
+#
+#   chf-quota-test.c    — quota math: the cycle counter, exhaustion
+#                          boundaries, session independence, and the
+#                          cross-session aggregate (TS 32.291 §5.2)
+#   chf-cdr-test.c      — the CDR writer: path layout, JSON fields, the
+#                          slice, cause strings, the disabled-flag guard,
+#                          which sessions are worth a record at all, the
+#                          json/asn1/both switch, and aggregated filing
+#                          with its record and size thresholds
+#   chf-cdr-asn1-test.c — the TS 32.298 record itself: which fields a
+#                          session becomes, the [200] tag the encoding
+#                          opens with, a BER round-trip through the same
+#                          codec a mediation system would use, volumes
+#                          past 2^32, all three closing causes, the
+#                          SliceDifferentiator octets and the BCD TimeStamp
+#   chf-metrics-test.c  — the metric spec tables: that every enum entry
+#                          has a complete spec, and that instrumenting
+#                          before the metrics context exists is a no-op,
+#                          which every other suite here relies on
+#   chf-sbi-test.c      — ogs_sbi_check_chf_info_supi_range(): which CHF
+#                          instance serves a SUPI (TS 29.510 §6.1.6.2.9)
+#   chf-grant-test.c    — grant shaping from chf.yaml charging.grant: the
+#                          slice size, the validityTime cap and the
+#                          volumeQuotaThreshold floor, and what an
+#                          allowance costs in Updates
+#   chf-bucket-test.c   — which allowance a session is charged to: scope
+#                          matching over slice, DNN, home PLMN and roaming,
+#                          and selection by priority
+#
+# All seven register into one binary, so a failure names the test that
+# failed rather than the file.
+#
+# Run:
+#   meson test -C build --suite chf -v
+#   build/tests/chf/chf-unit           # direct invocation
+# ---------------------------------------------------------------------------
+
+testchf_sources = files('''
+    abts-main.c
+    chf-quota-test.c
+    chf-cdr-test.c
+    chf-cdr-asn1-test.c
+    chf-metrics-test.c
+    chf-sbi-test.c
+    chf-grant-test.c
+    chf-bucket-test.c
+'''.split())
+
+testchf_exe = executable('chf-unit',
+    sources : testchf_sources,
+    c_args : testunit_core_cc_flags,
+    include_directories : srcinc,
+    dependencies : libchf_dep,
+    install : false)
+
+test('chf-unit',
+    testchf_exe,
+    is_parallel : false,
+    suite : 'chf')
+
+# ---------------------------------------------------------------------------
+# JSON mirrors BER
+#
+# The C tests can only compare the CDR writer against itself.  This one
+# compares its two encodings through something that shares no code with
+# either: chf-cdr-emit writes both for the same sessions, and
+# open5gs-chf-cdr-decode - generated from the TS 32.298 ASN.1 module,
+# not from the CHF's C - decodes the BER back.  The two JSON documents
+# then have to be equal, which is what makes "the JSON mirrors the
+# ASN.1" a fact rather than an intention.
+#
+# It needs only python3, which the build already requires.
+#
+# `depends` needs meson >= 0.46, which like the install_mode on the decoder
+# target is above the 0.43 the project still declares; meson warns and
+# proceeds.  See the comment on that target in src/chf/meson.build.
+# ---------------------------------------------------------------------------
+testchf_emit_exe = executable('chf-cdr-emit',
+    sources : files('chf-cdr-emit.c'),
+    c_args : testunit_core_cc_flags,
+    include_directories : srcinc,
+    dependencies : libchf_dep,
+    install : false)
+
+test('chf-cdr-decode',
+    find_program('test-cdr-decode.sh'),
+    args : [testchf_emit_exe, chf_cdr_decode_tgt, python3_exe],
+    depends : [testchf_emit_exe, chf_cdr_decode_tgt],
+    is_parallel : false,
+    suite : 'chf')
+
+# ---------------------------------------------------------------------------
+# CHF API test over the wire
+#
+# tests/chf/test-chf-api.sh drives a running CHF with curl over cleartext
+# HTTP/2, in the request shape of TS 32.291.  It needs open5gs-chfd and
+# MongoDB up, so it is deliberately NOT registered as a meson test: a
+# plain `meson test` on a build machine has neither.
+#
+# Run manually against a running CHF:
+#   CHF_PORT=7777 tests/chf/test-chf-api.sh
+# ---------------------------------------------------------------------------
diff --git a/tests/chf/test-cdr-decode.sh b/tests/chf/test-cdr-decode.sh
new file mode 100755
index 000000000..4dc739977
--- /dev/null
+++ b/tests/chf/test-cdr-decode.sh
@@ -0,0 +1,131 @@
+#!/bin/sh
+#
+# Copyright (C) 2026 by Rami Mohamed <ramrode@gmail.com>
+#
+# This file is part of Open5GS.
+#
+# This program is free software: you can redistribute it and/or modify
+# it under the terms of the GNU Affero General Public License as published by
+# the Free Software Foundation, either version 3 of the License, or
+# (at your option) any later version.
+#
+# This program is distributed in the hope that it will be useful,
+# but WITHOUT ANY WARRANTY; without even the implied warranty of
+# MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+# GNU General Public License for more details.
+#
+# You should have received a copy of the GNU General Public License
+# along with this program.  If not, see <https://www.gnu.org/licenses/>.
+#
+# The JSON CDR mirrors the BER CDR: same record, same field names.
+#
+# This is the test that can actually say so, because it compares the two
+# through something that shares no code with either.  chf-cdr-emit writes
+# both encodings of the same sessions; open5gs-chf-cdr-decode, generated
+# from the TS 32.298 module rather than from the CHF's C, decodes the
+# .ber; and the two JSON documents must then be equal.
+#
+# Usage (meson passes all three):
+#   test-cdr-decode.sh <chf-cdr-emit> <open5gs-chf-cdr-decode> <python3>
+
+set -e
+
+EMIT=${1:?emitter binary required}
+DECODE=${2:?decoder script required}
+PYTHON=${3:-python3}
+
+WORK=$(mktemp -d 2>/dev/null || mktemp -d -t chf-cdr)
+trap 'rm -rf "$WORK"' EXIT
+
+echo "# emitting CDRs into $WORK"
+"$EMIT" "$WORK" > "$WORK/paths.txt"
+
+json_count=0
+fail=0
+
+while read -r kind path; do
+    [ "$kind" = "json" ] || continue
+    json_count=$((json_count + 1))
+
+    ber=$(echo "$path" | sed 's/\.json$/.ber/')
+
+    if [ ! -f "$path" ]; then
+        echo "FAIL: missing JSON CDR $path"
+        fail=1
+        continue
+    fi
+    if [ ! -f "$ber" ]; then
+        echo "FAIL: missing BER CDR $ber"
+        fail=1
+        continue
+    fi
+
+    # Decode the BER and compare the two as parsed documents, so key
+    # order and int-vs-float do not count as differences.
+    if "$PYTHON" - "$path" "$ber" "$DECODE" "$PYTHON" <<'PYEOF'
+import json
+import subprocess
+import sys
+
+json_path, ber_path, decode, python = sys.argv[1:5]
+
+with open(json_path) as f:
+    from_json = json.loads(f.read().strip())
+
+out = subprocess.run([python, decode, ber_path],
+                     capture_output=True, text=True)
+if out.returncode != 0:
+    sys.stderr.write("decoder failed: %s\n" % out.stderr)
+    sys.exit(1)
+
+lines = [ln for ln in out.stdout.strip().split("\n") if ln]
+if len(lines) != 1:
+    sys.stderr.write("expected 1 decoded record, got %d\n" % len(lines))
+    sys.exit(1)
+
+from_ber = json.loads(lines[0])
+
+if from_json != from_ber:
+    sys.stderr.write("JSON and BER renderings differ\n")
+    a = json.dumps(from_json, indent=2, sort_keys=True).split("\n")
+    b = json.dumps(from_ber, indent=2, sort_keys=True).split("\n")
+    import difflib
+    for d in difflib.unified_diff(a, b, "from .json", "from .ber",
+                                  lineterm=""):
+        sys.stderr.write(d + "\n")
+    sys.exit(1)
+PYEOF
+    then
+        echo "ok: $(basename "$path") matches $(basename "$ber")"
+    else
+        echo "FAIL: $(basename "$path") does not match $(basename "$ber")"
+        fail=1
+    fi
+done < "$WORK/paths.txt"
+
+if [ "$json_count" -eq 0 ]; then
+    echo "FAIL: the emitter wrote no CDRs"
+    exit 1
+fi
+
+# An aggregated BER file holds many records back to back; the decoder has
+# to read every one of them, since that is what makes aggregation usable.
+cat_all=$WORK/all.ber
+: > "$cat_all"
+while read -r kind path; do
+    [ "$kind" = "ber" ] && cat "$path" >> "$cat_all"
+done < "$WORK/paths.txt"
+
+got=$("$PYTHON" "$DECODE" --count "$cat_all" | sed 's/.*: //')
+if [ "$got" != "$json_count" ]; then
+    echo "FAIL: concatenated BER holds $got records, expected $json_count"
+    fail=1
+else
+    echo "ok: $json_count concatenated BER records all decode"
+fi
+
+if [ "$fail" -ne 0 ]; then
+    exit 1
+fi
+
+echo "PASS: $json_count CDRs, JSON and BER agree"
diff --git a/tests/chf/test-chf-api.sh b/tests/chf/test-chf-api.sh
new file mode 100755
index 000000000..08e50db6f
--- /dev/null
+++ b/tests/chf/test-chf-api.sh
@@ -0,0 +1,1999 @@
+#!/usr/bin/env bash
+# Copyright (C) 2026 by Rami Mohamed <ramrode@gmail.com>
+#
+# =============================================================================
+# CHF Nchf_ConvergedCharging API validation script — Progressive, Cumulative
+# =============================================================================
+#
+# USAGE:
+#   ./tests/chf/test-chf-api.sh
+#
+# ENVIRONMENT VARIABLES (all optional, with defaults):
+#   CHF_ADDR   (default 127.0.0.16)  CHF_PORT   (default 7777)
+#   NRF_ADDR   (default 127.0.0.10)  NRF_PORT   (default 7777)
+#   SMF_ADDR   (default 127.0.0.4)   SMF_PORT   (default 7777)
+#   WEBUI_ADDR (default 127.0.0.1)   WEBUI_PORT (default 9999)
+#   CDR_BASE   (default /tmp/test-cdr)
+#   SKIP_MONGO (default 0)
+#
+# PHASES IN THIS SCRIPT:
+#   Phase 1 — CHF standalone NF             TC-1..TC-12, TC-10b..TC-10h, TC-13a..TC-13b, TC-ERR-1..TC-ERR-2  (requires: CHF + MongoDB)
+#   Phase 2 — lib/sbi CHF NF info           TC-P2-1..P2-4  (requires: NRF)
+#   Phase 3 — SMF CHF/Gy selector           TC-P3-1..P3-3  (requires: SMF + NRF)
+#   Phase 4 — SMF Nchf client               TC-P4-1..P4-3  (requires: CHF)
+#   Phase 5 — SMF full wiring               TC-P5-1..P5-2  (requires: CHF; SMF optional)
+#   Phase 6 — WebUI quota management        TC-P6-1..P6-4  (requires: WebUI)
+#
+# EXIT CODES:
+#   0 — all executed tests passed (FAIL=0); SKIP is not a failure
+#   1 — one or more tests failed
+#
+# DESIGN:
+#   Cumulative: each phase adds its tests on top of the previous phases.
+#   Self-guarding: each phase detects its required services; SKIPs if not reachable.
+#   Counters: PASS, FAIL, SKIP tracked; only FAIL causes non-zero exit.
+#
+# =============================================================================
+
+# -u  : error on unset variables
+# -o pipefail : pipe fails if any stage fails
+# NOTE: -e (exit on error) is intentionally NOT set — test scripts must
+#       continue after individual assertion failures so the full result
+#       summary is always printed.
+set -uo pipefail
+
+# ---------------------------------------------------------------------------
+# Service address configuration (from environment or defaults)
+# ---------------------------------------------------------------------------
+CHF_ADDR="${CHF_ADDR:-127.0.0.16}"
+CHF_PORT="${CHF_PORT:-7777}"
+NRF_ADDR="${NRF_ADDR:-127.0.0.10}"
+NRF_PORT="${NRF_PORT:-7777}"
+SMF_ADDR="${SMF_ADDR:-127.0.0.4}"
+SMF_PORT="${SMF_PORT:-7777}"
+WEBUI_ADDR="${WEBUI_ADDR:-127.0.0.1}"
+WEBUI_PORT="${WEBUI_PORT:-9999}"
+CDR_BASE="${CDR_BASE:-/tmp/test-cdr}"
+SKIP_MONGO="${SKIP_MONGO:-0}"
+
+BASE_URL="http://${CHF_ADDR}:${CHF_PORT}/nchf-convergedcharging/v3/chargingdata"
+
+# ---------------------------------------------------------------------------
+# Counters
+# ---------------------------------------------------------------------------
+PASS=0
+FAIL=0
+SKIP=0
+
+# ---------------------------------------------------------------------------
+# Colors
+# ---------------------------------------------------------------------------
+GREEN='\033[0;32m'
+RED='\033[0;31m'
+YELLOW='\033[1;33m'
+NC='\033[0m'
+
+# ---------------------------------------------------------------------------
+# Helper functions
+# ---------------------------------------------------------------------------
+pass() { echo -e "${GREEN}PASS${NC} $1"; PASS=$((PASS+1)); }
+fail() { echo -e "${RED}FAIL${NC} $1"; FAIL=$((FAIL+1)); }
+skip() { echo -e "${YELLOW}SKIP${NC} $1"; SKIP=$((SKIP+1)); }
+info() { echo -e "${YELLOW}INFO${NC} $1"; }
+
+# service_reachable() — returns 0 (true) if the TCP port is open,
+# 1 (false) if connection is refused/timed out.
+#
+# IMPORTANT: use the no-op `:` (not `echo`) to open the /dev/tcp socket.
+# `echo` writes a trailing newline (\n) before the connection closes.
+# Open5GS SBI NFs run an HTTP/2 (nghttp2) server: the first bytes received
+# must be the HTTP/2 client preface "PRI * HTTP/2.0\r\n\r\nSM\r\n\r\n".
+# Sending `\n` instead causes nghttp2 to log:
+#   nghttp2_session_mem_recv() failed (-903: Received bad client magic byte string)
+# which fills NF logs with misleading errors on every service probe.
+# Using `:` opens the TCP connection and immediately closes it (FIN) with
+# zero bytes sent — nghttp2 never invokes mem_recv(), so no error is logged.
+service_reachable() {
+    local addr="$1" port="$2"
+    (: >/dev/tcp/${addr}/${port}) 2>/dev/null
+}
+
+service_reachable_http1() {
+    local addr="$1" port="$2"
+    (: >/dev/tcp/${addr}/${port}) 2>/dev/null
+}
+
+# chf_post() — HTTP POST with HTTP/2; writes response headers to
+# /tmp/chf-resp-headers.txt and body to /tmp/chf-resp-body.txt.
+# Always exits 0; prints 3-digit status code or "000" on failure.
+chf_post() {
+    local url="$1"
+    local body="$2"
+    : > /tmp/chf-resp-headers.txt
+    : > /tmp/chf-resp-body.txt
+    local code
+    code=$(curl -s --max-time 10 --http2-prior-knowledge \
+        -D /tmp/chf-resp-headers.txt \
+        -X POST "${url}" \
+        -H "Content-Type: application/json" \
+        -o /tmp/chf-resp-body.txt \
+        -w "%{http_code}" \
+        -d "${body}" 2>/tmp/chf-curl-err.txt) || code="000"
+    echo "${code}"
+}
+
+# check_python() — run a Python3 snippet; pass/fail based on exit code.
+check_python() {
+    local snippet="$1"
+    local label="$2"
+    if python3 -c "${snippet}" 2>&1; then
+        pass "${label}"
+    else
+        fail "${label}"
+    fi
+}
+
+# mongo_find() — query MongoDB (returns "{}" if SKIP_MONGO=1 or mongosh absent)
+mongo_find() {
+    local collection="$1"; local query="$2"
+    if [ "${SKIP_MONGO}" = "1" ]; then echo "{}"; return; fi
+    mongosh --quiet open5gs --eval \
+        "EJSON.stringify(db['${collection}'].findOne(${query}))" 2>/dev/null \
+        || echo "{}"
+}
