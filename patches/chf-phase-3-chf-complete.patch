+    uint64_t agg_with_usage = chf_supi_aggregate_used(supi);
+    ABTS_INT_EQUAL(tc, (int)(150 * 1024 * 1024), (int)agg_with_usage);
+
+    chf_sess_remove(sessExisting);
+    chf_sess_remove(sessNew);
+}
