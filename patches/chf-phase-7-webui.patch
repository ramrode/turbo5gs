@@ -0,0 +1,36 @@
+/*
+ * Redux CRUD action creators for CHF subscriber quota profiles.
+ *
+ * Mirrors the pattern in modules/crud/subscriber.js.
+ * express-restify-mongoose v6 uses model.modelName as the route name (no
+ * pluralisation), so ChfSubscriber is mounted at /db/ChfSubscriber (not
+ * /db/ChfSubscribers).  The URL constant below reflects this.
+ *
+ * 3GPP: TS 23.255 §5.2 — CHF subscriber management
+ */
+
+import {
+  fetchCollection,
+  fetchDocument,
+  createDocument,
+  updateDocument,
+  deleteDocument
+} from './actions';
+
+export const MODEL = 'chfsubscribers';
+export const URL   = '/ChfSubscriber';
+
+export const fetchChfSubscribers = (params = {}) =>
+  fetchCollection(MODEL, URL, params, { idProperty: 'bucketId' });
+
+export const fetchChfSubscriber = (id, params = {}) =>
+  fetchDocument(MODEL, id, `${URL}/${id}`, params, { idProperty: 'bucketId' });
+
+export const createChfSubscriber = (params = {}, data = {}) =>
+  createDocument(MODEL, URL, params, data, { idProperty: 'bucketId' });
+
+export const updateChfSubscriber = (id, params = {}, data = {}) =>
+  updateDocument(MODEL, id, `${URL}/${id}`, params, data, { idProperty: 'bucketId' });
+
+export const deleteChfSubscriber = (id, params = {}) =>
+  deleteDocument(MODEL, id, `${URL}/${id}`, params, { idProperty: 'bucketId' });
diff --git a/webui/tests/chf-guards.test.js b/webui/tests/chf-guards.test.js
new file mode 100644
index 000000000..f1228bd19
--- /dev/null
+++ b/webui/tests/chf-guards.test.js
@@ -0,0 +1,54 @@
+/*
+ * Server-side guard: API clients must not be able to write usage.*, the
+ * CHF-owned billing-cycle counter.
+ */
+'use strict';
+
+const { chfSubscriberProtectUsage } = require('../server/chf-guards');
+
+function run(body, method = 'PATCH') {
+  const req = { method, body };
+  let nextCalled = false;
+  chfSubscriberProtectUsage(req, {}, () => { nextCalled = true; });
+  return { body: req.body, nextCalled };
+}
+
+describe('chfSubscriberProtectUsage', () => {
+  test('1. strips a usage object', () => {
+    const { body, nextCalled } = run({
+      quota: { totalQuotaBytes: 5 },
+      usage: { consumedBytes: 0 },
+    });
+    expect(body).not.toHaveProperty('usage');
+    expect(body.quota.totalQuotaBytes).toBe(5);
+    expect(nextCalled).toBe(true);
+  });
+
+  test('2. strips dotted paths that would target the nested field', () => {
+    /* Mongoose document.set() applies these straight to usage.* */
+    const { body } = run({
+      'usage.consumedBytes': 0,
+      'usage.periodStart': '2020-01-01',
+      'quota.autoRenew': false,
+    });
+    expect(body).not.toHaveProperty(['usage.consumedBytes']);
+    expect(body).not.toHaveProperty(['usage.periodStart']);
+    expect(body['quota.autoRenew']).toBe(false);
+  });
+
+  test('3. does not strip keys that merely start with "usage"', () => {
+    const { body } = run({ usageNote: 'keep me' });
+    expect(body.usageNote).toBe('keep me');
+  });
+
+  test('4. applies to create (POST) as well as update', () => {
+    const { body } = run({ supi: 'imsi-1', usage: { consumedBytes: 9 } }, 'POST');
+    expect(body).not.toHaveProperty('usage');
+    expect(body.supi).toBe('imsi-1');
+  });
+
+  test('5. reads with no body are a no-op and still continue', () => {
+    expect(run(undefined, 'GET').nextCalled).toBe(true);
+    expect(run(null, 'GET').nextCalled).toBe(true);
+  });
+});
diff --git a/webui/tests/chf-query.test.js b/webui/tests/chf-query.test.js
new file mode 100644
index 000000000..359133a2d
--- /dev/null
+++ b/webui/tests/chf-query.test.js
@@ -0,0 +1,191 @@
+/*
+ * Unit tests for webui/src/helpers/chf-query.js
+ *
+ * Covers the pagination/search query construction and X-Total-Count parsing
+ * used to keep the CHF subscriber and session views bounded at scale.
+ *
+ * escapeRegex():
+ *   1.  plain digits unchanged
+ *   2.  regex metacharacters neutralised
+ *   3.  null/undefined → empty string
+ *
+ * buildSubscriberParams():
+ *   4.  page 0 → skip 0, limit=pageSize, sort=supi, no query
+ *   5.  page 2, size 25 → skip 50
+ *   6.  search adds a prefix-anchored, escaped $regex query
+ *   7.  whitespace-only search is ignored
+ *   8.  malicious regex input is escaped (no raw metacharacters)
+ *
+ * buildSessionParams():
+ *   9.  sorts by -startTime (newest first)
+ *  10.  search adds SUPI $regex query
+ *
+ * totalFromOtherInfo():
+ *  11.  reads x-total-count header
+ *  12.  missing header → undefined
+ *  13.  non-numeric header → undefined
+ *  14.  null otherInfo → undefined
+ *  15.  "0" → 0
+ */
+
+'use strict';
+
+const {
+  escapeRegex,
