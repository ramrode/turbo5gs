diff --git a/webui/server/metrics.js b/webui/server/metrics.js
new file mode 100644
index 000000000..39fc565af
--- /dev/null
+++ b/webui/server/metrics.js
@@ -0,0 +1,96 @@
+/*
+ * WebUI-plane Prometheus metrics for CHF provisioning.
+ *
+ * Subscriber CRUD happens in this Node server (not in the C CHF NF), so
+ * provisioning-rate observability must be emitted here.  This exposes
+ *
+ *   chf_provisioning_ops_total{op="create|update|delete",result="success|error"}
+ *
+ * plus the default process metrics, at GET /metrics (unauthenticated, for a
+ * Prometheus scrape).
+ *
+ * prom-client is an OPTIONAL dependency: it is loaded lazily and, if it is not
+ * installed, every function here degrades to a no-op and /metrics returns a
+ * short hint.  This keeps the WebUI running with or without it; to enable the
+ * metrics simply `npm install prom-client` in webui/.
+ *
+ * Copyright (C) 2026 by Rami Mohamed <ramrode@gmail.com>
+ */
+
+'use strict';
+
+let client = null;
+let registry = null;
+let provisioningOps = null;
+
+try {
+  // eslint-disable-next-line global-require
+  client = require('prom-client');
+} catch (e) {
+  client = null;
+}
+
+if (client) {
+  registry = new client.Registry();
+  client.collectDefaultMetrics({ register: registry, prefix: 'chf_webui_' });
+
+  provisioningOps = new client.Counter({
+    name: 'chf_provisioning_ops_total',
+    help: 'CHF subscriber provisioning operations via the WebUI',
+    labelNames: ['op', 'result'],
+    registers: [registry],
+  });
+}
+
+/* Map an HTTP method to a provisioning op name; null for reads/other. */
+function opFromMethod(method) {
+  switch ((method || '').toUpperCase()) {
+    case 'POST': return 'create';
+    case 'PUT':
+    case 'PATCH': return 'update';
+    case 'DELETE': return 'delete';
+    default: return null;
+  }
+}
+
+/*
+ * express-restify-mongoose postProcess hook for the ChfSubscriber resource.
+ * Counts create/update/delete by outcome, then continues the chain.
+ */
+function subscriberPostProcess(req, res, next) {
+  try {
+    if (provisioningOps) {
+      const op = opFromMethod(req.method);
+      if (op) {
+        const ok = res.statusCode >= 200 && res.statusCode < 400;
+        provisioningOps.inc({ op, result: ok ? 'success' : 'error' });
+      }
+    }
+  } catch (e) {
+    /* never let metrics break the request */
+  }
+  if (typeof next === 'function') next();
+}
+
+/* GET /metrics handler (Prometheus text exposition). */
+async function handler(req, res) {
+  if (!registry) {
+    res.set('Content-Type', 'text/plain');
+    return res.status(200).send(
+      '# prom-client not installed; run `npm install prom-client` in webui/ ' +
+      'to enable CHF WebUI provisioning metrics.\n'
+    );
+  }
+  try {
+    res.set('Content-Type', registry.contentType);
+    return res.status(200).send(await registry.metrics());
+  } catch (e) {
+    return res.status(500).send(String(e));
+  }
+}
+
+module.exports = {
+  enabled: !!client,
+  subscriberPostProcess,
+  handler,
+};
diff --git a/webui/server/models/chf-notification.js b/webui/server/models/chf-notification.js
new file mode 100644
index 000000000..fb376fd96
--- /dev/null
+++ b/webui/server/models/chf-notification.js
@@ -0,0 +1,52 @@
+/*
+ * ChargingNotify queue — what the billing side wants a live session to hear
+ * now rather than at its next usage report.
+ *
+ * Collection: chf.notifications.  The CHF NF polls it (see
+ * src/chf/notify-path.c), turns each row into a TS 32.291
+ * ChargingNotifyRequest to every session drawing from the bucket, and
+ * deletes the row.
+ *
+ * A queue rather than a call: the WebUI does not speak Nchf and the CHF has
+ * no inbound admin endpoint, MongoDB change streams need a replica set, and
+ * a row written while the CHF is down is still delivered when it returns.
+ *
+ * Nothing here is read back by the WebUI, so the documents are write-only
+ * from this side; the CHF deletes them by their ObjectId.
+ *
+ * Copyright (C) 2026 by Rami Mohamed <ramrode@gmail.com>
+ */
+
+'use strict';
+
+const mongoose = require('mongoose');
+
+const Notification = new mongoose.Schema(
+  {
+    /* Unique per row, so a repeat is a new notification rather than an
+     * overwrite.  The CHF deletes by ObjectId and never reads this; it is
+     * here so one row can be told from another. */
+    id: { type: String, required: true, unique: true },
+    /* Whose sessions to reach. */
+    supi: { type: String, required: true, index: true },
+    /* Which of that subscriber's buckets; absent means all of them. */
+    bucketId: String,
+    /* REAUTHORIZATION: report now and take a fresh grant.
+     * ABORT_CHARGING: this session may not continue. */
+    type: {
+      type: String,
+      required: true,
+      enum: ['REAUTHORIZATION', 'ABORT_CHARGING'],
+    },
+    /* Free text, logged by the CHF: 'topup', 'plan-change', ... */
+    reason: String,
+    createdAt: { type: Date, default: Date.now },
+  },
+  {
+    collection: 'chf.notifications',
+    id: false,
+    versionKey: false,
+  }
+);
+
+module.exports = mongoose.model('ChfNotification', Notification);
diff --git a/webui/server/models/chf-session.js b/webui/server/models/chf-session.js
new file mode 100644
index 000000000..5feabb0ce
--- /dev/null
+++ b/webui/server/models/chf-session.js
@@ -0,0 +1,79 @@
+/*
+ * Active CHF charging session — read-only view for the WebUI.
+ *
+ * This schema mirrors the documents written by the CHF NF into
+ * the open5gs.chf.sessions MongoDB collection.  The WebUI only
+ * READS these documents; the CHF NF is the sole writer.
+ *
+ * Collection: open5gs.chf.sessions
+ *
+ * 3GPP references:
+ *   TS 23.255 §6   — active session monitoring
+ *   TS 32.291 §6.3 — Nchf_ConvergedCharging session state
+ *
+ * Copyright (C) 2026 by Rami Mohamed <ramrode@gmail.com>
+ */
+
+'use strict';
+
+const mongoose = require('mongoose');
+const Schema = mongoose.Schema;
+
+const ChfSession = new Schema(
+  {
+    /*
+     * ChargingDataRef — the resource URI suffix returned by CHF in the
+     * 201 Created Location header (TS 32.291 §6.3.1.2).
+     * Used as the document key.
+     */
+    chargingDataRef: { $type: String, unique: true },
+
+    /* SUPI of the subscriber (TS 23.003 §2.2B) */
+    supi: { $type: String },
+
+    /* Data Network Name (APN/DNN, TS 23.003 §9.1) */
+    dnn: { $type: String },
+
+    /* PDU Session ID (TS 24.501 §9.11.3.41) */
+    pduSessionId: { $type: Number },
+
+    /* Timestamp when the CHF Create was received */
+    startTime: { $type: Date },
+
+    /* Accumulated uplink octets reported by PFCP URRs */
+    ulOctets: { $type: Number, default: 0 },
+
+    /* Accumulated downlink octets reported by PFCP URRs */
+    dlOctets: { $type: Number, default: 0 },
+
+    /* UL + DL combined octets (denormalised sum written by db-handler.c) */
+    totalOctets: { $type: Number, default: 0 },
+
+    /* Granted total quota in bytes — UL+DL combined (db-handler.c: grantedTotalBytes) */
+    grantedTotalBytes: { $type: Number },
+
+    /* Session duration in seconds at last update */
+    duration: { $type: Number, default: 0 },
+
+    /* Whether the quota auto-renews at period expiry */
+    autoRenew: { $type: Boolean },
+
+    /* Validity period length in seconds */
+    periodLengthSec: { $type: Number },
+
+    /* GPSI (Generic Public Subscription Identifier, TS 23.003 §2.2C) */
+    gpsi: { $type: String },
+
+    /* Timestamp of last update written by db-handler.c */
+    updatedAt: { $type: Date }
+  },
+  {
+    typeKey: '$type',
+
+    /* Map to the CHF sessions collection; do not auto-create it */
+    collection: 'chf.sessions',
+    autoCreate: false
+  }
+);
+
+module.exports = mongoose.model('ChfSession', ChfSession);
diff --git a/webui/server/models/chf-subscriber.js b/webui/server/models/chf-subscriber.js
new file mode 100644
index 000000000..0a9e629d2
--- /dev/null
+++ b/webui/server/models/chf-subscriber.js
@@ -0,0 +1,195 @@
+/*
+ * CHF subscriber quota profile.
+ *
+ * Collection: open5gs.chf.subscribers  (same DB as the rest of Open5GS)
+ *
+ * Quota model (unified total):
+ *   totalQuotaBytes  — single total (UL+DL) data allowance in bytes.
+ *                       CHF grants grantedUnit.totalVolume so the UPF
+ *                       deducts BOTH UL and DL octets from one counter,
+ *                       ensuring UL+DL never exceeds the configured limit.
+ *
+ *   validityPeriod   — billing cycle length: 'daily' | 'weekly' | 'monthly'
+ *                       | 'custom'.  The WebUI converts this to validitySeconds
+ *                       before persisting; the C layer reads validitySeconds.
+ *
+ *   validitySeconds  — canonical period length in seconds (authoritative for C).
+ *                       Auto-populated from validityPeriod when not 'custom'.
+ *
+ *   autoRenew        — when true the CHF resets accumulated usage and re-grants
+ *                       the full quota at the start of each new period.
+ *                       When false the session is terminated (FUI) on expiry.
+ *
+ *   finalUnitAction  — action when quota is VOLUME-exhausted mid-period.
+ *                       TS 32.291 §7.3: TERMINATE | REDIRECT | RESTRICT_ACCESS.
+ *
+ * 3GPP references:
+ *   TS 23.255 §5.2   — CHF subscriber management
+ *   TS 32.291 §6.3.1 — ChargingDataRequest: grantedUnit drives the quota
+ *   TS 32.291 §6.3.2.2 — TIME_LIMIT / VOLUME_LIMIT triggers
+ *   TS 32.291 §7.3   — FinalUnitIndication actions
+ *
+ * Copyright (C) 2026 by Rami Mohamed <ramrode@gmail.com>
+ */
+
+'use strict';
+
+const mongoose = require('mongoose');
+const Schema = mongoose.Schema;
+
+const ChfSubscriber = new Schema(
+  {
+    /*
+     * SUPI — Subscription Permanent Identifier (TS 23.003 §2.2B).
+     * Format: "imsi-<15-digit IMSI>"  e.g. "imsi-001010000000001"
+     * Also accepts full 5G SUPI with IMSI type indicator.
+     */
+    /*
+     * Bucket id.  A subscriber's catch-all bucket - the one with no scope,
+     * which is what a plain per-SUPI plan is - uses the SUPI itself, so
+     * everything written before buckets existed keeps working and keeps
+     * its URL.  A scoped bucket gets a generated id.
+     */
+    bucketId: {
+      $type: String,
+      unique: true,
+      sparse: true,
+      index: true
+    },
+
+    /*
+     * What this bucket applies to.  An absent member is open and matches
+     * anything; a bucket with no scope at all is the catch-all.  The CHF
+     * reads these in src/chf/db-handler.c and matches them against the
+     * ChargingDataRequest (TS 32.291): the slice from
+     * networkSlicingInfo.sNSSAI, the DNN from dnnId, the home network from
+     * hPlmnId and roaming from userInformation.roamerInOut.
+     */
+    scope: {
+      snssai: {
+        sst: { $type: Number, min: 0, max: 255 },
+        sd:  { $type: String, match: /^[0-9a-fA-F]{6}$/ }
+      },
+      dnn:     { $type: String },
+      hplmn:   { $type: String, match: /^\d{3}-\d{2,3}$/ },
+      roaming: { $type: String, enum: ['home', 'inBound', 'outBound'] }
+    },
+
+    /*
+     * Which bucket wins when several cover one session: highest first.
+     * Equal numbers keep the older bucket.
+     */
+    priority: { $type: Number, default: 0 },
+
+    supi: {
+      $type: String,
+      index: true,
+      required: true,
+      /*
+       * TS 23.003 §2.2B: IMSI is exactly 15 digits.
+       * The Edit.js form enforces the same '^imsi-\\d{15}$' pattern.
+       */
+      match: /^imsi-\d{15}$/
+    },
+
+    /*
+     * Per-SUPI quota profile applied to every 5GC PDU session.
+     * The CHF NF reads this on Create and issues grantedUnit accordingly.
+     */
+    quota: {
+      /*
+       * Total data allowance in bytes (UL + DL combined).
+       * The CHF grants this as grantedUnit.totalVolume; the UPF deducts
+       * both uplink and downlink bytes from a single counter so the
+       * subscriber can never consume more than this value in total.
+       * Default: 10 GiB (10 × 1 073 741 824 bytes).
+       */
+      totalQuotaBytes: { $type: Number, default: 10737418240 },
+
+      /*
+       * Billing cycle: how long one grant period lasts.
+       *   'daily'   →  86 400 s  (24 hours)
+       *   'weekly'  → 604 800 s  (7 days)
+       *   'monthly' → 2 592 000 s (30 days)
+       *   'custom'  → validitySeconds below
+       * The WebUI converts this enum to validitySeconds before saving.
+       */
+      validityPeriod: {
+        $type: String,
+        enum: ['daily', 'weekly', 'monthly', 'custom'],
+        default: 'monthly'
+      },
+
+      /*
+       * Period length in seconds — authoritative value read by the C layer.
+       * Auto-derived from validityPeriod by the WebUI; editable for 'custom'.
+       * Default 2 592 000 s = 30-day month.
+       */
+      validitySeconds: { $type: Number, default: 2592000 },
+
+      /*
+       * Auto-renew on period expiry.
+       *   true  — on period expiry the CHF resets the per-session usage
+       *           counters and re-grants the full totalQuotaBytes for the
+       *           next period.  The subscriber gets a recurring allowance.
+       *   false — on period expiry the session is terminated (FUI TERMINATE
+       *           or whatever finalUnitAction is set to).  No renewal.
+       */
+      autoRenew: { $type: Boolean, default: true },
+
+      /*
+       * Action when the volume quota is exhausted BEFORE the period expires.
+       * TS 32.291 §7.3:
+       *   TERMINATE        — terminate the PDU session (default, safest)
+       *   REDIRECT         — redirect traffic to a captive portal
+       *   RESTRICT_ACCESS  — allow only a restricted service set
+       */
+      finalUnitAction: {
+        $type: String,
+        enum: ['TERMINATE', 'REDIRECT', 'RESTRICT_ACCESS'],
+        default: 'TERMINATE'
+      }
+    },
+
+    /*
+     * Billing-cycle usage counter.
+     *
+     * Written exclusively by the CHF NF (src/chf/db-handler.c): every UL+DL
+     * delta the SMF reports is added with an atomic $inc, and the pair is
+     * reset when a new cycle opens.  Because it lives on the subscriber
+     * rather than the session, it survives session teardown — which is what
+     * makes "remaining this cycle" meaningful across reconnects.
+     *
+     * The WebUI only READS these fields; they are not part of the edit form.
+     */
+    /*
+     * TMF666 billing account this bucket is charged to (TMF654
+     * Bucket.partyAccount).  Optional; not read by the CHF.
+     */
+    billingAccountId: { $type: String, index: true },
+
+    usage: {
+      /* Start of the current billing cycle. */
+      periodStart:   { $type: Date },
+
+      /* Cumulative UL+DL bytes consumed since periodStart, all sessions. */
+      consumedBytes: { $type: Number, default: 0 },
+
+      /* Top-ups bought for this cycle via TMF654 topupBalance; the CHF
+       * zeroes them when it opens a new cycle. */
+      topupBytes:    { $type: Number, default: 0 },
+
+      /* Last time the CHF touched the counter. */
+      updatedAt:     { $type: Date }
+    }
+  },
+  {
+    /* Use $type instead of type to avoid conflict with Mongoose reserved key */
+    typeKey: '$type',
+
+    /* Map to the CHF subscribers collection, not the default "chfsubscribers" */
+    collection: 'chf.subscribers'
+  }
+);
+
+module.exports = mongoose.model('ChfSubscriber', ChfSubscriber);
