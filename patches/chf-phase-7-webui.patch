diff --git a/webui/src/containers/ChfStats.js b/webui/src/containers/ChfStats.js
new file mode 100644
index 000000000..5aa965575
--- /dev/null
+++ b/webui/src/containers/ChfStats.js
@@ -0,0 +1,131 @@
+/*
+ * CHF summary statistics header.
+ *
+ * The default landing view for both CHF pages: shows counts (provisioned
+ * subscribers, online sessions, sessions active in the recent window) without
+ * downloading any collection.  Each count is a cheap limit:1 fetch whose
+ * X-Total-Count header carries the real total, so the cost is one
+ * countDocuments per stat regardless of collection size.
+ *
+ * Refreshes on a slow, visibility-aware interval so a backgrounded tab does
+ * not keep polling.
+ *
+ * Copyright (C) 2026 by Rami Mohamed <ramrode@gmail.com>
+ */
+
+import { Component } from 'react';
+import PropTypes from 'prop-types';
+import { connect } from 'react-redux';
+
+import { fetchChfSubscribers } from 'modules/crud/chf-subscriber';
+import { fetchChfSessions } from 'modules/crud/chf-session';
+import { select } from 'modules/crud/selectors';
+import { countParams, totalFromOtherInfo } from 'helpers/chf-query';
+
+import { StatCards } from 'components';
+
+const REFRESH_MS = 15000;
+
+/* Unfiltered counts have no time component, so hoist them: one object, one
+ * crud cache key.  The windowed count is built per render but is equally
+ * stable — windowIso() snaps its bound to a bucket (see helpers/chf-query). */
+const SUBS_COUNT = countParams('subscriber', '', 0);
+const SESS_COUNT = countParams('session', '', 0);
+
+class ChfStats extends Component {
+  componentDidMount() {
+    if (typeof document !== 'undefined') {
+      document.addEventListener('visibilitychange', this.handleVisibility);
+    }
+    this.refresh();
+    this.start();
+  }
+
+  componentWillReceiveProps(nextProps) {
+    /* Fill a count the selector has nothing cached for, rather than leaving
+     * the card blank until the next tick — this covers a window-selector
+     * change and the minute rollover of the windowed bucket.  It terminates
+     * because the params are stable: once the fetch lands, needsFetch stays
+     * false for that key. */
+    ['subs', 'sessions', 'recent'].forEach(k => {
+      if (nextProps[k] && nextProps[k].needsFetch) {
+        this.props.dispatch(nextProps[k].fetch);
+      }
+    });
+  }
+
+  componentWillUnmount() {
+    if (typeof document !== 'undefined') {
+      document.removeEventListener('visibilitychange', this.handleVisibility);
+    }
+    this.stop();
+  }
+
+  recentParams() {
+    return countParams('session', '', this.props.windowHours);
+  }
+
+  refresh() {
+    this.props.dispatch(fetchChfSubscribers(SUBS_COUNT));
+    this.props.dispatch(fetchChfSessions(SESS_COUNT));
+    this.props.dispatch(fetchChfSessions(this.recentParams()));
+  }
+
+  start() {
+    this.stop();
+    if (typeof document !== 'undefined' && document.hidden) return;
+    this._timer = setInterval(() => this.refresh(), REFRESH_MS);
+  }
+
+  stop() {
+    if (this._timer) { clearInterval(this._timer); this._timer = null; }
+  }
+
+  handleVisibility = () => {
+    if (document.hidden) this.stop();
+    else { this.refresh(); this.start(); }
+  };
+
+  render() {
+    const { subs, sessions, recent, windowHours } = this.props;
+    const stats = [
+      {
+        label: 'Provisioned Subscribers',
+        value: totalFromOtherInfo(subs.otherInfo),
+        hint: 'CHF quota profiles',
+      },
+      {
+        label: 'Online Sessions',
+        value: totalFromOtherInfo(sessions.otherInfo),
+        hint: 'active charging sessions',
+      },
+      {
+        label: `Active (last ${windowHours}h)`,
+        value: totalFromOtherInfo(recent.otherInfo),
+        hint: 'sessions started in window',
+      },
+    ];
+    return <StatCards stats={stats} />;
+  }
+}
+
+ChfStats.propTypes = {
+  dispatch: PropTypes.func.isRequired,
+  windowHours: PropTypes.number,
+  subs: PropTypes.object.isRequired,
+  sessions: PropTypes.object.isRequired,
+  recent: PropTypes.object.isRequired,
+};
+
+ChfStats.defaultProps = {
+  windowHours: 1,
+};
+
+export default connect((state, ownProps) => ({
+  subs: select(fetchChfSubscribers(SUBS_COUNT), state.crud),
+  sessions: select(fetchChfSessions(SESS_COUNT), state.crud),
+  recent: select(
+    fetchChfSessions(countParams('session', '', ownProps.windowHours || 1)),
+    state.crud
+  ),
+}))(ChfStats);
diff --git a/webui/src/containers/ChfSubscriber/Collection.js b/webui/src/containers/ChfSubscriber/Collection.js
new file mode 100644
index 000000000..45ed83219
--- /dev/null
+++ b/webui/src/containers/ChfSubscriber/Collection.js
@@ -0,0 +1,325 @@
+/*
+ * CHF subscriber quota-profile collection.
+ *
+ * Scale hardening for a large provisioned-subscriber base:
+ *   - Server-side pagination (?limit/?skip, sorted by SUPI): only one page is
+ *     ever fetched and rendered, never the whole chf.subscribers collection.
+ *   - Server-side SUPI search (?query, prefix-anchored + regex-escaped) so an
+ *     operator finds one subscriber among thousands without downloading them.
+ *   - X-Total-Count drives an "N of TOTAL" indicator and the Next control.
+ *
+ * Structure: a stateful, connected parent owns page/search + the create /
+ * edit / delete modals; a connected child selects exactly the page named by
+ * queryParams (a page/search change flips crud "needsFetch" and refetches).
+ *
+ * Copyright (C) 2026 by Rami Mohamed <ramrode@gmail.com>
+ */
+
+import { Component } from 'react';
+import PropTypes from 'prop-types';
+import { connect } from 'react-redux';
+
+import {
+  MODEL,
+  fetchChfSubscribers,
+  deleteChfSubscriber,
+} from 'modules/crud/chf-subscriber';
+import { clearActionStatus } from 'modules/crud/actions';
+import { select, selectActionStatus } from 'modules/crud/selectors';
+import { buildSubscriberParams, totalFromOtherInfo } from 'helpers/chf-query';
+import * as Notification from 'modules/notification/actions';
+
+import {
+  Layout,
+  ChfSubscriber,
+  Spinner,
+  FloatingButton,
+  Blank,
+  Dimmed,
+  Confirm,
+  ListToolbar,
+} from 'components';
+import ChfStats from 'containers/ChfStats';
+
+import Document from './Document';
+
+const PAGE_SIZE = 25;
+const SEARCH_DEBOUNCE_MS = 400;
+
+/* ------------------------------------------------------------------ */
+/* Connected data view — selects and renders one page of subscribers.  */
+/* ------------------------------------------------------------------ */
+class SubscriberData extends Component {
+  componentWillMount() {
+    this.maybeFetch(this.props);
+  }
+
+  componentWillReceiveProps(nextProps) {
+    this.maybeFetch(nextProps);
+  }
+
+  maybeFetch(props) {
+    /* Only fetch a page when the view is active (a search or Browse) —
+     * the default landing is stats-only and must not pull the collection. */
+    if (props.active && props.chfSubscribers.needsFetch) {
+      props.dispatch(props.chfSubscribers.fetch);
+    }
+  }
+
+  render() {
+    const {
+      active, chfSubscribers, deletedSupi, onEdit, onDelete, onBrowse,
+      page, pageSize, search, onSearchChange, onPrev, onNext,
+    } = this.props;
+    const { isLoading, data, otherInfo } = chfSubscribers;
+    const total = totalFromOtherInfo(otherInfo);
+
+    return (
+      <div>
+        <ListToolbar
+          showSearch
+          search={search}
+          searchPlaceholder="Search by SUPI or prefix (e.g. imsi-99970 …)"
+          onSearchChange={onSearchChange}
+          page={page}
+          pageSize={pageSize}
+          count={active ? data.length : 0}
+          total={active ? total : undefined}
+          onPrev={onPrev}
+          onNext={onNext}
+        />
+
+        {!active ? (
+          <Blank
+            visible
+            title="BROWSE ALL SUBSCRIBERS"
+            body="Search by SUPI (or a prefix) above, or browse the full list."
+            onTitle={onBrowse}
+          />
+        ) : (
+          <div>
+            <ChfSubscriber.List
+              chfSubscribers={data}
+              deletedSupi={deletedSupi}
+              onEdit={onEdit}
+              onDelete={onDelete}
+            />
+            {isLoading && <Spinner md />}
+            <Blank
+              visible={!isLoading && !(data.length > 0)}
+              title="NO MATCHING SUBSCRIBERS"
+              body="No CHF quota profiles match this view."
+            />
+          </div>
+        )}
+      </div>
+    );
+  }
+}
+
+SubscriberData.propTypes = {
+  active: PropTypes.bool.isRequired,
+  chfSubscribers: PropTypes.object.isRequired,
+  dispatch: PropTypes.func.isRequired,
+  deletedSupi: PropTypes.string,
+  onEdit: PropTypes.func.isRequired,
+  onDelete: PropTypes.func.isRequired,
+  onBrowse: PropTypes.func.isRequired,
+  page: PropTypes.number.isRequired,
+  pageSize: PropTypes.number.isRequired,
+  search: PropTypes.string.isRequired,
+  onSearchChange: PropTypes.func.isRequired,
+  onPrev: PropTypes.func.isRequired,
+  onNext: PropTypes.func.isRequired,
+};
+
+const ConnectedSubscriberData = connect((state, ownProps) => ({
+  chfSubscribers: select(fetchChfSubscribers(ownProps.queryParams), state.crud),
+}))(SubscriberData);
+
+/* ------------------------------------------------------------------ */
+/* Stateful parent — owns page/search + create/edit/delete modals.     */
+/* ------------------------------------------------------------------ */
+class Collection extends Component {
+  state = {
+    page: 0,
+    searchInput: '',
+    searchApplied: '',
+    browse: false,   // "Browse all" was clicked (list without a search)
+    document: {
+      action: '',
+      visible: false,
+      dimmed: false,
+    },
+    confirm: {
+      visible: false,
+      /* The bucket to delete: a SUPI for a subscriber's catch-all, or a
+       * scoped bucket's own id. */
+      bucketId: '',
+    },
+  };
+
+  componentWillUnmount() {
+    if (this._searchTimer) clearTimeout(this._searchTimer);
+  }
+
+  componentWillReceiveProps(nextProps) {
+    const { status } = nextProps;
+    const { dispatch } = this.props;
+
+    if (status.response) {
+      dispatch(
+        Notification.success({
+          title: 'CHF Quota',
+          message: `${status.id} has been deleted`,
+        })
+      );
+      dispatch(clearActionStatus(MODEL, 'delete'));
+      /* Refresh the current page so the deleted row disappears. */
+      dispatch(fetchChfSubscribers(this.params()));
+    }
+
+    if (status.error) {
+      const response = ((status || {}).error || {}).response || {};
+      let title = 'Unknown Code';
+      let message = 'Unknown Error';
+      if (response.data && response.data.name && response.data.message) {
+        title = response.data.name;
+        message = response.data.message;
+      } else {
+        title = response.status;
+        message = response.statusText;
+      }
+      dispatch(
+        Notification.error({
+          title,
+          message,
+          autoDismiss: 0,
+          action: { label: 'Dismiss' },
+        })
+      );
+      dispatch(clearActionStatus(MODEL, 'delete'));
+    }
+  }
+
+  params() {
+    return buildSubscriberParams(
+      this.state.page, PAGE_SIZE, this.state.searchApplied);
+  }
+
+  isActive() {
+    return this.state.searchApplied !== '' || this.state.browse;
+  }
+
+  handleSearchChange = (value) => {
+    this.setState({ searchInput: value });
+    if (this._searchTimer) clearTimeout(this._searchTimer);
+    this._searchTimer = setTimeout(() => {
+      this.setState({ searchApplied: value.trim(), page: 0 });
+    }, SEARCH_DEBOUNCE_MS);
+  };
+
+  handleBrowse = () => this.setState({ browse: true, page: 0 });
+
+  handlePrev = () => this.setState(s => ({ page: Math.max(0, s.page - 1) }));
+  handleNext = () => this.setState(s => ({ page: s.page + 1 }));
+
+  documentHandler = {
+    show: (action, payload) => {
+      this.setState({
+        document: { action, visible: true, dimmed: true, ...payload },
+      });
+    },
+    hide: () => {
+      /* Refresh the page after a create/edit so new/changed rows show. */
+      this.props.dispatch(fetchChfSubscribers(this.params()));
+      this.setState({
+        document: { action: '', visible: false, dimmed: false },
+      });
+    },
+    actions: {
+      create: () => {
+        this.documentHandler.show('create');
+      },
+      update: bucketId => {
+        this.documentHandler.show('update', { bucketId });
+      },
+    },
+  };
+
+  confirmHandler = {
+    show: bucketId => {
+      this.setState({ confirm: { visible: true, bucketId } });
+    },
+    hide: () => {
+      this.setState({
+        confirm: { ...this.state.confirm, visible: false },
+      });
+    },
+    actions: {
+      delete: () => {
+        const { dispatch } = this.props;
+        if (this.state.confirm.visible === true) {
+          this.confirmHandler.hide();
+          this.documentHandler.hide();
+          dispatch(deleteChfSubscriber(this.state.confirm.bucketId));
+        }
+      },
+    },
+  };
+
+  render() {
+    const { documentHandler, confirmHandler } = this;
+    const { document } = this.state;
+    const { status } = this.props;
+
+    return (
+      <Layout.Content>
+        <ChfStats windowHours={1} />
+        <ConnectedSubscriberData
+          active={this.isActive()}
+          queryParams={this.params()}
+          page={this.state.page}
+          pageSize={PAGE_SIZE}
+          search={this.state.searchInput}
+          dispatch={this.props.dispatch}
+          deletedSupi={status.id}
+          onEdit={documentHandler.actions.update}
+          onDelete={confirmHandler.show}
+          onBrowse={this.handleBrowse}
+          onSearchChange={this.handleSearchChange}
+          onPrev={this.handlePrev}
+          onNext={this.handleNext}
+        />
+        <FloatingButton onClick={documentHandler.actions.create} />
+        <Document
+          {...document}
+          onEdit={documentHandler.actions.update}
+          onDelete={confirmHandler.show}
+          onHide={documentHandler.hide}
+        />
+        <Dimmed visible={document.dimmed} />
+        <Confirm
+          visible={this.state.confirm.visible}
+          message="Delete this CHF quota profile?"
+          onOutside={confirmHandler.hide}
+          buttons={[
+            { text: 'CANCEL', action: confirmHandler.hide, info: true },
+            { text: 'DELETE', action: confirmHandler.actions.delete, danger: true },
+          ]}
+        />
+      </Layout.Content>
+    );
+  }
+}
+
+Collection.propTypes = {
+  dispatch: PropTypes.func.isRequired,
+  status: PropTypes.object.isRequired,
+};
+
+Collection = connect((state) => ({
+  status: selectActionStatus(MODEL, state.crud, 'delete'),
+}))(Collection);
+
+export default Collection;
diff --git a/webui/src/containers/ChfSubscriber/Document.js b/webui/src/containers/ChfSubscriber/Document.js
new file mode 100644
index 000000000..dff32f5b3
--- /dev/null
+++ b/webui/src/containers/ChfSubscriber/Document.js
@@ -0,0 +1,194 @@
+/*
+ * CHF subscriber quota profile — Redux-connected document container.
+ *
+ * Responsibilities:
+ *   1. Fetch an existing ChfSubscriber document from the REST API when editing.
+ *   2. Convert raw byte values stored in MongoDB → human-readable display form
+ *      for Edit.js (dbToForm: totalQuotaBytes → totalVolume + volumeUnit).
+ *   3. Convert the form's display values → raw bytes + canonical seconds before
+ *      persisting (formToDb), so the Mongoose model and C db-handler.c always
+ *      see consistent totalQuotaBytes / validitySeconds fields.
+ *   4. Dispatch create / update actions and show success / error notifications.
+ *
+ * Unit conversion (binary prefixes, IEC 80000-13):
+ *   1 MB = 1 048 576 bytes   (2^20)
+ *   1 GB = 1 073 741 824 bytes (2^30)
+ *   1 TB = 1 099 511 627 776 bytes (2^40)
+ *
+ * 3GPP: TS 23.255 §5.2   — CHF subscriber management
+ *       TS 32.291 §6.3.1 — ChargingDataRequest: grantedUnit drives the quota
+ *       TS 32.291 §6.3.2.2 — TIME_LIMIT / VOLUME_LIMIT triggers
+ */
+
+import { Component } from 'react';
+import PropTypes from 'prop-types';
+import { connect } from 'react-redux';
+import { isEqual } from 'lodash/lang';
+
+import NProgress from 'nprogress';
+
+import {
+  MODEL,
+  fetchChfSubscriber,
+  createChfSubscriber,
+  updateChfSubscriber,
+} from 'modules/crud/chf-subscriber';
+import { clearActionStatus } from 'modules/crud/actions';
+import { select, selectActionStatus } from 'modules/crud/selectors';
+import * as Notification from 'modules/notification/actions';
+
+import { ChfSubscriber } from 'components';
+import {
+  DEFAULT_QUOTA_FORM as defaultFormData,
+  dbToForm,
+  formToDb,
+} from 'helpers/chf-quota-convert';
+
+/* ------------------------------------------------------------------ */
+/* Document container                                                   */
+/* ------------------------------------------------------------------ */
+class Document extends Component {
+  static propTypes = {
+    action: PropTypes.string,
+    visible: PropTypes.bool,
+    onHide: PropTypes.func,
+  };
+
+  state = {
+    formData: defaultFormData,
+  };
+
+  componentWillMount() {
+    const { chfSubscriber, dispatch } = this.props;
+    if (chfSubscriber.needsFetch) {
+      dispatch(chfSubscriber.fetch);
+    }
+  }
+
+  componentWillReceiveProps(nextProps) {
+    const { chfSubscriber, status } = nextProps;
+    const { dispatch, action, onHide } = this.props;
+
+    if (chfSubscriber.needsFetch) {
+      dispatch(chfSubscriber.fetch);
+    }
+
+    /*
+     * Convert raw bytes from DB → display unit for the form.
+     * dbToForm() handles both the new totalQuotaBytes field and legacy
+     * volumeUlBytes + volumeDlBytes (backward compat with older records).
+     *
+     * Only load the form when the modal opens or the document behind it
+     * actually changes.  Both CHF pages poll on a timer, so every few
+     * seconds an unrelated store update re-renders this connected component;
+     * resetting formData unconditionally would discard whatever the operator
+     * had typed mid-edit.
+     */
+    const nextForm = chfSubscriber.data
+      ? dbToForm(chfSubscriber.data)
+      : defaultFormData;
+
+    if ((nextProps.visible && !this.props.visible) ||
+        !isEqual(nextForm, this.loadedForm)) {
+      this.loadedForm = nextForm;
+      this.setState({ formData: nextForm });
+    }
+
+    if (status.response) {
+      NProgress.configure({ parent: 'body', trickleSpeed: 5 });
+      NProgress.done(true);
+
+      const message =
+        action === 'create'
+          ? 'New CHF quota profile created'
+          : `${status.id} quota profile updated`;
+
+      dispatch(Notification.success({ title: 'CHF Quota', message }));
+      dispatch(clearActionStatus(MODEL, action));
+      onHide();
+    }
+
+    if (status.error) {
+      NProgress.configure({ parent: 'body', trickleSpeed: 5 });
+      NProgress.done(true);
+
+      const response = ((status || {}).error || {}).response || {};
+      let title = 'Unknown Code';
+      let message = 'Unknown Error';
+      if (response.data && response.data.name && response.data.message) {
+        title = response.data.name;
+        message = response.data.message;
+      } else {
+        title = response.status;
+        message = response.statusText;
+      }
+
+      dispatch(
+        Notification.error({
+          title,
+          message,
+          autoDismiss: 0,
+          action: { label: 'Dismiss', callback: () => onHide() },
+        })
+      );
+      dispatch(clearActionStatus(MODEL, action));
+    }
+  }
+
+  handleSubmit = formData => {
+    const { dispatch, action } = this.props;
+
+    NProgress.configure({ parent: '#nprogress-base-form', trickleSpeed: 5 });
+    NProgress.start();
+
+    /*
+     * Convert display-unit fields (totalVolume, volumeUnit, validityPeriod)
+     * to raw bytes (totalQuotaBytes) and canonical seconds (validitySeconds)
+     * before persisting.  This keeps the Mongoose model schema consistent and
+     * ensures db-handler.c reads the correct camelCase field names.
+     */
+    const dbData = formToDb(formData);
+
+    if (action === 'create') {
+      dispatch(createChfSubscriber({}, dbData));
+    } else if (action === 'update') {
+      dispatch(updateChfSubscriber(dbData.bucketId || dbData.supi, {}, dbData));
+    } else {
+      throw new Error(`Action type '${action}' is invalid.`);
+    }
+  };
+
+  handleError = errors => {
+    const { dispatch } = this.props;
+    errors.map(error =>
+      dispatch(
+        Notification.error({ title: 'Validation Error', message: error.stack })
+      )
+    );
+  };
+
+  render() {
+    const { handleSubmit, handleError } = this;
+    const { visible, action, status, chfSubscriber, onHide } = this.props;
+
+    return (
+      <ChfSubscriber.Edit
+        visible={visible}
+        action={action}
+        formData={this.state.formData}
+        isLoading={chfSubscriber.isLoading && !status.pending}
+        onHide={onHide}
+        onSubmit={handleSubmit}
+        onError={handleError}
+      />
+    );
+  }
+}
+
+Document = connect((state, props) => ({
+  chfSubscriber: select(fetchChfSubscriber(props.bucketId || props.supi),
+      state.crud),
+  status: selectActionStatus(MODEL, state.crud, props.action),
+}))(Document);
+
+export default Document;
