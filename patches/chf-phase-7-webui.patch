diff --git a/webui/server/chf-guards.js b/webui/server/chf-guards.js
new file mode 100644
index 000000000..9fe374a74
--- /dev/null
+++ b/webui/server/chf-guards.js
@@ -0,0 +1,43 @@
+/*
+ * Request guards for the CHF WebUI REST resources.
+ *
+ * Kept out of routes/db.js so they can be unit-tested without Express or a
+ * live Mongoose connection.
+ *
+ * Copyright (C) 2026 by Rami Mohamed <ramrode@gmail.com>
+ */
+
+'use strict';
+
+/*
+ * usage.* on a CHF subscriber is owned exclusively by the CHF NF: it holds
+ * the billing-cycle counter the CHF advances with an atomic $inc on every
+ * usage report (src/chf/db-handler.c).  No API client may write it.
+ *
+ * Without this guard an admin edit silently rewinds the counter.  The edit
+ * modal loads the whole document when it opens and PATCHes it back on save,
+ * so whatever the CHF counted while the modal was open is overwritten with
+ * the stale snapshot - handing the subscriber that usage for free, or
+ * resurrecting a pre-rollover periodStart.
+ *
+ * Enforced server-side because the WebUI is not the only client: any curl
+ * script can PATCH this resource.  Both the "usage" object and dotted paths
+ * such as "usage.consumedBytes" are removed; Mongoose's document.set() would
+ * otherwise apply the dotted form straight to the nested field.
+ *
+ * Mounted as preMiddleware so it runs for every verb, including the
+ * deprecated POST-to-item and PUT update routes.  On reads there is no body
+ * and it is a no-op.
+ */
+function chfSubscriberProtectUsage(req, res, next) {
+  const body = req.body;
+  if (body && typeof body === 'object') {
+    Object.keys(body).forEach(key => {
+      if (key === 'usage' || key.startsWith('usage.'))
+        delete body[key];
+    });
+  }
+  return next();
+}
+
+module.exports = { chfSubscriberProtectUsage };
diff --git a/webui/server/chf-migrate.js b/webui/server/chf-migrate.js
new file mode 100644
index 000000000..bcc3bd2af
--- /dev/null
+++ b/webui/server/chf-migrate.js
@@ -0,0 +1,58 @@
+/*
+ * Bring chf.subscribers up to the bucket model.
+ *
+ * A subscriber used to have exactly one allowance, so the collection had a
+ * unique index on supi.  A subscriber can now hold several buckets - one
+ * per slice, DNN, home PLMN or roaming state - and they are told apart by
+ * bucketId, so that uniqueness has to move.  Mongoose creates the new
+ * indexes but never drops one it no longer declares, so the old unique
+ * index would keep rejecting the second bucket with E11000.
+ *
+ * Runs once at start-up and does nothing on a collection that is already
+ * in the new shape, so it is safe on every boot.  A failure is logged and
+ * ignored: the WebUI still serves the buckets that exist.
+ *
+ * Copyright (C) 2026 by Rami Mohamed <ramrode@gmail.com>
+ */
+
+'use strict';
+
+const COLLECTION = 'chf.subscribers';
+
+async function migrateChfBuckets(connection) {
+  const db = connection && connection.db;
+  if (!db) return;
+
+  try {
+    const names = await db.listCollections({ name: COLLECTION }).toArray();
+    if (!names.length) return;      /* nothing provisioned yet */
+
+    const collection = db.collection(COLLECTION);
+    const indexes = await collection.indexes();
+
+    /* The old unique index on supi: drop it, so a subscriber can hold
+     * more than one bucket.  Mongoose recreates it as a plain index. */
+    const supiUnique = indexes.find(
+        ix => ix.unique && ix.key && ix.key.supi === 1 &&
+              Object.keys(ix.key).length === 1);
+    if (supiUnique) {
+      await collection.dropIndex(supiUnique.name);
+      console.log(
+          `[chf] ${COLLECTION}: dropped the unique index on supi ` +
+          '(a subscriber can now hold several buckets)');
+    }
+
+    /* Documents written before buckets existed: their id is their SUPI,
+     * which is what makes them the subscriber's catch-all bucket. */
+    const result = await collection.updateMany(
+        { bucketId: { $exists: false } },
+        [{ $set: { bucketId: '$supi' } }]);
+    const changed = result.modifiedCount || 0;
+    if (changed)
+      console.log(`[chf] ${COLLECTION}: gave ${changed} bucket(s) an id`);
+  } catch (err) {
+    console.error(`[chf] ${COLLECTION} migration skipped: ${err.message}`);
+  }
+}
+
+module.exports = { migrateChfBuckets };
