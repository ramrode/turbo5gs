+
+// ============================================================ formToDb tests
+
+test('11. GB unit: 10 GB → totalQuotaBytes=10737418240', () => {
+  const db = formToDb({
+    supi:  'imsi-001010000000002',
+    quota: {
+      totalVolume:     10,
