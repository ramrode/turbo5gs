+});
+
+test('9. finalUnitAction=RESTRICT_ACCESS is preserved', () => {
+  const form = dbToForm(makeDoc({
+    totalQuotaBytes: 5 * GB,
+    validityPeriod:  'monthly',
+    validitySeconds: 2592000,
+    autoRenew:       true,
