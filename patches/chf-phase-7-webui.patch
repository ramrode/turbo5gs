+  test('31. top-up records are immutable (405)', async () => {
+    await seedBucket(1, {}, { periodStart: ISO(NOW - DAY_MS) });
+    const { body } = await topup(1, { amount: 1, units: 'GB' });
+    const patched = await call('PATCH', `${T}/${body.id}`, { status: 'failed' });
