diff --git a/webui/src/components/ChfSubscriber/Edit.js b/webui/src/components/ChfSubscriber/Edit.js
new file mode 100644
index 000000000..4f2b04b74
--- /dev/null
+++ b/webui/src/components/ChfSubscriber/Edit.js
@@ -0,0 +1,301 @@
+/*
+ * CHF subscriber quota profile — Edit / Create form.
+ *
+ * The user enters ONE total data quota (UL + DL combined).  The CHF grants
+ * grantedUnit.totalVolume so the UPF deducts both uplink and downlink octets
+ * from a single counter, ensuring UL+DL never exceeds the configured limit.
+ *
+ * Field → MongoDB mapping (after Document.js / formToDb conversion):
+ *   totalVolume + volumeUnit  → quota.totalQuotaBytes  (Number, bytes)
+ *   validityPeriod            → quota.validityPeriod   (String enum)
+ *   validitySeconds           → quota.validitySeconds  (Number, seconds; resolved from preset)
+ *   autoRenew                 → quota.autoRenew        (Boolean)
+ *   finalUnitAction           → quota.finalUnitAction  (String enum)
+ *
+ * 3GPP: TS 32.291 §6.3.1.2 — GrantedUnit / FinalUnitIndication
+ *       TS 32.291 §6.3.2.2 — TIME_LIMIT trigger / validityTime
+ */
+
+import { Component } from 'react';
+import PropTypes from 'prop-types';
+
+import withWidth, { SMALL } from 'helpers/with-width';
+import { Form } from 'components';
+
+const schema = {
+  title: '',
+  type: 'object',
+  required: ['supi'],
+  properties: {
+    supi: {
+      type: 'string',
+      title: 'SUPI*',
+      pattern: '^imsi-\\d{15}$',
+      messages: {
+        pattern: 'Must be: imsi- followed by exactly 15 digits (e.g. imsi-999700000000001)',
+      },
+    },
+    /*
+     * What this allowance covers.  Every field is optional, and one left
+     * empty is open: it matches anything.  A bucket with nothing filled in
+     * is the subscriber's catch-all, which is what a plain per-SUPI plan
+     * is.  The CHF matches these against the charging request (TS 32.291):
+     * the slice from networkSlicingInfo.sNSSAI, the DNN from dnnId, the
+     * home network from hPlmnId, roaming from userInformation.roamerInOut.
+     */
+    scopeForm: {
+      type: 'object',
+      title: 'Applies To',
+      properties: {
+        sst: {
+          type: 'string',
+          title: 'Slice SST',
+          pattern: '^$|^([0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5])$',
+          messages: { pattern: 'Leave empty for any slice, or enter 0-255' },
+        },
+        sd: {
+          type: 'string',
+          title: 'Slice SD',
+          pattern: '^$|^[0-9a-fA-F]{6}$',
+          messages: { pattern: 'Leave empty for any, or 6 hex digits (e.g. 010203)' },
+        },
+        dnn: {
+          type: 'string',
+          title: 'DNN',
+        },
+        hplmn: {
+          type: 'string',
+          title: 'Home PLMN',
+          pattern: '^$|^\\d{3}-\\d{2,3}$',
+          messages: { pattern: 'Leave empty for any, or MCC-MNC (e.g. 999-70)' },
+        },
+        roaming: {
+          type: 'string',
+          title: 'Roaming',
+          enum: ['', 'home', 'inBound', 'outBound'],
+          enumNames: ['Any', 'Home network only', 'Inbound roamers',
+                      'Roaming abroad'],
+          default: '',
+        },
+      },
+    },
+
+    priority: {
+      type: 'integer',
+      title: 'Priority',
+      default: 0,
+    },
+
+    quota: {
+      type: 'object',
+      title: 'Quota Profile',
+      properties: {
+
+        /*
+         * Total data allowance entered by the user.
+         * Document.js / formToDb() converts this to totalQuotaBytes (bytes).
+         * The CHF grants grantedUnit.totalVolume; the UPF deducts UL+DL
+         * bytes from a single counter so total consumption never exceeds this.
+         */
+        totalVolume: {
+          type: 'number',
+          title: 'Total Data Quota',
+          default: 10,
+          minimum: 0,
+        },
+
+        /*
+         * Unit for totalVolume — MB, GB, or TB (binary prefixes, IEC 80000-13).
+         * formToDb() multiplies totalVolume by the appropriate factor.
+         *   1 MB = 1 048 576 bytes   (2^20)
+         *   1 GB = 1 073 741 824 bytes (2^30)
+         *   1 TB = 1 099 511 627 776 bytes (2^40)
+         */
+        volumeUnit: {
+          type: 'string',
+          title: 'Unit',
+          enum: ['MB', 'GB', 'TB'],
+          default: 'GB',
+        },
+
+        /*
+         * Billing cycle preset.  The WebUI resolves this to validitySeconds
+         * before persisting; the C layer reads validitySeconds only.
+         *   daily   →  86 400 s (24 h)
+         *   weekly  → 604 800 s (7 d)
+         *   monthly → 2 592 000 s (30 d)
+         *   custom  → use the validitySeconds field below
+         */
+        validityPeriod: {
+          type: 'string',
+          title: 'Validity Period',
+          enum: ['daily', 'weekly', 'monthly', 'custom'],
+          enumNames: ['Daily (24 h)', 'Weekly (7 d)', 'Monthly (30 d)', 'Custom'],
+          default: 'monthly',
+        },
+
+        /*
+         * Custom period in seconds.  Only used when validityPeriod === 'custom'.
+         * For preset periods, formToDb() ignores this field and derives the
+         * canonical seconds from the PERIOD_SECONDS table.
+         */
+        validitySeconds: {
+          type: 'integer',
+          title: 'Custom Period (seconds)',
+          default: 2592000,
+          minimum: 1,
+        },
+
+        /*
+         * Auto-renew on period expiry.
+         *   true  — the CHF resets accumulated usage and re-grants the full
+         *           quota at the start of each new period (recurring billing).
+         *   false — on period expiry the session is terminated according to
+         *           the finalUnitAction configured below.
+         */
+        autoRenew: {
+          type: 'boolean',
+          title: 'Auto-Renew on Expiry',
+          default: true,
+        },
+
+        /*
+         * Action when quota is volume-exhausted before the period expires.
+         * TS 32.291 §7.3:
+         *   TERMINATE       — terminate the PDU session (default, safest)
+         *   REDIRECT        — redirect traffic to a captive portal
+         *   RESTRICT_ACCESS — allow only a restricted service set
+         */
+        finalUnitAction: {
+          type: 'string',
+          title: 'Final Unit Action',
+          enum: ['TERMINATE', 'REDIRECT', 'RESTRICT_ACCESS'],
+          default: 'TERMINATE',
+        },
+      },
+    },
+  },
+};
+
+const uiSchema = {
+  supi: {
+    'ui:placeholder': 'imsi-001010000000001',
+  },
+  scopeForm: {
+    sst: {
+      'ui:placeholder': 'any',
+      'ui:help': 'Slice/Service Type. Leave empty to cover every slice.',
+    },
+    sd: {
+      'ui:placeholder': 'any',
+      'ui:help': 'Slice Differentiator, 6 hex digits. Empty covers every instance of the SST.',
+    },
+    dnn: {
+      'ui:placeholder': 'any',
+      'ui:help': 'Data Network Name, e.g. internet or ims. Empty covers every DNN.',
+    },
+    hplmn: {
+      'ui:placeholder': 'any',
+      'ui:help': "The subscriber's home network as MCC-MNC. Empty covers every PLMN.",
+    },
+    roaming: {
+      'ui:help': 'Restrict this allowance to sessions at home, or while roaming.',
+    },
+  },
+  priority: {
+    'ui:help': 'When several allowances cover one session, the highest priority wins. Equal numbers keep the older one.',
+  },
+  quota: {
+    totalVolume: {
+      'ui:help': 'Total data allowance (UL + DL combined). The CHF shares this dynamically between uplink and downlink.',
+    },
+    volumeUnit: {
+      'ui:help': 'MB = 1 048 576 bytes · GB = 1 073 741 824 bytes · TB = 1 099 511 627 776 bytes (IEC 80000-13).',
+    },
+    validityPeriod: {
+      'ui:help': 'Billing cycle length. Choose "Custom" to enter an arbitrary number of seconds.',
+    },
+    validitySeconds: {
+      'ui:help': 'Used only when "Custom" period is selected. Ignored for daily / weekly / monthly presets.',
+    },
+    autoRenew: {
+      'ui:help': 'When enabled, the CHF resets usage and re-grants the full quota at the start of each new period.',
+    },
+    finalUnitAction: {
+      'ui:help': 'Action taken when the volume quota is exhausted before the period expires.',
+    },
+  },
+};
+
+class Edit extends Component {
+  static propTypes = {
+    visible: PropTypes.bool,
+    action: PropTypes.string,
+    formData: PropTypes.object,
+    isLoading: PropTypes.bool,
+    validate: PropTypes.func,
+    onHide: PropTypes.func,
+    onSubmit: PropTypes.func,
+    onError: PropTypes.func,
+  };
+
+  constructor(props) {
+    super(props);
+    this.state = this.getStateFromProps(props);
+  }
+
+  componentWillReceiveProps(nextProps) {
+    this.setState(this.getStateFromProps(nextProps));
+  }
+
+  getStateFromProps(props) {
+    const { action, width, formData } = props;
+
+    let localUiSchema = Object.assign({}, uiSchema);
+
+    if (action === 'update') {
+      localUiSchema = Object.assign({}, localUiSchema, {
+        supi: { 'ui:disabled': true },
+      });
+    } else if (width !== SMALL) {
+      localUiSchema = Object.assign({}, localUiSchema, {
+        supi: { 'ui:autofocus': true },
+      });
+    }
+
+    return { schema, uiSchema: localUiSchema, formData };
+  }
+
+  render() {
+    const {
+      visible,
+      action,
+      isLoading,
+      validate,
+      onHide,
+      onSubmit,
+      onError,
+    } = this.props;
+
+    const { formData } = this.state;
+
+    return (
+      <Form
+        visible={isLoading ? false : visible}
+        title={action === 'update' ? 'Edit CHF Quota Profile' : 'Create CHF Quota Profile'}
+        width="560px"
+        height="640px"
+        schema={this.state.schema}
+        uiSchema={this.state.uiSchema}
+        formData={formData}
+        isLoading={isLoading}
+        validate={validate}
+        onHide={onHide}
+        onSubmit={onSubmit}
+        onError={onError}
+      />
+    );
+  }
+}
+
+export default withWidth()(Edit);
diff --git a/webui/src/components/ChfSubscriber/Item.js b/webui/src/components/ChfSubscriber/Item.js
new file mode 100644
index 000000000..7078a8579
--- /dev/null
+++ b/webui/src/components/ChfSubscriber/Item.js
@@ -0,0 +1,250 @@
+import { Component } from 'react';
+import PropTypes from 'prop-types';
+
+import styled from 'styled-components';
+import oc from 'open-color';
+import { media } from 'helpers/style-utils';
+
+import EditIcon from 'react-icons/lib/md/edit';
+import DeleteIcon from 'react-icons/lib/md/delete';
+
+import { Tooltip, Spinner } from 'components';
+import { fmtVolume, fmtPeriod, cycleUsage, scopeLabel, hasScope }
+  from 'helpers/chf-quota-convert';
+
+const Card = styled.div`
+  position: relative;
+  display: flex;
+  padding: 0.5rem;
+
+  cursor: pointer;
+
+  ${p => p.disabled && 'opacity: 0.5; cursor: not-allowed; pointer-events: none;'};
+
+  .actions {
+    position: absolute;
+    top: 0;
+    right: 0;
+    width: 8rem;
+    height: 100%;
+    display: flex;
+    align-items: center;
+    justify-content: center;
+    opacity: 0;
+  }
+
+  &:hover {
+    background: ${oc.gray[1]};
+
+    .actions {
+      ${p => p.disabled ? 'opacity: 0;' : 'opacity: 1;'};
+    }
+  }
+`;
+
+const CircleButton = styled.div`
+  height: 2rem;
+  width: 2rem;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  margin: 1px;
+
+  color: ${oc.gray[6]};
+  border-radius: 1rem;
+  font-size: 1.5rem;
+
+  &:hover {
+    color: ${oc.indigo[6]};
+  }
+
+  &.delete {
+    &:hover {
+      color: ${oc.pink[6]};
+    }
+  }
+`;
+
+const Row = styled.div`
+  display: flex;
+  flex-direction: row;
+  flex: 1;
+  line-height: 2.5rem;
+  margin: 0 2rem;
+
+  .supi {
+    font-size: 1.1rem;
+    color: ${oc.gray[8]};
+    width: 260px;
+  }
+  /* What this allowance covers: "everything" for a subscriber's
+     catch-all, or the slice, DNN, PLMN and roaming state it is for. */
+  .scope {
+    display: block;
+    font-size: 0.78rem;
+    color: ${oc.gray[6]};
+  }
+  .quota-value {
+    font-size: 1rem;
+    color: ${oc.gray[6]};
+    width: 130px;
+  }
+  .used-value {
+    font-size: 1rem;
+    color: ${oc.gray[6]};
+    width: 190px;
+  }
+  /* Remaining is the number an operator scans for, so it carries the
+     emphasis and goes red once the cycle allowance is gone. */
+  .remaining-value {
+    font-size: 1rem;
+    font-weight: 600;
+    width: 130px;
+  }
+  .bar {
+    display: inline-block;
+    width: 64px;
+    height: 6px;
+    border-radius: 3px;
+    background: ${oc.gray[3]};
+    margin-left: 0.5rem;
+    vertical-align: middle;
+    overflow: hidden;
+  }
+  .bar > span {
+    display: block;
+    height: 100%;
+  }
+  .period-label {
+    font-size: 1rem;
+    color: ${oc.gray[6]};
+    width: 150px;
+  }
+  .renew-label {
+    font-size: 1rem;
+    color: ${oc.gray[6]};
+    width: 100px;
+  }
+  .action-label {
+    font-size: 1rem;
+    color: ${oc.gray[6]};
+    width: 160px;
+  }
+`;
+
+const SpinnerWrapper = styled.div`
+  position: absolute;
+  top: 0;
+  right: 0;
+  width: 4rem;
+  height: 100%;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+`;
+
+
+class Item extends Component {
+  static propTypes = {
+    chfSubscriber: PropTypes.shape({
+      supi: PropTypes.string,
+      bucketId: PropTypes.string,
+      scope: PropTypes.object,
+      priority: PropTypes.number,
+      quota: PropTypes.object,
+    }),
+    onEdit: PropTypes.func,
+    onDelete: PropTypes.func,
+  };
+
+  handleEdit = e => {
+    e.stopPropagation();
+    const { chfSubscriber, onEdit } = this.props;
+    onEdit(chfSubscriber.bucketId || chfSubscriber.supi);
+  };
+
+  handleDelete = e => {
+    e.stopPropagation();
+    const { chfSubscriber, onDelete } = this.props;
+    onDelete(chfSubscriber.bucketId || chfSubscriber.supi);
+  };
+
+  render() {
+    const { handleEdit, handleDelete } = this;
+    const { disabled, spinner, chfSubscriber } = this.props;
+    const quota = chfSubscriber.quota || {};
+
+    /* Resolve total bytes — support both new and legacy schemas */
+    const totalBytes = quota.totalQuotaBytes != null
+      ? quota.totalQuotaBytes
+      : ((quota.volumeUlBytes || 0) + (quota.volumeDlBytes || 0)) || null;
+
+    /* Cycle-to-date usage from the CHF-maintained counter. */
+    const usage = cycleUsage(chfSubscriber);
+    const exhausted = usage.provisioned > 0 && usage.remaining === 0;
+    const barColor = exhausted ? oc.red[6]
+                   : usage.pct >= 80 ? oc.orange[5]
+                   : oc.teal[6];
+
+    return (
+      <Card disabled={disabled} onClick={handleEdit}>
+        <Row>
+          <div className="supi">
+            {chfSubscriber.supi}
+            <span className="scope" title={
+                hasScope(chfSubscriber)
+                  ? `This allowance covers ${scopeLabel(chfSubscriber)}; ` +
+                    `priority ${chfSubscriber.priority || 0}`
+                  : 'Covers every session this subscriber makes'}>
+              {scopeLabel(chfSubscriber)}
+            </span>
+          </div>
+          <div className="quota-value">
+            {fmtVolume(totalBytes)}
+            {usage.topup > 0 && (
+              <span
+                title="Top-ups bought for this billing cycle (TMF654 topupBalance)"
+                style={{ color: oc.teal[7], fontSize: '0.85rem', marginLeft: '0.3rem' }}
+              >
+                +{fmtVolume(usage.topup)}
+              </span>
+            )}
+          </div>
+          <div className="used-value">
+            {fmtVolume(usage.consumed)}
+            <span className="bar">
+              <span style={{
+                width: `${usage.pct}%`,
+                background: barColor,
+              }} />
+            </span>
+          </div>
+          <div
+            className="remaining-value"
+            style={{ color: exhausted ? oc.red[7] : oc.gray[8] }}
+            title={usage.stale
+              ? 'This billing cycle has ended. Shown is what the next session '
+                + 'will be granted; the CHF opens the new cycle then.'
+              : undefined}
+          >
+            {fmtVolume(usage.remaining)}{usage.stale ? ' *' : ''}
+          </div>
+          <div className="period-label">{fmtPeriod(quota.validityPeriod, quota.validitySeconds)}</div>
+          <div className="renew-label">{quota.autoRenew ? 'Yes' : 'No'}</div>
+          <div className="action-label">{quota.finalUnitAction || '—'}</div>
+        </Row>
+        <div className="actions">
+          <Tooltip content="Edit" width="50px">
+            <CircleButton onClick={handleEdit}><EditIcon /></CircleButton>
+          </Tooltip>
+          <Tooltip content="Delete" width="60px">
+            <CircleButton className="delete" onClick={handleDelete}><DeleteIcon /></CircleButton>
+          </Tooltip>
+        </div>
+        {spinner && <SpinnerWrapper><Spinner sm /></SpinnerWrapper>}
+      </Card>
+    );
+  }
+}
+
+export default Item;
diff --git a/webui/src/components/ChfSubscriber/List.js b/webui/src/components/ChfSubscriber/List.js
new file mode 100644
index 000000000..8551d64d7
--- /dev/null
+++ b/webui/src/components/ChfSubscriber/List.js
@@ -0,0 +1,80 @@
+import PropTypes from 'prop-types';
+
+import styled from 'styled-components';
+import oc from 'open-color';
+import { media } from 'helpers/style-utils';
+
+import Item from './Item';
+
+const Wrapper = styled.div`
+  display: block;
+  margin: 2rem;
+
+  ${media.mobile`
+    margin: 0.5rem 0.25rem;
+  `}
+`;
+
+const Header = styled.div`
+  display: flex;
+  flex-direction: row;
+  flex: 1;
+  padding: 0.5rem 2.5rem;
+  border-bottom: 1px solid ${oc.gray[3]};
+  font-size: 0.85rem;
+  font-weight: bold;
+  color: ${oc.gray[6]};
+  text-transform: uppercase;
+
+  .col-supi       { width: 260px; }
+  .col-quota      { width: 130px; }
+  .col-used       { width: 190px; }
+  .col-remaining  { width: 130px; }
+  .col-period     { width: 150px; }
+  .col-renew      { width: 100px; }
+  .col-action     { width: 160px; }
+`;
+
+const propTypes = {
+  chfSubscribers: PropTypes.arrayOf(PropTypes.object),
+  deletedSupi: PropTypes.string,
+  onEdit: PropTypes.func,
+  onDelete: PropTypes.func,
+};
+
+/* Order comes from the server (?sort=supi); re-sorting here could only
+ * reorder within the current page, never across pages, so it is left out. */
+const List = ({ chfSubscribers, deletedSupi, onEdit, onDelete }) => {
+  const items = chfSubscribers
+    .map(sub => (
+      <Item
+        key={sub.supi}
+        chfSubscriber={sub}
+        disabled={deletedSupi === sub.supi}
+        spinner={deletedSupi === sub.supi}
+        onEdit={onEdit}
+        onDelete={onDelete}
+      />
+    ));
+
+  return (
+    <Wrapper>
+      {items.length > 0 && (
+        <Header>
+          <div className="col-supi">SUPI</div>
+          <div className="col-quota">Provisioned</div>
+          <div className="col-used">Used This Cycle</div>
+          <div className="col-remaining">Remaining</div>
+          <div className="col-period">Period</div>
+          <div className="col-renew">Auto-Renew</div>
+          <div className="col-action">Final Unit Action</div>
+        </Header>
+      )}
+      {items}
+    </Wrapper>
+  );
+};
+
+List.propTypes = propTypes;
+
+export default List;
