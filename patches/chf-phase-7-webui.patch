diff --git a/webui/server/tmf/account.js b/webui/server/tmf/account.js
new file mode 100644
index 000000000..fe94358eb
--- /dev/null
+++ b/webui/server/tmf/account.js
@@ -0,0 +1,173 @@
+/*
+ * TMF666 Account Management API v4 — BillingAccount.
+ *
+ *   GET    /accountManagement/v4/billingAccount[?fields&offset&limit&<attr>=]
+ *   GET    /accountManagement/v4/billingAccount/{id}
+ *   POST   /accountManagement/v4/billingAccount
+ *   PATCH  /accountManagement/v4/billingAccount/{id}   (JSON Merge Patch)
+ *   DELETE /accountManagement/v4/billingAccount/{id}
+ *
+ * A billing account groups the data buckets (SUPIs) that are charged
+ * together, and names the Individual(s) responsible for it through
+ * relatedParty.  Like the Individual it is a BSS record the CHF never reads.
+ *
+ * Copyright (C) 2026 by Rami Mohamed <ramrode@gmail.com>
+ */
+
+'use strict';
+
+const express = require('express');
+const crypto = require('crypto');
+const C = require('./common');
+
+const COLLECTION = 'billingAccount';
+
+const READ_ONLY = ['id', 'href', '@type', '@baseType', 'lastModified'];
+
+const FILTERABLE = {
+  name: 'name',
+  state: 'state',
+  accountType: 'accountType',
+  'relatedParty.id': 'relatedParty.id',
+};
+
+const STATES = ['active', 'suspended', 'closed'];
+const ACCOUNT_TYPES = ['prepaid', 'postpaid'];
+
+function validateRelatedParty(list) {
+  if (!Array.isArray(list))
+    throw new C.TmfError(400, 'Bad Request', "'relatedParty' must be an array");
+  list.forEach((p, i) => {
+    if (!C.isPlainObject(p) || typeof p.id !== 'string' || !p.id)
+      throw new C.TmfError(400, 'Bad Request',
+          `relatedParty[${i}] must be an object with a string 'id'`);
+  });
+}
+
+function validate(body) {
+  if (typeof body.name !== 'string' || !body.name.trim())
+    throw new C.TmfError(400, 'Bad Request', "'name' is required");
+  ['description', 'accountType', 'state'].forEach(a => {
+    if (body[a] !== undefined && typeof body[a] !== 'string')
+      throw new C.TmfError(400, 'Bad Request', `'${a}' must be a string`);
+  });
+  if (body.state !== undefined && STATES.indexOf(body.state) === -1)
+    throw new C.TmfError(400, 'Bad Request',
+        `'state' must be one of: ${STATES.join(', ')}`);
+  if (body.accountType !== undefined &&
+      ACCOUNT_TYPES.indexOf(body.accountType) === -1)
+    throw new C.TmfError(400, 'Bad Request',
+        `'accountType' must be one of: ${ACCOUNT_TYPES.join(', ')}`);
+  if (body.relatedParty !== undefined)
+    validateRelatedParty(body.relatedParty);
+}
+
+/* Persist only the reference fields, never a client-supplied href. */
+function normaliseRelatedParty(list) {
+  return (list || []).map(p => ({
+    id: p.id,
+    role: typeof p.role === 'string' ? p.role : 'owner',
+    '@referredType': 'Individual',
+  }));
+}
+
+function pick(body) {
+  const out = {};
+  ['name', 'description', 'accountType', 'state'].forEach(a => {
+    if (body[a] !== undefined) out[a] = body[a];
+  });
+  if (body.relatedParty !== undefined)
+    out.relatedParty = normaliseRelatedParty(body.relatedParty);
+  return out;
+}
+
+function represent(req, doc) {
+  const partyBase =
+    `${req.protocol}://${req.get('host')}${req.baseUrl}`
+      .replace(/\/accountManagement\/v4$/, '/partyManagement/v4');
+  return Object.assign(
+    { id: doc.id, href: C.hrefFor(req, COLLECTION, doc.id),
+      '@type': 'BillingAccount' },
+    pick(doc),
+    { relatedParty: (doc.relatedParty || []).map(p => Object.assign({}, p, {
+        href: `${partyBase}/individual/${encodeURIComponent(p.id)}` })) },
+    doc.lastModified ? { lastModified: doc.lastModified } : {});
+}
+
+/* Every referenced Individual must exist; a dangling reference is a 400. */
+async function assertPartiesExist(repos, relatedParty) {
+  for (const p of relatedParty || []) {
+    if (!await repos.individual.get(p.id))
+      throw new C.TmfError(400, 'Bad Request',
+          `relatedParty '${p.id}' does not exist`);
+  }
+}
+
+/*
+ * @param repos.billingAccount   repository keyed by 'id'
+ * @param repos.individual       to validate relatedParty references
+ * @param repos.bucket           to refuse deleting an account with buckets
+ */
+function createAccountRouter(repos) {
+  const router = express.Router();
+
+  router.get(`/${COLLECTION}`, C.handler(async (req, res) => {
+    const { offset, limit } = C.paging(req.query);
+    const filter = C.buildFilter(req.query, FILTERABLE);
+    const { items, total } =
+      await repos.billingAccount.list(filter, offset, limit);
+    return C.sendList(res,
+        items.map(d => C.project(represent(req, d), req.query.fields)), total);
+  }));
+
+  router.get(`/${COLLECTION}/:id`, C.handler(async (req, res) => {
+    const doc = await repos.billingAccount.get(req.params.id);
+    if (!doc) throw new C.TmfError(404, 'Not Found', 'Billing account not found');
+    return res.json(C.project(represent(req, doc), req.query.fields));
+  }));
+
+  router.post(`/${COLLECTION}`, C.handler(async (req, res) => {
+    const body = C.requireObjectBody(req);
+    C.rejectReadOnly(body, READ_ONLY);
+    validate(body);
+    const doc = Object.assign(pick(body), {
+      id: crypto.randomUUID(),
+      state: body.state || 'active',
+      accountType: body.accountType || 'prepaid',
+      relatedParty: normaliseRelatedParty(body.relatedParty),
+      lastModified: new Date().toISOString(),
+    });
+    await assertPartiesExist(repos, doc.relatedParty);
+    const created = await repos.billingAccount.create(doc);
+    return C.sendCreated(res, represent(req, created));
+  }));
+
+  router.patch(`/${COLLECTION}/:id`, C.handler(async (req, res) => {
+    const patch = C.requireObjectBody(req);
+    C.rejectReadOnly(patch, READ_ONLY);
+    const current = await repos.billingAccount.get(req.params.id);
+    if (!current)
+      throw new C.TmfError(404, 'Not Found', 'Billing account not found');
+
+    const merged = C.mergePatch(pick(current), patch);
+    validate(merged);
+    const next = Object.assign(pick(merged), {
+      id: current.id, lastModified: new Date().toISOString() });
+    await assertPartiesExist(repos, next.relatedParty);
+    const saved = await repos.billingAccount.replace(req.params.id, next);
+    return res.json(represent(req, saved));
+  }));
+
+  router.delete(`/${COLLECTION}/:id`, C.handler(async (req, res) => {
+    if (await repos.bucket.exists({ billingAccountId: req.params.id }))
+      throw new C.TmfError(409, 'Conflict',
+          'Billing account still has buckets; move or delete them first');
+    if (!await repos.billingAccount.remove(req.params.id))
+      throw new C.TmfError(404, 'Not Found', 'Billing account not found');
+    return res.status(204).end();
+  }));
+
+  return router;
+}
+
+module.exports = { createAccountRouter, validate };
diff --git a/webui/server/tmf/balance.js b/webui/server/tmf/balance.js
new file mode 100644
index 000000000..d87f56426
--- /dev/null
+++ b/webui/server/tmf/balance.js
@@ -0,0 +1,376 @@
+/*
+ * TMF654 Prepay Balance Management API v4 — Bucket and TopupBalance.
+ *
+ *   GET    /prepayBalanceManagement/v4/bucket[?fields&offset&limit&id=&partyAccount.id=]
+ *   GET    /prepayBalanceManagement/v4/bucket/{supi}
+ *   POST   /prepayBalanceManagement/v4/bucket            provision a SUPI
+ *   PATCH  /prepayBalanceManagement/v4/bucket/{supi}     change the plan
+ *   DELETE /prepayBalanceManagement/v4/bucket/{supi}     deprovision
+ *
+ *   GET    /prepayBalanceManagement/v4/topupBalance[?bucket.id=&status=]
+ *   GET    /prepayBalanceManagement/v4/topupBalance/{id}
+ *   POST   /prepayBalanceManagement/v4/topupBalance      add data to a bucket
+ *
+ * Buckets are stored as CHF subscriber documents (chf.subscribers) - the
+ * same documents the CHF NF enforces against - so a change made here takes
+ * effect on the subscriber's next usage report.  See bucket-map.js for the
+ * rules that keep the published balance equal to what the CHF grants.
+ *
+ * Copyright (C) 2026 by Rami Mohamed <ramrode@gmail.com>
+ */
+
+'use strict';
+
+const express = require('express');
+const crypto = require('crypto');
+
+/* A SUPI, or a SUPI with the suffix a scoped bucket is given. */
+const BUCKET_ID_RE = /^imsi-\d{15}(-[0-9a-f]{12})?$/;
+const C = require('./common');
+const B = require('./bucket-map');
+
+const BUCKET_FILTERABLE = {
+  id: 'bucketId',
+  /* A subscriber's buckets: ?logicalResource.id=imsi-<15 digits> */
+  'logicalResource.id': 'supi',
+  'partyAccount.id': 'billingAccountId',
+  'scope.dnn': 'scope.dnn',
+  'scope.roaming': 'scope.roaming',
+  'scope.sNSSAI.sst': 'scope.snssai.sst',
+  'partyAccount.id': 'billingAccountId',
+};
+
+const TOPUP_FILTERABLE = {
+  'bucket.id': 'bucket.id',
+  status: 'status',
+};
+
+const TOPUP_READ_ONLY = ['id', 'href', '@type', '@baseType', 'status',
+  'requestedDate', 'confirmationDate', 'reactivated'];
+
+/* Idempotency-Key values are opaque to us, but bound them. */
+const IDEMPOTENCY_KEY_RE = /^[\x21-\x7e]{1,128}$/;
+
+async function assertAccountExists(repos, id) {
+  if (!await repos.billingAccount.get(id))
+    throw new C.TmfError(400, 'Bad Request',
+        `partyAccount '${id}' does not exist`);
+}
+
+/* {'quota.x': v} -> {quota: {x: v}} for creating a document. */
+function nest(setMap) {
+  const out = {};
+  Object.keys(setMap).forEach(path => {
+    const [head, tail] = path.split('.');
+    out[head] = out[head] || {};
+    out[head][tail] = setMap[path];
+  });
+  return out;
+}
+
+function representTopup(req, t) {
+  const out = {
+    id: t.id,
+    href: C.hrefFor(req, 'topupBalance', t.id),
+    '@type': 'TopupBalance',
+    status: t.status,
+    requestedDate: t.requestedDate,
+    amount: { amount: t.amount, units: 'octet' },
+    bucket: { id: t.bucket.id, href: C.hrefFor(req, 'bucket', t.bucket.id),
+              '@referredType': 'Bucket' },
+  };
+  if (t.confirmationDate) out.confirmationDate = t.confirmationDate;
+  if (t.reason) out.reason = t.reason;
+  if (t.statusReason) out.statusReason = t.statusReason;
+  if (t.reactivated !== undefined) out.reactivated = t.reactivated;
+  return out;
+}
+
+/*
+ * @param repos.bucket          keyed by 'bucketId' (chf.subscribers)
+ * @param repos.billingAccount  to validate partyAccount references
+ * @param repos.topupBalance    keyed by 'id' (the top-up audit trail)
+ * @param clock                 () => epoch ms; injectable for tests
+ */
+/*
+ * A bucket by id.
+ *
+ * A document written before buckets existed has no bucketId: it is the
+ * subscriber's catch-all and is addressed by SUPI.  The first time one is
+ * touched its id is written, so every later read and write goes through
+ * the same field and no other code needs the special case.
+ */
+async function getBucket(repos, id) {
+  const direct = await repos.bucket.get(id);
+  if (direct) return direct;
+
+  const { items } = await repos.bucket.list({ supi: id }, 0, 2);
+  const legacy = items.filter(d => !d.bucketId);
+  if (!legacy.length) return null;
+
+  await repos.bucket.update({ supi: id }, { $set: { bucketId: id } });
+  return Object.assign({}, legacy[0], { bucketId: id });
+}
+
+/*
+ * Tell the CHF that a live session should hear about this now.
+ *
+ * The CHF polls chf.notifications and turns each row into a TS 32.291
+ * ChargingNotify to the sessions drawing from the bucket, so a top-up or a
+ * bar reaches a session that is up instead of waiting for its next usage
+ * report - up to five minutes with the shipped grant caps, and the full
+ * five for a session that is idle.
+ *
+ * Best-effort on purpose.  The balance change is already committed and is
+ * what actually counts; the notification only decides whether it lands
+ * now or at the next report.  A failure here must not turn a successful
+ * top-up into an error for the caller, so it is logged and swallowed.
+ */
+async function notifyChf(repos, supi, bucketId, type, reason) {
+  if (!repos.notification) return;   /* not wired (tests, older deploys) */
+  try {
+    const row = { id: crypto.randomUUID(), supi, type,
+                  createdAt: new Date() };
+    if (bucketId && bucketId !== supi) row.bucketId = bucketId;
+    if (reason) row.reason = reason;
+    await repos.notification.create(row);
+  } catch (err) {
+    // eslint-disable-next-line no-console
+    console.error('[tmf] could not queue a ChargingNotify:',
+        err && err.message ? err.message : err);
+  }
+}
+
+function randomSuffix() {
+  return crypto.randomBytes(6).toString('hex');
+}
+
+function createBalanceRouter(repos, clock = Date.now) {
+  const router = express.Router();
+
+  /* ---------------- Bucket ---------------- */
+
+  router.get('/bucket', C.handler(async (req, res) => {
+    const { offset, limit } = C.paging(req.query);
+    const filter = C.buildFilter(req.query, BUCKET_FILTERABLE);
+    const now = clock();
+    const { items, total } = await repos.bucket.list(filter, offset, limit);
+    return C.sendList(res, items.map(d =>
+        C.project(B.toBucket(req, d, now), req.query.fields)), total);
+  }));
+
+  router.get('/bucket/:id', C.handler(async (req, res) => {
+    const doc = await getBucket(repos, req.params.id);
+    if (!doc) throw new C.TmfError(404, 'Not Found', 'Bucket not found');
+    return res.json(C.project(B.toBucket(req, doc, clock()), req.query.fields));
+  }));
+
+  router.post('/bucket', C.handler(async (req, res) => {
+    const body = C.requireObjectBody(req);
+    C.rejectReadOnly(body, B.READ_ONLY);
+
+    const supi = B.supiFromLogicalResource(body);
+    const scope = B.scopeToStored(body.scope);
+    const doc = Object.assign({ supi }, nest(B.planToQuotaSet(body, null)));
+
+    /*
+     * The catch-all keeps the SUPI as its id, so a subscriber with one
+     * plan is addressed exactly as before; a scoped bucket gets its own.
+     * The unique index on bucketId is what stops a second catch-all.
+     */
+    doc.bucketId = scope ? `${supi}-${randomSuffix()}` : supi;
+    if (scope) doc.scope = scope;
+    doc.priority = B.priorityOf(body.priority);
+
+    if (body.partyAccount !== undefined && body.partyAccount !== null) {
+      doc.billingAccountId = B.partyAccountId(body.partyAccount);
+      await assertAccountExists(repos, doc.billingAccountId);
+    }
+
+    /* A duplicate SUPI surfaces as E11000 and is mapped to 409 by handler. */
+    const created = await repos.bucket.create(doc);
+    return C.sendCreated(res, B.toBucket(req, created, clock()));
+  }));
+
+  router.patch('/bucket/:id', C.handler(async (req, res) => {
+    const patch = C.requireObjectBody(req);
+    C.rejectReadOnly(patch, B.READ_ONLY.concat(['logicalResource']));
+    const unknown = Object.keys(patch).filter(k => B.PATCHABLE.indexOf(k) === -1);
+    if (unknown.length)
+      throw new C.TmfError(400, 'Bad Request',
+          `Attribute(s) cannot be patched: ${unknown.join(', ')}`);
+
+    const current = await getBucket(repos, req.params.id);
+    if (!current) throw new C.TmfError(404, 'Not Found', 'Bucket not found');
+
+    /*
+     * Only quota.* and billingAccountId are ever written here - never
+     * usage.*, which is the CHF's live counter.  Each path is $set on its
+     * own rather than replacing the document, so a usage report the CHF
+     * records while this request runs is not lost.
+     */
+    const update = { $set: B.planToQuotaSet(patch, current.quota || {}) };
+
+    /* Scope and priority decide which sessions this bucket serves; they
+     * are written whole, so clearing a dimension means sending the scope
+     * without it. */
+    if (patch.scope !== undefined) {
+      const scope = B.scopeToStored(patch.scope);
+      if (scope) update.$set.scope = scope;
+      else update.$unset = Object.assign(update.$unset || {}, { scope: '' });
+    }
+    if (patch.priority !== undefined)
+      update.$set.priority = B.priorityOf(patch.priority);
+
+    if (patch.partyAccount === null) {
+      update.$unset = { billingAccountId: '' };
+    } else if (patch.partyAccount !== undefined) {
+      const id = B.partyAccountId(patch.partyAccount);
+      await assertAccountExists(repos, id);
+      update.$set.billingAccountId = id;
+    }
+
+    if (!Object.keys(update.$set).length) delete update.$set;
+    if (update.$set || update.$unset) {
+      if (!await repos.bucket.update(
+              { bucketId: B.bucketId(current) }, update))
+        throw new C.TmfError(404, 'Not Found', 'Bucket not found');
+    }
+    const saved = await getBucket(repos, req.params.id);
+    /* The plan moved: more quota, less, or a different scope.  Either way
+     * a session on this bucket should be re-authorised against it now. */
+    await notifyChf(repos, current.supi, B.bucketId(current),
+        'REAUTHORIZATION', 'plan-change');
+    return res.json(B.toBucket(req, saved, clock()));
+  }));
+
+  router.delete('/bucket/:id', C.handler(async (req, res) => {
+    /* Read it first: once it is gone there is nothing left to say whose
+     * sessions this was, and the CHF matches on SUPI. */
+    const doomed = await getBucket(repos, req.params.id);
+    if (!await repos.bucket.remove(req.params.id))
+      throw new C.TmfError(404, 'Not Found', 'Bucket not found');
+    if (doomed)
+      await notifyChf(repos, doomed.supi, B.bucketId(doomed),
+          'ABORT_CHARGING', 'deprovisioned');
+    return res.status(204).end();
+  }));
+
+  /* ---------------- TopupBalance ---------------- */
+
+  router.get('/topupBalance', C.handler(async (req, res) => {
+    const { offset, limit } = C.paging(req.query);
+    const filter = C.buildFilter(req.query, TOPUP_FILTERABLE);
+    const { items, total } =
+      await repos.topupBalance.list(filter, offset, limit);
+    return C.sendList(res, items.map(t =>
+        C.project(representTopup(req, t), req.query.fields)), total);
+  }));
+
+  router.get('/topupBalance/:id', C.handler(async (req, res) => {
+    const t = await repos.topupBalance.get(req.params.id);
+    if (!t) throw new C.TmfError(404, 'Not Found', 'TopupBalance not found');
+    return res.json(C.project(representTopup(req, t), req.query.fields));
+  }));
+
+  router.post('/topupBalance', C.handler(async (req, res) => {
+    const body = C.requireObjectBody(req);
+    C.rejectReadOnly(body, TOPUP_READ_ONLY);
+
+    /* The target is a bucket id: a SUPI for a subscriber's catch-all, or
+     * the id of one of its scoped buckets. */
+    const supi = C.isPlainObject(body.bucket) && body.bucket.id;
+    if (typeof supi !== 'string' || !BUCKET_ID_RE.test(supi))
+      throw new C.TmfError(400, 'Bad Request',
+          "'bucket.id' must be a bucket id (a SUPI, or a scoped bucket's id)");
+    const bytes = B.quantityToOctets(body.amount, 'amount', { allowZero: false });
+    if (body.reason !== undefined && typeof body.reason !== 'string')
+      throw new C.TmfError(400, 'Bad Request', "'reason' must be a string");
+
+    /* Resolve first, so a document written before buckets existed gets its
+     * id written and the conditional update below has something unique to
+     * match on. */
+    await getBucket(repos, supi);
+
+    const key = req.get('Idempotency-Key');
+    if (key !== undefined && !IDEMPOTENCY_KEY_RE.test(key))
+      throw new C.TmfError(400, 'Bad Request',
+          'Idempotency-Key must be 1-128 printable ASCII characters');
+
+    /* A repeated request returns the original outcome, not a second credit. */
+    if (key) {
+      const prior = await repos.topupBalance.list({ idempotencyKey: key }, 0, 1);
+      if (prior.items.length)
+        return res.status(200).json(representTopup(req, prior.items[0]));
+    }
+
+    const target = await repos.bucket.get(supi);
+    if (!target)
+      throw new C.TmfError(404, 'Not Found', 'Bucket not found');
+
+    /*
+     * Record the task BEFORE touching the balance, so every attempt leaves
+     * an audit record even if a later step fails.  With an Idempotency-Key
+     * this insert is also the lock: the key is unique, so a concurrent
+     * duplicate collides here and returns the original task instead of
+     * crediting the subscriber twice.
+     */
+    const now = clock();
+    const task = {
+      id: crypto.randomUUID(),
+      status: 'inProgress',
+      requestedDate: new Date(now).toISOString(),
+      amount: bytes,
+      bucket: { id: supi },
+    };
+    if (body.reason) task.reason = body.reason;
+    if (key) task.idempotencyKey = key;
+
+    try {
+      await repos.topupBalance.create(task);
+    } catch (err) {
+      if (key && err && err.code === 11000) {
+        const prior = await repos.topupBalance.list({ idempotencyKey: key }, 0, 1);
+        if (prior.items.length)
+          return res.status(200).json(representTopup(req, prior.items[0]));
+      }
+      throw err;
+    }
+
+    const result = await B.applyTopup(repos.bucket, supi, bytes, now);
+    const finish = async fields => {
+      await repos.topupBalance.update({ id: task.id }, { $set: fields });
+      return Object.assign(task, fields);
+    };
+
+    if (result.outcome === 'applied') {
+      await finish({ status: 'completed', reactivated: result.reactivated,
+                     confirmationDate: new Date(clock()).toISOString() });
+      /* The subscriber has data again - reach any session that is up,
+       * including one already stopped on a FinalUnitIndication. */
+      await notifyChf(repos, target.supi, supi, 'REAUTHORIZATION', 'topup');
+      return C.sendCreated(res, representTopup(req, task));
+    }
+
+    if (result.outcome === 'notFound') {
+      await finish({ status: 'failed', statusReason: 'Bucket not found' });
+      throw new C.TmfError(404, 'Not Found', 'Bucket not found');
+    }
+
+    await finish({ status: 'failed',
+                   statusReason: 'Billing cycle changed concurrently' });
+    throw new C.TmfError(409, 'Conflict',
+        'The billing cycle kept changing while applying the top-up; retry');
+  }));
+
+  /* A top-up is an immutable record of something that happened. */
+  router.all('/topupBalance/:id', (req, res) => {
+    res.set('Allow', 'GET');
+    return C.sendError(res, 405, 'Method Not Allowed',
+        'TopupBalance records cannot be modified or deleted');
+  });
+
+  return router;
+}
+
+module.exports = { createBalanceRouter };
diff --git a/webui/server/tmf/bucket-map.js b/webui/server/tmf/bucket-map.js
new file mode 100644
index 000000000..01e078b8c
--- /dev/null
+++ b/webui/server/tmf/bucket-map.js
@@ -0,0 +1,424 @@
+/*
+ * Mapping between a CHF subscriber document (chf.subscribers) and a TMF654
+ * Bucket, plus the top-up rule.  Pure except applyTopup, which only touches
+ * storage through a repository - so all of it is unit-testable.
+ *
+ * A Bucket here is one SUPI's data balance.  It is published as
+ * @type "ChfDataBucket" / @baseType "Bucket" (the TMF630 polymorphism
+ * pattern), carrying the standard Bucket attributes plus the plan attributes
+ * TMF654 leaves to extensions.
+ *
+ * Money rules, which must agree with the CHF NF (src/chf):
+ *
+ *  - remainingValue is what the CHF would grant at the subscriber's NEXT
+ *    session, derived with the same cycle rules as chf_quota_period_expired()
+ *    and chf_quota_remaining().  An expired cycle that auto-renews therefore
+ *    shows the full allowance; one that does not shows zero.
+ *
+ *  - usage.* (consumedBytes, periodStart, topupBytes) is the CHF's live
+ *    billing counter.  A Bucket PATCH never writes it.  The only API path that
+ *    does is a top-up, and only through an atomic conditional update.
+ *
+ * Copyright (C) 2026 by Rami Mohamed <ramrode@gmail.com>
+ */
+
+'use strict';
+
+const C = require('./common');
+/* cycleState / nextGrant live in the helper the CHF Quota page also uses, so
+ * the page and this API cannot publish different balances. */
+const {
+  BYTES_PER_MB, BYTES_PER_GB, BYTES_PER_TB, PERIOD_SECONDS,
+  cycleState, nextGrant,
+} = require('../../src/helpers/chf-quota-convert');
+
+const SUPI_RE = /^imsi-\d{15}$/;
+const PERIODS = ['daily', 'weekly', 'monthly', 'custom'];
+const FINAL_UNIT_ACTIONS = ['TERMINATE', 'REDIRECT', 'RESTRICT_ACCESS'];
+
+/* Server-owned Bucket attributes; setting any of them is a 400. */
+const READ_ONLY = ['id', 'href', '@type', '@baseType', '@schemaLocation',
+  'name', 'status', 'usageType', 'isShared', 'remainingValue', 'consumedValue',
+  'topupValue', 'validFor'];
+
+/* Writable plan attributes on PATCH.  logicalResource is fixed at creation. */
+const PATCHABLE = ['allowance', 'validityPeriod', 'validitySeconds',
+    'scope', 'priority',
+  'autoRenew', 'finalUnitAction', 'partyAccount'];
+
+/* Largest byte count a JSON number carries exactly. */
+const MAX_OCTETS = Number.MAX_SAFE_INTEGER;
+
+const UNIT_FACTORS = {
+  octet: 1, octets: 1, byte: 1, bytes: 1, b: 1,
+  mb: BYTES_PER_MB, gb: BYTES_PER_GB, tb: BYTES_PER_TB,
+};
+
+/*
+ * TMF Quantity {amount, units} -> integer octets.  Binary multiples (1 GB =
+ * 2^30), matching the CHF Quota page.  Responses always use "octet".
+ */
+function quantityToOctets(q, attr, { allowZero = true } = {}) {
+  if (!C.isPlainObject(q))
+    throw new C.TmfError(400, 'Bad Request',
+        `'${attr}' must be a Quantity {amount, units}`);
+  const factor = UNIT_FACTORS[String(q.units || 'octet').toLowerCase()];
+  if (!factor)
+    throw new C.TmfError(400, 'Bad Request',
+        `'${attr}.units' must be one of: octet, MB, GB, TB`);
+  const amount = Number(q.amount);
+  if (!Number.isFinite(amount) || amount < 0 || (!allowZero && amount === 0))
+    throw new C.TmfError(400, 'Bad Request',
+        `'${attr}.amount' must be a ${allowZero ? 'non-negative' : 'positive'} number`);
+  const octets = Math.round(amount * factor);
+  if (octets > MAX_OCTETS)
+    throw new C.TmfError(400, 'Bad Request', `'${attr}' is too large`);
+  return octets;
+}
+
+const octets = amount => ({ amount, units: 'octet' });
+
+/* ------------------------------------------------------------------ */
+/* Representation                                                       */
+/* ------------------------------------------------------------------ */
+
+function toBucket(req, doc, now) {
+  const quota = doc.quota || {};
+  const usage = doc.usage || {};
+  const state = cycleState(doc, now);
+  const accountBase =
+    `${req.protocol}://${req.get('host')}${req.baseUrl}`
+      .replace(/\/prepayBalanceManagement\/v4$/, '/accountManagement/v4');
+
+  const id = bucketId(doc);
+  const bucket = {
+    id,
+    href: C.hrefFor(req, 'bucket', id),
+    '@type': 'ChfDataBucket',
+    '@baseType': 'Bucket',
+    name: `Data allowance ${doc.supi}${scopeSuffix(doc)}`,
+    usageType: 'data',
+    isShared: false,
+    status: state,
+    remainingValue: octets(nextGrant(doc, now)),
+    logicalResource: [{
+      id: doc.supi, value: doc.supi, '@referredType': 'SUPI' }],
+
+    /* Extension attributes: the plan behind the balance. */
+    allowance: octets(Number(quota.totalQuotaBytes) || 0),
+    consumedValue: octets(state === 'active'
+        ? Number(usage.consumedBytes) || 0 : 0),
+    topupValue: octets(state === 'active'
+        ? Number(usage.topupBytes) || 0 : 0),
+    validityPeriod: quota.validityPeriod || 'monthly',
+    validitySeconds: Number(quota.validitySeconds) || 0,
+    autoRenew: quota.autoRenew === true,
+    finalUnitAction: quota.finalUnitAction || 'TERMINATE',
+
+    /* What this allowance covers, and which bucket wins when several do.
+     * An absent member is open. */
+    scope: toScope(doc),
+    priority: Number(doc.priority) || 0,
+  };
+
+  if (state !== 'notStarted') {
+    const start = new Date(usage.periodStart);
+    bucket.validFor = { startDateTime: start.toISOString() };
+    if (bucket.validitySeconds > 0)
+      bucket.validFor.endDateTime =
+        new Date(start.getTime() + bucket.validitySeconds * 1000).toISOString();
+  }
+
+  if (doc.billingAccountId)
+    bucket.partyAccount = {
+      id: doc.billingAccountId,
+      href: `${accountBase}/billingAccount/${encodeURIComponent(doc.billingAccountId)}`,
+      '@referredType': 'BillingAccount',
+    };
+
+  return bucket;
+}
+
+/* ------------------------------------------------------------------ */
+/* Bucket identity and scope                                            */
+/* ------------------------------------------------------------------ */
+
+const ROAMING_STATES = ['home', 'inBound', 'outBound'];
+const SD_RE = /^[0-9a-fA-F]{6}$/;
+const PLMN_RE = /^\d{3}-\d{2,3}$/;
+const DNN_RE = /^[A-Za-z0-9][A-Za-z0-9.\-]{0,99}$/;
+
+/* The catch-all bucket is addressed by its SUPI, as it was before buckets
+ * existed; a scoped one carries its own id. */
+function bucketId(doc) {
+  return doc.bucketId || doc.supi;
+}
+
+function hasScope(doc) {
+  const sc = doc.scope || {};
+  return !!(sc.dnn || sc.hplmn || sc.roaming ||
+      (sc.snssai && sc.snssai.sst !== undefined && sc.snssai.sst !== null));
+}
+
+/* Stored scope -> the API shape, leaving out what is open. */
+function toScope(doc) {
+  const sc = doc.scope || {};
+  const out = {};
+  if (sc.snssai && sc.snssai.sst !== undefined && sc.snssai.sst !== null) {
+    out.sNSSAI = { sst: Number(sc.snssai.sst) };
+    if (sc.snssai.sd) out.sNSSAI.sd = sc.snssai.sd;
+  }
+  if (sc.dnn) out.dnn = sc.dnn;
+  if (sc.hplmn) out.hPlmnId = plmnToObject(sc.hplmn);
+  if (sc.roaming) out.roaming = sc.roaming;
+  return out;
+}
+
+function plmnToObject(str) {
+  const [mcc, mnc] = String(str).split('-');
+  return { mcc, mnc };
+}
+
+/* A short human tag for the bucket name: "(slice 1, dnn ims)". */
+function scopeSuffix(doc) {
+  const sc = toScope(doc);
+  const parts = [];
+  if (sc.sNSSAI)
+    parts.push(`slice ${sc.sNSSAI.sst}${sc.sNSSAI.sd ? '/' + sc.sNSSAI.sd : ''}`);
+  if (sc.dnn) parts.push(`dnn ${sc.dnn}`);
+  if (sc.hPlmnId) parts.push(`plmn ${sc.hPlmnId.mcc}-${sc.hPlmnId.mnc}`);
+  if (sc.roaming) parts.push(sc.roaming);
+  return parts.length ? ` (${parts.join(', ')})` : '';
+}
+
+/*
+ * Request scope -> stored scope.  Everything is optional; what is left
+ * out stays open.  Returns null when the request names no dimension,
+ * which makes the bucket the subscriber's catch-all.
+ */
+function scopeToStored(value) {
+  if (value === undefined || value === null) return null;
+  if (!C.isPlainObject(value))
+    throw new C.TmfError(400, 'Bad Request', "'scope' must be an object");
+
+  const known = ['sNSSAI', 'dnn', 'hPlmnId', 'roaming'];
+  const unknown = Object.keys(value).filter(k => known.indexOf(k) === -1);
+  if (unknown.length)
+    throw new C.TmfError(400, 'Bad Request',
+        `Unknown scope attribute(s): ${unknown.join(', ')}`);
+
+  const stored = {};
+
+  if (value.sNSSAI !== undefined && value.sNSSAI !== null) {
+    const s = value.sNSSAI;
+    if (!C.isPlainObject(s) || !Number.isInteger(s.sst) ||
+        s.sst < 0 || s.sst > 255)
+      throw new C.TmfError(400, 'Bad Request',
+          "'scope.sNSSAI.sst' must be an integer between 0 and 255");
+    stored.snssai = { sst: s.sst };
+    if (s.sd !== undefined && s.sd !== null) {
+      if (typeof s.sd !== 'string' || !SD_RE.test(s.sd))
+        throw new C.TmfError(400, 'Bad Request',
+            "'scope.sNSSAI.sd' must be 6 hex digits");
+      stored.snssai.sd = s.sd.toLowerCase();
+    }
+  }
+
+  if (value.dnn !== undefined && value.dnn !== null) {
+    if (typeof value.dnn !== 'string' || !DNN_RE.test(value.dnn))
+      throw new C.TmfError(400, 'Bad Request', "'scope.dnn' is not a DNN");
+    stored.dnn = value.dnn;
+  }
+
+  if (value.hPlmnId !== undefined && value.hPlmnId !== null) {
+    const p = value.hPlmnId;
+    if (!C.isPlainObject(p) || typeof p.mcc !== 'string' ||
+        typeof p.mnc !== 'string' || !PLMN_RE.test(`${p.mcc}-${p.mnc}`))
+      throw new C.TmfError(400, 'Bad Request',
+          "'scope.hPlmnId' must be { mcc: '3 digits', mnc: '2-3 digits' }");
+    stored.hplmn = `${p.mcc}-${p.mnc}`;
+  }
+
+  if (value.roaming !== undefined && value.roaming !== null) {
+    if (ROAMING_STATES.indexOf(value.roaming) === -1)
+      throw new C.TmfError(400, 'Bad Request',
+          `'scope.roaming' must be one of: ${ROAMING_STATES.join(', ')}`);
+    stored.roaming = value.roaming;
+  }
+
+  return Object.keys(stored).length ? stored : null;
+}
+
+/* Priority: an integer, higher wins. */
+function priorityOf(value) {
+  if (value === undefined || value === null) return 0;
+  if (!Number.isInteger(value))
+    throw new C.TmfError(400, 'Bad Request', "'priority' must be an integer");
+  return value;
+}
+
+/* ------------------------------------------------------------------ */
+/* Plan attributes -> quota.* storage                                   */
+/* ------------------------------------------------------------------ */
+
+/*
+ * Plan attributes -> the quota.* storage paths the CHF reads, as a $set map.
+ *
+ * On create every path is written, with defaults for what the request omits.
+ * On PATCH only the paths the request names are written.  That distinction
+ * matters: the CHF treats an ABSENT autoRenew as "no renewal", so filling in
+ * defaults on a PATCH that only changed, say, finalUnitAction would silently
+ * switch renewal on for a document that never had the field.
+ *
+ * @param body     the request body (plan attributes)
+ * @param stored   the stored quota sub-document (PATCH) or null (create)
+ * @returns        { 'quota.totalQuotaBytes': n, ... }
+ */
+function planToQuotaSet(body, stored) {
+  const create = !stored;
+  const set = {};
+  const put = (attr, value) => { set[`quota.${attr}`] = value; };
+
+  if (body.allowance !== undefined)
+    put('totalQuotaBytes', quantityToOctets(body.allowance, 'allowance'));
+  else if (create)
+    throw new C.TmfError(400, 'Bad Request', "'allowance' is required");
+
+  /* validityPeriod and validitySeconds are resolved together: a preset
+   * period dictates the seconds, and only 'custom' takes them from the
+   * request. */
+  if (create || body.validityPeriod !== undefined ||
+      body.validitySeconds !== undefined) {
+    const period = body.validityPeriod !== undefined ? body.validityPeriod
+      : (stored && stored.validityPeriod) || 'monthly';
+    if (PERIODS.indexOf(period) === -1)
+      throw new C.TmfError(400, 'Bad Request',
+          `'validityPeriod' must be one of: ${PERIODS.join(', ')}`);
+
+    let seconds;
+    if (period === 'custom') {
+      seconds = body.validitySeconds !== undefined
+        ? Number(body.validitySeconds)
+        : Number(stored && stored.validitySeconds);
+      if (!Number.isInteger(seconds) || seconds <= 0)
+        throw new C.TmfError(400, 'Bad Request',
+            "A 'custom' validityPeriod requires a positive integer 'validitySeconds'");
+    } else {
+      /* Presets are authoritative; a stray validitySeconds is ignored, as
+       * the CHF Quota page does. */
+      seconds = PERIOD_SECONDS[period];
+    }
+    put('validityPeriod', period);
+    put('validitySeconds', seconds);
+  }
+
+  if (body.autoRenew !== undefined) {
+    if (typeof body.autoRenew !== 'boolean')
+      throw new C.TmfError(400, 'Bad Request', "'autoRenew' must be a boolean");
+    put('autoRenew', body.autoRenew);
+  } else if (create) {
+    put('autoRenew', true);
+  }
+
+  if (body.finalUnitAction !== undefined) {
+    if (FINAL_UNIT_ACTIONS.indexOf(body.finalUnitAction) === -1)
+      throw new C.TmfError(400, 'Bad Request',
+          `'finalUnitAction' must be one of: ${FINAL_UNIT_ACTIONS.join(', ')}`);
+    put('finalUnitAction', body.finalUnitAction);
+  } else if (create) {
+    put('finalUnitAction', 'TERMINATE');
+  }
+
+  return set;
+}
+
+/* The SUPI a new bucket is for, taken from logicalResource. */
+function supiFromLogicalResource(body) {
+  const lr = body.logicalResource;
+  const first = Array.isArray(lr) && lr.length ? lr[0] : null;
+  const supi = first && (first.id || first.value);
+  if (typeof supi !== 'string' || !SUPI_RE.test(supi))
+    throw new C.TmfError(400, 'Bad Request',
+        "'logicalResource[0].id' must be a SUPI of the form imsi-<15 digits>");
+  return supi;
+}
+
+/* partyAccount -> billing account id; null clears the link. */
+function partyAccountId(value) {
+  if (value === null) return null;
+  if (!C.isPlainObject(value) || typeof value.id !== 'string' || !value.id)
+    throw new C.TmfError(400, 'Bad Request',
+        "'partyAccount' must be an object with a string 'id'");
+  return value.id;
+}
+
+/* ------------------------------------------------------------------ */
+/* Top-up                                                               */
+/* ------------------------------------------------------------------ */
+
+const TOPUP_ATTEMPTS = 3;
+
+/*
+ * Add `bytes` to a subscriber's balance for the current billing cycle.
+ *
+ *  - active cycle:        usage.topupBytes += bytes (atomic $inc).
+ *  - no cycle yet, or an expired one: open a new cycle now with the top-up
+ *    already in it (consumed 0, topup = bytes, periodStart = now).  A top-up
+ *    on an expired balance therefore reactivates it - including on a plan
+ *    that does not auto-renew, which has no other way back.
+ *
+ * The CHF advances the same document concurrently: it $incs consumedBytes on
+ * every usage report and re-stamps periodStart when it renews a cycle.  So
+ * every write is conditional on the periodStart this call just read.  If the
+ * CHF renewed the cycle in between, the condition misses and the decision is
+ * re-made against the new cycle, rather than applying the top-up to a cycle
+ * that no longer exists.  consumedBytes is never read-modified-written.
+ *
+ * Resolves to { outcome: 'applied', reactivated } | { outcome: 'notFound' }
+ * | { outcome: 'conflict' } (the cycle kept moving on every attempt).
+ */
+async function applyTopup(repo, bucket, bytes, now) {
+  for (let attempt = 0; attempt < TOPUP_ATTEMPTS; attempt++) {
+    const doc = await repo.get(bucket);
+    if (!doc) return { outcome: 'notFound' };
+
+    const usage = doc.usage || {};
+    const stamp = new Date(now);
+    /* Conditional on the cycle this attempt read, so a renewal by the CHF
+     * in between is noticed rather than overwritten. */
+    const filter = doc.bucketId ? { bucketId: doc.bucketId }
+                                : { supi: doc.supi };
+    filter['usage.periodStart'] =
+        usage.periodStart == null ? null : usage.periodStart;
+
+    const active = cycleState(doc, now) === 'active';
+    const update = active
+      ? { $inc: { 'usage.topupBytes': bytes },
+          $set: { 'usage.updatedAt': stamp } }
+      : { $set: { 'usage.consumedBytes': 0, 'usage.topupBytes': bytes,
+                  'usage.periodStart': stamp, 'usage.updatedAt': stamp } };
+
+    if (await repo.update(filter, update) === 1)
+      return { outcome: 'applied', reactivated: !active };
+  }
+  return { outcome: 'conflict' };
+}
+
+module.exports = {
+  bucketId,
+  hasScope,
+  toScope,
+  scopeToStored,
+  priorityOf,
+  SUPI_RE,
+  READ_ONLY,
+  PATCHABLE,
+  quantityToOctets,
+  cycleState,
+  nextGrant,
+  toBucket,
+  planToQuotaSet,
+  supiFromLogicalResource,
+  partyAccountId,
+  applyTopup,
+};
diff --git a/webui/server/tmf/common.js b/webui/server/tmf/common.js
new file mode 100644
index 000000000..9b15754dc
--- /dev/null
+++ b/webui/server/tmf/common.js
@@ -0,0 +1,229 @@
+/*
+ * Shared TM Forum REST conventions (TMF630 API Design Guidelines, Part 1).
+ *
+ * Everything the three resource families have in common lives here so each
+ * resource module only describes its own attributes:
+ *
+ *   - id / href / @type on every representation
+ *   - GET lists: ?fields= projection, ?offset=&limit= paging, attribute
+ *     filtering, X-Total-Count / X-Result-Count, 206 for a partial page
+ *   - POST -> 201 + Location;  PATCH -> JSON Merge Patch (RFC 7386);
+ *     DELETE -> 204
+ *   - errors as the TMF Error object {code, reason, message, status}
+ *
+ * Copyright (C) 2026 by Rami Mohamed <ramrode@gmail.com>
+ */
+
+'use strict';
+
+const express = require('express');
+
+const DEFAULT_LIMIT = 100;
+const MAX_LIMIT = 1000;
+
+/* Attributes a ?fields= projection always keeps, per TMF630. */
+const ALWAYS_KEPT = ['id', 'href', '@type', '@baseType', '@schemaLocation'];
+
+/* Query parameters with a meaning of their own, never treated as filters. */
+const RESERVED_PARAMS = new Set(['fields', 'offset', 'limit', 'sort']);
+
+/*
+ * JSON body parsing for TMF routes.  The WebUI's global parser only accepts
+ * application/json, so a PATCH sent as application/merge-patch+json - the
+ * content type TMF630 prescribes for merge patches - would otherwise arrive
+ * with an empty body and silently change nothing.
+ */
+const jsonBody = express.json({
+  type: ['application/json', 'application/merge-patch+json'],
+  limit: '256kb',
+});
+
+/* ------------------------------------------------------------------ */
+/* Errors                                                               */
+/* ------------------------------------------------------------------ */
+
+class TmfError extends Error {
+  constructor(status, reason, message) {
+    super(message || reason);
+    this.status = status;
+    this.reason = reason;
+  }
+}
+
+function sendError(res, status, reason, message) {
+  return res.status(status).json({
+    '@type': 'Error',
+    code: String(status),
+    reason,
+    message: message || reason,
+    status: String(status),
+  });
+}
+
+/*
+ * Wrap an async route handler so a thrown TmfError becomes a TMF Error
+ * response, and anything unexpected becomes a 500 without leaking internals.
+ */
+function handler(fn) {
+  return (req, res) => {
+    Promise.resolve(fn(req, res)).catch(err => {
+      if (err instanceof TmfError)
+        return sendError(res, err.status, err.reason, err.message);
+      /* Duplicate key on a unique index - e.g. a SUPI provisioned twice. */
+      if (err && err.code === 11000)
+        return sendError(res, 409, 'Conflict', 'Resource already exists');
+      // eslint-disable-next-line no-console
+      console.error('[tmf]', err && err.stack ? err.stack : err);
+      return sendError(res, 500, 'Internal Server Error');
+    });
+  };
+}
+
+/* ------------------------------------------------------------------ */
+/* Access control                                                       */
+/* ------------------------------------------------------------------ */
+
+/*
+ * Reads need any authenticated account; anything that changes state needs
+ * the admin role.  This is a provisioning API: an ordinary WebUI user must
+ * not be able to change another subscriber's allowance or top it up.
+ */
+function requireAdminForWrites(req, res, next) {
+  if (req.method === 'GET' || req.method === 'HEAD')
+    return next();
+  const roles = (req.user && req.user.roles) || [];
+  if (roles.indexOf('admin') === -1)
+    return sendError(res, 403, 'Forbidden',
+        'The admin role is required to modify resources');
+  return next();
+}
+
+/* ------------------------------------------------------------------ */
+/* Representation helpers                                               */
+/* ------------------------------------------------------------------ */
+
+/* Absolute href for a resource, from the mount point of the current router. */
+function hrefFor(req, collection, id) {
+  const base = `${req.protocol}://${req.get('host')}${req.baseUrl}`;
+  return `${base}/${collection}/${encodeURIComponent(id)}`;
+}
+
+/*
+ * Apply a ?fields=a,b projection.  Top-level attributes only, as TMF630
+ * describes; the identifying attributes are always retained.
+ */
+function project(resource, fieldsParam) {
+  if (!fieldsParam) return resource;
+  const wanted = new Set(
+    String(fieldsParam).split(',').map(f => f.trim()).filter(Boolean));
+  const out = {};
+  Object.keys(resource).forEach(key => {
+    if (ALWAYS_KEPT.indexOf(key) !== -1 || wanted.has(key))
+      out[key] = resource[key];
+  });
+  return out;
+}
+
+/* Parse ?offset=&limit=, clamping to sane bounds. */
+function paging(query) {
+  const offset = Math.max(0, parseInt(query.offset, 10) || 0);
+  let limit = parseInt(query.limit, 10);
+  if (!Number.isFinite(limit) || limit <= 0) limit = DEFAULT_LIMIT;
+  return { offset, limit: Math.min(limit, MAX_LIMIT) };
+}
+
+/*
+ * Build an equality filter from query parameters.
+ *
+ * Only attributes the resource declares as filterable are honoured.  The
+ * values reach MongoDB as plain strings, and restricting the keys means a
+ * caller cannot smuggle an operator in (?$where=, ?usage.consumedBytes[$gt]=)
+ * or filter on attributes the resource does not expose.
+ *
+ * `filterable` maps an API attribute name to its storage path.
+ */
+function buildFilter(query, filterable) {
+  const filter = {};
+  Object.keys(query).forEach(key => {
+    if (RESERVED_PARAMS.has(key)) return;
+    const path = filterable[key];
+    if (!path)
+      throw new TmfError(400, 'Bad Request',
+          `Filtering on '${key}' is not supported`);
+    const value = query[key];
+    if (typeof value !== 'string')
+      throw new TmfError(400, 'Bad Request',
+          `Filter '${key}' must be a single plain value`);
+    filter[path] = value;
+  });
+  return filter;
+}
+
+/* Send a list with the TMF paging headers; 206 when it is a partial page. */
+function sendList(res, items, total) {
+  res.set('X-Total-Count', String(total));
+  res.set('X-Result-Count', String(items.length));
+  return res.status(items.length < total ? 206 : 200).json(items);
+}
+
+function sendCreated(res, resource) {
+  res.set('Location', resource.href);
+  return res.status(201).json(resource);
+}
+
+/* ------------------------------------------------------------------ */
+/* JSON Merge Patch (RFC 7386)                                          */
+/* ------------------------------------------------------------------ */
+
+function isPlainObject(v) {
+  return v !== null && typeof v === 'object' && !Array.isArray(v);
+}
+
+/*
+ * Apply a merge patch: objects merge recursively, null deletes a member,
+ * and anything else (including arrays) replaces the target wholesale.
+ */
+function mergePatch(target, patch) {
+  if (!isPlainObject(patch)) return patch;
+  const out = isPlainObject(target) ? Object.assign({}, target) : {};
+  Object.keys(patch).forEach(key => {
+    if (patch[key] === null) delete out[key];
+    else out[key] = mergePatch(out[key], patch[key]);
+  });
+  return out;
+}
+
+/* Reject a body that is not a JSON object before any handler reads it. */
+function requireObjectBody(req) {
+  if (!isPlainObject(req.body))
+    throw new TmfError(400, 'Bad Request', 'Request body must be a JSON object');
+  return req.body;
+}
+
+/* Reject attempts to set attributes the server owns. */
+function rejectReadOnly(body, readOnly) {
+  const bad = readOnly.filter(a => Object.prototype.hasOwnProperty.call(body, a));
+  if (bad.length)
+    throw new TmfError(400, 'Bad Request',
+        `Read-only attribute(s) cannot be set: ${bad.join(', ')}`);
+}
+
+module.exports = {
+  DEFAULT_LIMIT,
+  MAX_LIMIT,
+  TmfError,
+  jsonBody,
+  sendError,
+  handler,
+  requireAdminForWrites,
+  hrefFor,
+  project,
+  paging,
+  buildFilter,
+  sendList,
+  sendCreated,
+  mergePatch,
+  isPlainObject,
+  requireObjectBody,
+  rejectReadOnly,
+};
diff --git a/webui/server/tmf/index.js b/webui/server/tmf/index.js
new file mode 100644
index 000000000..ffa0e2f53
--- /dev/null
+++ b/webui/server/tmf/index.js
@@ -0,0 +1,68 @@
+/*
+ * TM Forum Open APIs for CHF subscriber management.
+ *
+ * Mounted at {serverRoot}/tmf-api (serverRoot = /api), behind the WebUI's
+ * JWT bearer authentication:
+ *
+ *   /tmf-api/partyManagement/v4/individual           TMF632  users
+ *   /tmf-api/accountManagement/v4/billingAccount     TMF666  accounts
+ *   /tmf-api/prepayBalanceManagement/v4/bucket       TMF654  data balances
+ *   /tmf-api/prepayBalanceManagement/v4/topupBalance TMF654  top-ups
+ *
+ * Reads need any authenticated account; writes need the admin role.
+ *
+ * Copyright (C) 2026 by Rami Mohamed <ramrode@gmail.com>
+ */
+
+'use strict';
+
+const express = require('express');
+const C = require('./common');
+const { createPartyRouter } = require('./party');
+const { createAccountRouter } = require('./account');
+const { createBalanceRouter } = require('./balance');
+
+function createTmfRouter(repos, clock) {
+  const router = express.Router();
+
+  router.use(C.jsonBody);
+  router.use(C.requireAdminForWrites);
+
+  router.use('/partyManagement/v4', createPartyRouter(repos));
+  router.use('/accountManagement/v4', createAccountRouter(repos));
+  router.use('/prepayBalanceManagement/v4', createBalanceRouter(repos, clock));
+
+  router.use((req, res) =>
+    C.sendError(res, 404, 'Not Found', 'No such TMF resource'));
+
+  /* Malformed JSON and oversized bodies from the TMF body parser. */
+  // eslint-disable-next-line no-unused-vars
+  router.use((err, req, res, next) => {
+    const status = err.status || err.statusCode || 500;
+    if (status >= 400 && status < 500)
+      return C.sendError(res, status, 'Bad Request', err.message);
+    // eslint-disable-next-line no-console
+    console.error('[tmf]', err && err.stack ? err.stack : err);
+    return C.sendError(res, 500, 'Internal Server Error');
+  });
+
+  return router;
+}
+
+/* Production wiring: the Mongoose-backed repositories. */
+function mongooseRepos() {
+  const { mongooseRepo } = require('./repo');
+  return {
+    individual: mongooseRepo(require('../models/tmf-individual'), 'id'),
+    billingAccount: mongooseRepo(require('../models/tmf-billing-account'), 'id'),
+    /* Keyed by bucketId, not supi: a subscriber holds several buckets and
+     * only the catch-all's id is its SUPI.  getBucket() in balance.js
+     * falls back to a supi lookup for a document written before buckets
+     * existed, and gives it a bucketId as it goes. */
+    bucket: mongooseRepo(require('../models/chf-subscriber'), 'bucketId'),
+    topupBalance: mongooseRepo(require('../models/tmf-topup-balance'), 'id'),
+    notification: mongooseRepo(require('../models/chf-notification'), 'id'),
+  };
+}
+
+module.exports = { createTmfRouter, mongooseRepos };
diff --git a/webui/server/tmf/party.js b/webui/server/tmf/party.js
new file mode 100644
index 000000000..9c8759b3f
--- /dev/null
+++ b/webui/server/tmf/party.js
@@ -0,0 +1,137 @@
+/*
+ * TMF632 Party Management API v4 — Individual.
+ *
+ *   GET    /partyManagement/v4/individual[?fields&offset&limit&<attr>=]
+ *   GET    /partyManagement/v4/individual/{id}
+ *   POST   /partyManagement/v4/individual
+ *   PATCH  /partyManagement/v4/individual/{id}      (JSON Merge Patch)
+ *   DELETE /partyManagement/v4/individual/{id}
+ *
+ * An Individual is the person behind one or more billing accounts.  It is a
+ * BSS record only: the CHF never reads it.
+ *
+ * Copyright (C) 2026 by Rami Mohamed <ramrode@gmail.com>
+ */
+
+'use strict';
+
+const express = require('express');
+const crypto = require('crypto');
+const C = require('./common');
+
+const COLLECTION = 'individual';
+
+/* Server-owned attributes a client may not set. */
+const READ_ONLY = ['id', 'href', '@type', '@baseType', 'lastUpdate'];
+
+const FILTERABLE = {
+  givenName: 'givenName',
+  familyName: 'familyName',
+  fullName: 'fullName',
+  status: 'status',
+};
+
+const STATUSES = ['initialized', 'validated', 'deceased'];
+
+/* Attributes accepted on create/patch, with their expected JSON types. */
+const STRING_ATTRS = ['givenName', 'familyName', 'middleName', 'fullName',
+  'formattedName', 'legalName', 'preferredGivenName', 'title', 'gender',
+  'nationality', 'maritalStatus', 'status', 'birthDate'];
+const ARRAY_ATTRS = ['contactMedium', 'externalReference', 'partyCharacteristic',
+  'individualIdentification', 'otherName', 'relatedParty'];
+
+function validate(body) {
+  STRING_ATTRS.forEach(a => {
+    if (body[a] !== undefined && typeof body[a] !== 'string')
+      throw new C.TmfError(400, 'Bad Request', `'${a}' must be a string`);
+  });
+  ARRAY_ATTRS.forEach(a => {
+    if (body[a] !== undefined && !Array.isArray(body[a]))
+      throw new C.TmfError(400, 'Bad Request', `'${a}' must be an array`);
+  });
+  if (body.status !== undefined && STATUSES.indexOf(body.status) === -1)
+    throw new C.TmfError(400, 'Bad Request',
+        `'status' must be one of: ${STATUSES.join(', ')}`);
+  if (!body.givenName && !body.familyName && !body.fullName)
+    throw new C.TmfError(400, 'Bad Request',
+        'One of givenName, familyName or fullName is required');
+}
+
+/* Only the attributes this resource defines are persisted. */
+function pick(body) {
+  const out = {};
+  STRING_ATTRS.concat(ARRAY_ATTRS).forEach(a => {
+    if (body[a] !== undefined) out[a] = body[a];
+  });
+  return out;
+}
+
+function represent(req, doc) {
+  return Object.assign(
+    { id: doc.id, href: C.hrefFor(req, COLLECTION, doc.id),
+      '@type': 'Individual' },
+    pick(doc),
+    doc.lastUpdate ? { lastUpdate: doc.lastUpdate } : {});
+}
+
+/*
+ * @param repos.individual       repository keyed by 'id'
+ * @param repos.billingAccount   used to refuse deleting a referenced party
+ */
+function createPartyRouter(repos) {
+  const router = express.Router();
+
+  router.get(`/${COLLECTION}`, C.handler(async (req, res) => {
+    const { offset, limit } = C.paging(req.query);
+    const filter = C.buildFilter(req.query, FILTERABLE);
+    const { items, total } = await repos.individual.list(filter, offset, limit);
+    return C.sendList(res,
+        items.map(d => C.project(represent(req, d), req.query.fields)), total);
+  }));
+
+  router.get(`/${COLLECTION}/:id`, C.handler(async (req, res) => {
+    const doc = await repos.individual.get(req.params.id);
+    if (!doc) throw new C.TmfError(404, 'Not Found', 'Individual not found');
+    return res.json(C.project(represent(req, doc), req.query.fields));
+  }));
+
+  router.post(`/${COLLECTION}`, C.handler(async (req, res) => {
+    const body = C.requireObjectBody(req);
+    C.rejectReadOnly(body, READ_ONLY);
+    validate(body);
+    const doc = Object.assign(pick(body), {
+      id: crypto.randomUUID(),
+      status: body.status || 'initialized',
+      lastUpdate: new Date().toISOString(),
+    });
+    const created = await repos.individual.create(doc);
+    return C.sendCreated(res, represent(req, created));
+  }));
+
+  router.patch(`/${COLLECTION}/:id`, C.handler(async (req, res) => {
+    const patch = C.requireObjectBody(req);
+    C.rejectReadOnly(patch, READ_ONLY);
+    const current = await repos.individual.get(req.params.id);
+    if (!current) throw new C.TmfError(404, 'Not Found', 'Individual not found');
+
+    const merged = C.mergePatch(pick(current), patch);
+    validate(merged);
+    const saved = await repos.individual.replace(req.params.id,
+        Object.assign(pick(merged), {
+          id: current.id, lastUpdate: new Date().toISOString() }));
+    return res.json(represent(req, saved));
+  }));
+
+  router.delete(`/${COLLECTION}/:id`, C.handler(async (req, res) => {
+    if (await repos.billingAccount.exists({ 'relatedParty.id': req.params.id }))
+      throw new C.TmfError(409, 'Conflict',
+          'Individual is referenced by a billing account');
+    if (!await repos.individual.remove(req.params.id))
+      throw new C.TmfError(404, 'Not Found', 'Individual not found');
+    return res.status(204).end();
+  }));
+
+  return router;
+}
+
+module.exports = { createPartyRouter, validate, represent };
diff --git a/webui/server/tmf/repo.js b/webui/server/tmf/repo.js
new file mode 100644
index 000000000..c0f92d947
--- /dev/null
+++ b/webui/server/tmf/repo.js
@@ -0,0 +1,199 @@
+/*
+ * Persistence for the TMF routers, behind one small interface.
+ *
+ * The routers never talk to Mongoose directly.  That keeps the HTTP layer
+ * testable end to end without a database (tests inject memoryRepo), and it
+ * confines the storage details - including the atomic, conditional updates
+ * the balance top-up depends on - to one place.
+ *
+ * Interface (all methods async, all documents plain objects):
+ *   list(filter, offset, limit)   -> { items, total }
+ *   get(key)                      -> doc | null
+ *   exists(filter)                -> boolean
+ *   create(doc)                   -> doc
+ *   replace(key, doc)             -> doc | null     whole-document replace
+ *   update(filter, update)        -> number matched  ($set / $inc / $unset)
+ *   remove(key)                   -> boolean
+ *
+ * `filter` is an equality map on (possibly dotted) paths; a null value
+ * matches a missing or null field, as in MongoDB.
+ *
+ * Copyright (C) 2026 by Rami Mohamed <ramrode@gmail.com>
+ */
+
+'use strict';
+
+/* ------------------------------------------------------------------ */
+/* MongoDB (Mongoose)                                                   */
+/* ------------------------------------------------------------------ */
+
+function mongooseRepo(Model, keyField) {
+  const byKey = key => ({ [keyField]: key });
+  const strip = doc => {
+    if (!doc) return doc;
+    const out = Object.assign({}, doc);
+    delete out._id;
+    delete out.__v;
+    return out;
+  };
+
+  return {
+    keyField,
+
+    async list(filter, offset, limit) {
+      const [items, total] = await Promise.all([
+        Model.find(filter).sort({ [keyField]: 1 })
+          .skip(offset).limit(limit).lean(),
+        Model.countDocuments(filter),
+      ]);
+      return { items: items.map(strip), total };
+    },
+
+    async get(key) {
+      return strip(await Model.findOne(byKey(key)).lean());
+    },
+
+    async exists(filter) {
+      return (await Model.countDocuments(filter).limit(1)) > 0;
+    },
+
+    async create(doc) {
+      const created = await Model.create(doc);
+      return strip(created.toObject());
+    },
+
+    async replace(key, doc) {
+      return strip(await Model.findOneAndReplace(byKey(key), doc,
+          { new: true, runValidators: true }).lean());
+    },
+
+    async update(filter, update) {
+      const res = await Model.updateOne(filter, update);
+      /* Mongoose 5 reports n; newer drivers report matchedCount. */
+      return res.matchedCount != null ? res.matchedCount : (res.n || 0);
+    },
+
+    async remove(key) {
+      const res = await Model.deleteOne(byKey(key));
+      return (res.deletedCount || 0) > 0;
+    },
+  };
+}
+
+/* ------------------------------------------------------------------ */
+/* In-memory (tests)                                                    */
+/* ------------------------------------------------------------------ */
+
+function getPath(obj, path) {
+  return path.split('.').reduce(
+    (o, k) => (o == null ? undefined : o[k]), obj);
+}
+
+function setPath(obj, path, value) {
+  const keys = path.split('.');
+  let o = obj;
+  keys.slice(0, -1).forEach(k => {
+    if (o[k] == null || typeof o[k] !== 'object') o[k] = {};
+    o = o[k];
+  });
+  o[keys[keys.length - 1]] = value;
+}
+
+function unsetPath(obj, path) {
+  const keys = path.split('.');
+  const parent = keys.slice(0, -1).reduce(
+    (o, k) => (o == null ? undefined : o[k]), obj);
+  if (parent) delete parent[keys[keys.length - 1]];
+}
+
+function sameValue(a, b) {
+  if (a instanceof Date || b instanceof Date)
+    return new Date(a).getTime() === new Date(b).getTime();
+  return a === b;
+}
+
+/*
+ * Every value a dotted path can reach, descending into arrays the way a
+ * MongoDB query does: {'relatedParty.id': x} matches when ANY element of the
+ * relatedParty array has id x.  Without this the fake would silently never
+ * match array paths, and tests of the delete guards would pass vacuously.
+ */
+function valuesAt(value, keys) {
+  if (!keys.length) return [value];
+  if (Array.isArray(value))
+    return value.reduce((acc, el) => acc.concat(valuesAt(el, keys)), []);
+  if (value == null || typeof value !== 'object') return [undefined];
+  return valuesAt(value[keys[0]], keys.slice(1));
+}
+
+function matches(doc, filter) {
+  return Object.keys(filter).every(path => {
+    const want = filter[path];
+    const haves = valuesAt(doc, path.split('.'));
+    if (want === null) return haves.every(h => h == null);
+    return haves.some(h => sameValue(h, want));
+  });
+}
+
+const clone = v => (v === undefined ? v : JSON.parse(JSON.stringify(v)));
+
+function memoryRepo(keyField, seed) {
+  const docs = (seed || []).map(clone);
+
+  return {
+    keyField,
+    docs, /* exposed for test assertions */
+
+    async list(filter, offset, limit) {
+      const hit = docs.filter(d => matches(d, filter))
+        .sort((a, b) => String(a[keyField]).localeCompare(String(b[keyField])));
+      return { items: hit.slice(offset, offset + limit).map(clone),
+               total: hit.length };
+    },
+
+    async get(key) {
+      return clone(docs.find(d => d[keyField] === key) || null);
+    },
+
+    async exists(filter) {
+      return docs.some(d => matches(d, filter));
+    },
+
+    async create(doc) {
+      if (docs.some(d => d[keyField] === doc[keyField])) {
+        const err = new Error('duplicate key');
+        err.code = 11000;
+        throw err;
+      }
+      docs.push(clone(doc));
+      return clone(doc);
+    },
+
+    async replace(key, doc) {
+      const i = docs.findIndex(d => d[keyField] === key);
+      if (i < 0) return null;
+      docs[i] = clone(doc);
+      return clone(docs[i]);
+    },
+
+    async update(filter, update) {
+      const doc = docs.find(d => matches(d, filter));
+      if (!doc) return 0;
+      Object.keys(update.$set || {}).forEach(
+        p => setPath(doc, p, clone(update.$set[p])));
+      Object.keys(update.$inc || {}).forEach(
+        p => setPath(doc, p, (Number(getPath(doc, p)) || 0) + update.$inc[p]));
+      Object.keys(update.$unset || {}).forEach(p => unsetPath(doc, p));
+      return 1;
+    },
+
+    async remove(key) {
+      const i = docs.findIndex(d => d[keyField] === key);
+      if (i < 0) return false;
+      docs.splice(i, 1);
+      return true;
+    },
+  };
+}
+
+module.exports = { mongooseRepo, memoryRepo, getPath };
