+/* ================================================================== */
+describe('TMF654 Bucket scope', () => {
+  test('S1. a bucket with no scope is the catch-all, addressed by SUPI', async () => {
+    const res = await call('POST', BK, {
+      logicalResource: [{ id: supi(1) }], allowance: { amount: 10, units: 'GB' } });
