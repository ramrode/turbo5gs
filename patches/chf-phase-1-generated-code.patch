+
+    item = cJSON_CreateObject();
+    if (mm_tel_charging_information->supplementary_services) {
+    cJSON *supplementary_servicesList = cJSON_AddArrayToObject(item, "supplementaryServices");
+    if (supplementary_servicesList == NULL) {
