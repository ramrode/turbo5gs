+                goto end;
+            }
+            OpenAPI_tai_t *spatial_validity_informationItem = OpenAPI_tai_parseFromJSON(spatial_validity_information_local);
+            if (!spatial_validity_informationItem) {
+                ogs_error("No spatial_validity_informationItem");
