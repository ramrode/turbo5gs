+
+/*
+ * Generic placeholder descriptor for anonymous SET OF.
+ * NOTE: not a concrete "OF T" — used only to satisfy references.
+ */
+asn_TYPE_descriptor_t asn_DEF_SET_OF = {
+    "SET OF",
+    "SET OF",
+    &asn_OP_SET_OF,
+    0, 0,
+    0, 0,
