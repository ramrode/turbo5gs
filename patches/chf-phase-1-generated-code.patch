+        return NULL;
+    }
+
+    item = cJSON_Parse(content);
+    ogs_free(content);
+    if (!item) {
+        ogs_error("cJSON_Parse() failed");
+        return NULL;
+    }
+
+    OpenAPI_serving_network_function_id_free(dst);
+    dst = OpenAPI_serving_network_function_id_parseFromJSON(item);
+    cJSON_Delete(item);
+
+    return dst;
