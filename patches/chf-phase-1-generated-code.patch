+        total_volume ? total_volume->valuedouble : 0,
+        uplink_volume ? true : false,
+        uplink_volume ? uplink_volume->valuedouble : 0,
+        downlink_volume ? true : false,
+        downlink_volume ? downlink_volume->valuedouble : 0,
