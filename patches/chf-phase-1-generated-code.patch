+
+cJSON *OpenAPI_allocate_unit_convertToJSON(OpenAPI_allocate_unit_t *allocate_unit)
+{
+    cJSON *item = NULL;
+    OpenAPI_lnode_t *node = NULL;
+
+    if (allocate_unit == NULL) {
+        ogs_error("OpenAPI_allocate_unit_convertToJSON() failed [AllocateUnit]");
