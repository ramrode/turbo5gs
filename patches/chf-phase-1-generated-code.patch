+        return NULL;
+    }
+
+    item = cJSON_Parse(content);
+    ogs_free(content);
+    if (!item) {
+        ogs_error("cJSON_Parse() failed");
+        return NULL;
+    }
+
+    OpenAPI_time_synchronization_information_free(dst);
+    dst = OpenAPI_time_synchronization_information_parseFromJSON(item);
