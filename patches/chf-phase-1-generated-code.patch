+                goto end;
+            }
+            OpenAPI_list_add(qos_flows_usage_reportsList, qos_flows_usage_reportsItem);
+        }
+    }
+
+    ran_secondary_rat_usage_report_local_var = OpenAPI_ran_secondary_rat_usage_report_create (
