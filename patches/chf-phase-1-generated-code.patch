+    if (disaster_roaming_ind) {
+    if (!cJSON_IsBool(disaster_roaming_ind)) {
+        ogs_error("OpenAPI_user_information_parseFromJSON() failed [disaster_roaming_ind]");
+        goto end;
+    }
+    }
+
+    user_information_local_var = OpenAPI_user_information_create (
