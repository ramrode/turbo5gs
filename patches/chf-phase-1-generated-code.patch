+    cJSON_Delete(item);
+
+    if (!content) {
+        ogs_error("cJSON_Print() failed");
+        return NULL;
+    }
+
+    item = cJSON_Parse(content);
+    ogs_free(content);
+    if (!item) {
+        ogs_error("cJSON_Parse() failed");
+        return NULL;
+    }
+
+    OpenAPI_mm_tel_charging_information_free(dst);
+    dst = OpenAPI_mm_tel_charging_information_parseFromJSON(item);
+    cJSON_Delete(item);
