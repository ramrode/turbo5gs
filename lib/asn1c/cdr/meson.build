# 3GPP TS 32.298 CHF CDR codec, generated by asn1c.
#
# Regenerate with ../support/cdr-r19.6.0/generator.sh; this list is not
# generated and is synced by hand, as it is for ngap and s1ap.
#
# Unlike ngap and s1ap, this codec keeps BER and drops APER: TS 32.298
# clause 6.1 requires BER on the Bx interface.  The codec flags live in
# asn_config.h, which asn1c writes, which is why this directory carries
# its own copy of the asn1c runtime rather than sharing ../common - see
# the comment in generator.sh.

libasn1c_cdr_sources = files('''
    CHFCDR_CHFRecord.c
    CHFCDR_CallDuration.c
    CHFCDR_CauseForRecClosing.c
    CHFCDR_ChargingID.c
    CHFCDR_ChargingRecord.c
    CHFCDR_ChargingSessionIdentifier.c
    CHFCDR_DataNetworkNameIdentifier.c
    CHFCDR_DataVolumeOctets.c
    CHFCDR_EXTERNAL.c
    CHFCDR_InvolvedParty.c
    CHFCDR_LocalSequenceNumber.c
    CHFCDR_MultipleUnitUsage.c
    CHFCDR_NetworkFunctionInformation.c
    CHFCDR_NetworkFunctionName.c
    CHFCDR_NetworkFunctionality.c
    CHFCDR_PDUSessionChargingInformation.c
    CHFCDR_PDUSessionId.c
    CHFCDR_RatingGroupId.c
    CHFCDR_RecordType.c
    CHFCDR_ServiceIdentifier.c
    CHFCDR_SingleNSSAI.c
    CHFCDR_SliceDifferentiator.c
    CHFCDR_SliceServiceType.c
    CHFCDR_SubscriptionID.c
    CHFCDR_SubscriptionIDType.c
    CHFCDR_TimeStamp.c
    CHFCDR_UsedUnitContainer.c
    ANY.c
    ANY_ber.c
    BIT_STRING.c
    BIT_STRING_print.c
    ENUMERATED.c
    GraphicString.c
    IA5String.c
    INTEGER.c
    INTEGER_ber.c
    INTEGER_print.c
    NativeEnumerated.c
    NativeEnumerated_ber.c
    NativeInteger.c
    NativeInteger_ber.c
    NativeInteger_print.c
    OBJECT_IDENTIFIER.c
    OBJECT_IDENTIFIER_print.c
    OCTET_STRING.c
    OCTET_STRING_ber.c
    OCTET_STRING_print.c
    OPEN_TYPE.c
    OPEN_TYPE_ber.c
    OPEN_TYPE_print.c
    ObjectDescriptor.c
    UTF8String.c
    UTF8String_print.c
    asn_SEQUENCE_OF.c
    asn_SET_OF.c
    asn_application.c
    asn_bit_data.c
    asn_codecs_prim.c
    asn_codecs_prim_ber.c
    asn_internal.c
    ber_decoder.c
    ber_tlv_length.c
    ber_tlv_tag.c
    constr_CHOICE.c
    constr_CHOICE_ber.c
    constr_CHOICE_print.c
    constr_SEQUENCE.c
    constr_SEQUENCE_OF.c
    constr_SEQUENCE_OF_ber.c
    constr_SEQUENCE_ber.c
    constr_SEQUENCE_print.c
    constr_SET.c
    constr_SET_OF.c
    constr_SET_OF_ber.c
    constr_SET_OF_print.c
    constr_SET_ber.c
    constr_SET_print.c
    constr_TYPE.c
    constraints.c
    der_encoder.c
'''.split())

libasn1c_cdr_cc_flags = cc.get_supported_arguments([
    '-w', '-std=gnu99',
])

libasn1c_cdr_inc = include_directories('.')

libasn1c_cdr = library('ogsasn1c-cdr',
    sources : libasn1c_cdr_sources,
    version : libogslib_version,
    c_args : libasn1c_cdr_cc_flags,
    include_directories : libasn1c_cdr_inc,
    dependencies : libcore_dep,
    install : true)

libasn1c_cdr_dep = declare_dependency(
    link_with : libasn1c_cdr,
    include_directories : libasn1c_cdr_inc,
    dependencies : libcore_dep)
